s/critic-persistence-redesign.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/artifacts/project-preferences.md", ".prawduct/artifacts/reviewer-model-ab-2026-06-10.md", ".prawduct/changes/reviewer-model-cap.md", ".prawduct/owner-rulings.md", "plugin/agents/critic-reviewer.md", "plugin/bin/prawduct-hook", "plugin/docs/governance-telemetry.md", "plugin/lib/critic_consolidate.py", "plugin/lib/model_tier.py", "plugin/lib/risk.py", "plugin/lib/telemetry.py", "plugin/methodology/building.md", "plugin/methodology/session-digest.md", "plugin/skills/advisory/SKILL.md", "plugin/skills/backlog/SKILL.md", "plugin/skills/critic/SKILL.md", "plugin/skills/critic/coordinator.md", "plugin/skills/critic/goals-1-3.md", "plugin/skills/critic/review-cycle.md", "plugin/skills/critic/review-protocol.md", "plugin/skills/pr/SKILL.md", "tests/preferences/test_reviewer_model_dispatch_prose.py", "tests/test_classify_diff_risk.py", "tests/test_critic_consolidate.py", "tests/test_critic_reviewer_agent.py", "tests/test_model_tier.py", "tests/test_pr_reviewer.py", "tests/test_pr_reviewer_agent.py", "tests/test_review_stats.py", "tests/test_reviewer_handoff.py", "tests/test_reviewer_model_dispatch.py", "tests/test_reviewer_payload_budget.py", "tests/test_v5_methodology.py"], "files_oracle": [".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-reviewer-model-cap.md", ".prawduct/artifacts/critic-persistence-redesign.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/artifacts/project-preferences.md", ".prawduct/artifacts/reviewer-model-ab-2026-06-10.md", ".prawduct/changes/reviewer-model-cap.md", ".prawduct/owner-rulings.md"], "findings": [{"goal": "The Design Is Sound", "severity": "warning", "title": "pr-review-dispatch's lib-import fallback sends the reviewer to the session's model, the one direction the cap exists to forbid", "recommendation": "Why it broke: the ImportError branch's degraded advice was written for the pre-cap world (duration only) and extended with 'the reviewer runs on the session's model', the opposite of the direction model_tier's own docstring and the plan's mid-build decision pick ('a dispatcher that does not say what it runs on cannot leave its reviewer uncapped'; 'nothing runs on the session's tier by accident'). Per the hook-surface rule 'Pick each fallback's direction from the invariant it protects', a fallback that cannot answer must keep the cap: on a session above the ceiling with an unimportable lib/, the PR skill is told in plain words to run the PR reviewer uncapped, and pr/SKILL.md ('carry on, on the `reviewer model:` it still printed') gives it no line to act on instead. Instance: change the ImportError message to say no reviewer model was answered and the caller should dispatch on Opus-class unless it knows its session is at or below it (or have pr/SKILL.md state that a missing `reviewer model:` line means the cap applies), and pin that branch's text in tests/test_reviewer_model_dispatch.py. critic-begin has no equivalent path (an import failure there fails the whole dispatch), so the class is this one site.", "files": ["plugin/bin/prawduct-hook", "plugin/skills/pr/SKILL.md"], "fid": "R-1"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "Four plan inferences reach the boundary still marked inferred and unconfirmed", "recommendation": "Instance. The plan's Goals carry four '*Inferred:*' items explicitly left 'for the owner to veto at the boundary', and this cumulative review is that boundary. Nothing on the branch shows them put to the owner: owner-rulings.md records the two forced choices (hand-off, Sonnet for both) and #1138 sequencing, not these. Their consequence is real: (1) 'above Opus-class decided by exclusion' means any unrecognised model id or an omitted --session-model silently gets Opus-class reviewers, and every review on an unknown id counts in above_reviewer_ceiling; (2) #1136's 'stats reports reviews by model' acceptance line was satisfied in review-stats, not stats; (3) a single-pass final/cumulative is also handed off; (4) directives travel via the manifest. Put them to the owner before merge, triaged by decision-worthiness (the learnings rule 'When surfacing model-proposed candidates for owner confirm-or-correct, triage by decision-worthiness first'): (1) and (2) are real forks worth asking individually; (3) and (4) can be bulk-confirmed. Record the answer in owner-rulings.md and mark the items settled in the plan.", "files": [".prawduct/artifacts/build-plan-reviewer-model-cap.md"], "fid": "R-2"}], "counts": {"blocking": 0, "warning": 2, "note": 0}, "observations": [{"goal": "Nothing Is Broken", "title": "pr-review-dispatch's lib-import failure tells the dispatcher to run the reviewer uncapped", "recommendation": "When `from lib import ... model_tier ...` fails, the stderr message now says 'no reviewer model was answered, so the reviewer runs on the session's model'. On a session above Opus-class that is the one route by which a reviewer still runs on the session's tier, which the plan's product goal ('no review ... runs on the session's tier by accident') rules out. The path needs a broken plugin install, so it is unlikely. If it is worth closing, the message could say the cap could not be answered and the dispatcher should not pass the session's tier. Instance; no edit is owed at this stage.", "files": ["plugin/bin/prawduct-hook"], "oid": "O-1"}, {"goal": "Nothing Is Broken", "title": "An empty --session-model value gets the missing-model note from critic-begin but not from pr-review-dispatch", "recommendation": "critic-begin checks `_nonempty_str(session_model)` before adding the 'cap was assumed' note. pr-review-dispatch checks only `session_model is None`, so `--session-model \"\"` caps the reviewer without the stderr note. Both commands still cap, so the answer is correct; only the note is missing. Instance.", "files": ["plugin/bin/prawduct-hook"], "oid": "O-2"}, {"goal": "Nothing Is Unintended", "title": "Pinned model aliases now conflict with the authoring learnings rule on fallback chains", "recommendation": "The rule \"When prose picks the model a reviewer/subagent runs on, express it as an ordered fallback chain resolved at dispatch \u2014 never a pinned alias\" (authoring.md) contradicts `model: sonnet` in the backlog and advisory front matter and the single `CEILING_ALIAS = \"opus\"`. Both are owner-ruled (2026-11-10 and 2026-11-11 in owner-rulings.md) and recorded in the plan, so this is not an unrecorded departure. The learnings rule should be rewritten or retired so the next builder is not pointed the wrong way. This is a record to reconcile; the code needs no change.", "files": ["plugin/lib/model_tier.py", "plugin/skills/backlog/SKILL.md", "plugin/skills/advisory/SKILL.md"], "oid": "O-3"}, {"goal": "The Design Is Sound", "title": "prawduct-hook reaches model_tier through critic_consolidate's import", "recommendation": "cmd_critic_begin prints `consolidate.model_tier.reviewer_model_line(...)`, depending on critic_consolidate happening to import model_tier. begin_review already returns `directives` for the CLI to print; returning the rendered reviewer-model line the same way (or importing model_tier directly, as cmd_pr_review_dispatch does) removes the reach-through. Instance; no behaviour is wrong today.", "files": ["plugin/bin/prawduct-hook"], "oid": "O-4"}, {"goal": "Everything Is Coherent", "title": "consolidate()'s NEXT-ACTION comment still says the single-pass reviewer runs this command itself", "recommendation": "The comment above the NEXT-ACTION print says 'The single-pass reviewer runs this command itself' and that both protocol files tell 'the reviewer' to relay it; a handed-off single-pass review is now consolidated by SubagentStop and the protocol files tell only the fork to run it. Comment wording, nothing reads it; make it relational ('when the fork consolidates, ...') whenever the file is next touched. No edit owed.", "files": ["plugin/lib/critic_consolidate.py"], "oid": "O-5"}, {"goal": "The Design Is Sound", "title": "The ceiling's 'a new stronger tier is capped with no code change' holds only for ids that contain no known family substring", "recommendation": "canonical_model folds by substring, so a future stronger tier whose id contains 'opus', 'sonnet' or 'haiku' (e.g. an 'opus-max' variant) folds to an at-or-below family and is not capped. The exclusion design is sound; the docstring's guarantee is conditional on naming. Either state the condition in model_tier's docstring or leave it \u2014 today no such id exists.", "files": ["plugin/lib/model_tier.py"], "oid": "O-6"}, {"goal": "The Design Is Sound", "title": "A capped fork still reads the full final/cumulative protocol set before learning it reviews nothing", "recommendation": "The plan records this tradeoff for goals-1-3.md (reviewer model known only after critic-begin; reordering out of scope). On final/cumulative the same ordering has the above-ceiling fork read review-protocol.md, cross-checks.md and framework-checks.md before dispatching. Already a deliberate decision; worth widening its wording to name the final/cumulative read when the reorder is taken up. No edit owed now.", "files": ["plugin/skills/critic/SKILL.md"], "oid": "O-7"}, {"goal": "The System Can Be Understood", "title": "pr-review-dispatch's import-failure path drops the cap instead of keeping it", "recommendation": "Instance. In cmd_pr_review_dispatch the ImportError branch returns before printing any 'reviewer model:' line and tells the caller the reviewer 'runs on the session's model', so on a session above the ceiling a broken lib/ import yields an uncapped PR review. That is the one failure path where the design's fail-toward-the-cap stance (the model_tier docstring: an absent answer is capped) inverts. It is detectable afterwards via review-stats' above_reviewer_ceiling, and the path requires a broken install, so it is not worth a round; if touched later, print the CEILING_ALIAS line literal-free from the hook (or tell the caller to pass the ceiling) rather than defaulting to the session model.", "files": ["plugin/bin/prawduct-hook"], "oid": "O-8"}, {"goal": "Records Pass", "title": "Redesign annotation cites the build plan by path", "recommendation": "Instance. critic-persistence-redesign.md's new parenthetical points at `build-plan-reviewer-model-cap.md` by filename; archiving the plan at merge dangles it (Goal 4's 'a plan resolves by scope'). Clears no Records Pass bar, so no edit is owed; citing scope `reviewer-model-cap` would be the durable form if the line is ever touched.", "files": [".prawduct/artifacts/critic-persistence-redesign.md"], "oid": "O-9"}, {"goal": "Records Pass", "title": "Records Pass coverage", "recommendation": "Covered all nine files_oracle records: api-contract.md, build-plan-reviewer-model-cap.md, critic-persistence-redesign.md, data-model.md, nonfunctional-requirements.md, project-preferences.md, reviewer-model-ab-2026-06-10.md, changes/reviewer-model-cap.md, owner-rulings.md. Spot-verified load-bearing claims against code: the NFR amendment's 'about a quarter of the wall clock' (A/B table: Opus 1m53s vs Fable 8m08s, ~23%); the change fragment's subagent-start inventory against a fresh query (only backlog, advisory and critic declare `context: fork`; the two agents; delegates in methodology), which matches; the fragment's claim that pr-review-dispatch prints the answer before the mark (true in code). Nothing cleared a bar. No edit wanted.", "oid": "O-10"}], "duration_seconds": 600, "scope": "reviewer-model-cap", "scope_chosen_by": "binding", "scope_unresolved_cause": null, "scope_reason": null, "base_extended_from": null, "chunks": ["01", "02", "03"], "chunks_proposed": ["01", "02", "03"], "chunk": "01", "base_reviewed": "fe0fee976e02e02f233f6e8e977e7aa70f9bf8bb", "record_lint": {"records": [".prawduct/a