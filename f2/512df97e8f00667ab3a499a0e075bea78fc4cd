{"schema": 1, "kind": "review", "id": "rev-20261126T051046Z-7ffe008a", "ts": "2026-11-26T05:18:13Z", "actor": {"worktree": "prawduct", "plugin": "3.10.0", "branch": "feature/boundary-review-per-release", "build": "e9c06c071287"}, "body": {"base_commit": "a84fedfc1f142cbb6312b380af0bbe1a7819202a", "base_tree": "106b51d5f1d6749e71a1740883c5dbe6fb6e22d7", "head_tree": "2046174cbb43bdb8e3ea6973c9d614bc65935bcd", "head_commit": "f2512df97e8f00667ab3a499a0e075bea78fc4cd", "dispatch_commit": "f2512df97e8f00667ab3a499a0e075bea78fc4cd", "mode": "cumulative (bundle review, ready for merge)", "mode_chosen_by": "explicit-args", "stage": "boundary", "tier": "escalate", "roster": [{"role": "correctness", "model": "claude-opus-5-5"}, {"role": "design", "model": "claude-opus-5-5"}, {"role": "sustainability", "model": "claude-opus-5-5"}], "files_reviewed": ["documentation/release-process.md", "plugin/bin/prawduct-hook", "plugin/docs/governance-telemetry.md", "plugin/docs/project-state-keys.md", "plugin/lib/boundary_coverage.py", "plugin/lib/core.py", "plugin/lib/coverage.py", "plugin/lib/coverage_algebra.py", "plugin/lib/critic_consolidate.py", "plugin/lib/critic_mode.py", "plugin/lib/gates.py", "plugin/lib/pr_gate.py", "plugin/lib/release_readiness.py", "plugin/lib/review_lane.py", "plugin/lib/risk.py", "plugin/lib/telemetry.py", "plugin/methodology/planning.md", "plugin/skills/critic/SKILL.md", "plugin/skills/critic/review-cycle.md", "plugin/skills/critic/review-protocol.md", "plugin/skills/pr/SKILL.md", "plugin/templates/project-state.yaml", "tests/test_batch_review_rule.py", "tests/test_boundary_coverage.py", "tests/test_carried_blocking_findings.py", "tests/test_fix_tail_deferral.py", "tests/test_per_release_lane_inference.py", "tests/test_release_batch_review.py", "tests/test_release_gate.py", "tests/test_review_lane.py", "tests/test_review_stats.py", "tests/test_reviewer_payload_budget.py", "tests/test_v5_methodology.py"], "files_changed": [".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-boundary-review-per-release.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/boundary-review-per-release.md", ".prawduct/owner-rulings.md", ".prawduct/runbooks/cut-and-publish-a-plugin-release.md", "documentation/release-process.md", "plugin/bin/prawduct-hook", "plugin/docs/governance-telemetry.md", "plugin/docs/project-state-keys.md", "plugin/lib/boundary_coverage.py", "plugin/lib/core.py", "plugin/lib/coverage.py", "plugin/lib/coverage_algebra.py", "plugin/lib/critic_consolidate.py", "plugin/lib/critic_mode.py", "plugin/lib/gates.py", "plugin/lib/pr_gate.py", "plugin/lib/release_readiness.py", "plugin/lib/review_lane.py", "plugin/lib/risk.py", "plugin/lib/telemetry.py", "plugin/methodology/planning.md", "plugin/skills/critic/SKILL.md", "plugin/skills/critic/review-cycle.md", "plugin/skills/critic/review-protocol.md", "plugin/skills/pr/SKILL.md", "plugin/templates/project-state.yaml", "tests/test_batch_review_rule.py", "tests/test_boundary_coverage.py", "tests/test_carried_blocking_findings.py", "tests/test_fix_tail_deferral.py", "tests/test_per_release_lane_inference.py", "tests/test_release_batch_review.py", "tests/test_release_gate.py", "tests/test_review_lane.py", "tests/test_review_stats.py", "tests/test_reviewer_payload_budget.py", "tests/test_v5_methodology.py"], "files_oracle": [".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-boundary-review-per-release.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/boundary-review-per-release.md", ".prawduct/owner-rulings.md", ".prawduct/runbooks/cut-and-publish-a-plugin-release.md"], "findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "A verify-resolutions pass on the integration base still makes a branch forked at its tree read blocked, the defect M1 fixed only for the release batch review", "recommendation": "Scope: class. Why it broke: `coverage_algebra._counts_at` keys the M1 exemption on `is_release_batch(fact)` (the fact's `span`), but the property it protects is that a review taken on the integration base, at its tip, must not hold a feature branch forked from that tree. This branch adds a second review of that kind, the `verify-resolutions` pass on the base. It is the route for both the batch fix tail (Chunk 03) and M12's merged-branch blockers (`release_owed_blockers`). Under goals-1-3.md that pass records a BLOCKING finding (`about: {review_id, fid}`) whenever it judges a fix incomplete. The fact's `head_tree` is the base tip tree T1, so `_facts_at_nodes` places it at T1, and `_unresolved_at_nodes` counts it for every span whose path stands on T1 (`_counts_at` returns True for any non-batch fact). A branch cut from the base at T1 has T1 as its merge-base node (`_path_nodes` always includes `base_tree`), so its PR gate and Stop gate read `blocked` on a release-time finding about code it never touched. That is the case M1 states it removed ('every branch cut from the base tip read `blocked` for code it never touched'). The branch's remedy is to resolve another body of work's blocker, or wait for the base to move. Fix it through the one owner: have `_counts_at` exempt reviews taken on the base for the release, not just facts tagged `span: release`. For example, record a marker on a verify pass dispatched on the integration base at its tip (begin_review already asks `integration_base_tip`), or exempt a verify whose verified anchor is a release batch. Pin it with a test beside `test_a_release_batch_blocker_does_not_hold_a_branch_forked_at_its_tree`: a verify pass on the base carrying an `about` blocker, a branch forked at its head tree that reads covered, and a control where the same blocker on an ordinary review holds it.", "files": ["plugin/lib/coverage_algebra.py", "plugin/lib/critic_consolidate.py"], "scope": "class", "closure": "A review fact recorded on the integration base at its tip for the release (the release batch review, or a verify-resolutions pass dispatched there), whose blocker stands at a base-line tree a feature branch can fork from.", "members": [{"id": "m1", "site": "coverage_algebra._counts_at (exempts is_release_batch only)"}, {"id": "m2", "site": "verify-resolutions on the base anchored to a release batch review (batch fix tail, Chunk 03)"}, {"id": "m3", "site": "verify-resolutions on the base naming release_owed_blockers (M12)"}], "fid": "R-1"}, {"goal": "Nothing Is Broken", "severity": "warning", "title": "rule-unenforced: an appended exception still leads with the standing advice. A blocker-only release entry is told to run the release batch review again, and a plain cumulative on the base re-dispatches one that can credit nothing", "recommendation": "Rule (hook-surface.md): \"An exception APPENDED to standing advice still leads with the advice: if it can cover the whole set it must REPLACE the lead.\" No deterministic check owns it. The instance: after f2512df9, a merge whose branch coverage is blocked stays not covered after a clean release batch review has read it (classify_known turns the batch's `covered` into `blocked`). Two things still treat it as owed a read. (1) `release_gate` builds its message with the lead 'run the release batch review, `/prawduct:critic cumulative` \u2026 then re-run' for every owed entry and appends the verify-resolutions route after it. test_gate_batch_gate_verify_gate's `still` step shows that lead after the batch has run. (2) `release_subject` puts every non-COVERED entry in `owed`, so its files are the subject again, and a plain `cumulative` on the base (the derived release span) dispatches a second full boundary review. That review reads files already read, and its credit is refused by the same shape blockers. The operator following the lead pays a full boundary review (the NFR's P0 wall-clock constraint) and the gate holds exactly as before. Instance fix: the batch's verdict is known at classification (`batch[0] == 'blocked'` with a covering review, or shape_blockers). Carry it on the Entry, for example 'read, blocker-only'. `release_subject` then leaves those entries out of the subject (with every owed entry blocker-only it refuses `no-subject` naming the verify route), and `release_gate` leads with the verify-resolutions route when every owed entry is blocker-only. To mechanise the rule: one function owns the gate's remedy and picks its lead from the owed entries' kinds. Pin it with a test asserting the lead on a blocker-only report and on a mixed one.", "files": ["plugin/lib/boundary_coverage.py"], "check": "rule-unenforced", "scope": "instance", "fid": "R-2"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "Risk-surface resolution order now has two homes, and resolve_surfaces' 'in ONE place' claim is false", "recommendation": "Instance. Why it broke: `risk._surfaces_at` needed the same answer read from a committed tree, so it re-implemented `resolve_surfaces`' precedence (declared `risk_surfaces:` is exclusive, unparseable refuses, otherwise DERIVED_DEFAULT_SURFACES plus boundary-pattern paths) instead of sharing it. Only the text source differs. `resolve_surfaces`' docstring still says the order lives 'in ONE place so every consumer answers \"is this a risk surface\" identically'. The consequence: the next change to the order (a new source, a new default) lands in `resolve_surfaces`. Then the per_release relaxations, which are the lane's eligibility and the fix-tail deferral via `paths_touch_held_risk_surface`, read surfaces at the merge-base and tip under the old order. A relaxation then disagrees with the tier the PR gate and `classify-diff-risk` report. Fix it with one function over texts in hand, e.g. `_resolve_surfaces_from(state_text, patterns_text)`, which `resolve_surfaces` (reading the working tree) and `_surfaces_at` (reading `git show`) both call. Then the docstring is true again.", "files": ["plugin/lib/risk.py"], "scope": "instance", "closure": "A second implementation of the risk-surface resolution order beside resolve_surfaces.", "members": [{"id": "m1", "site": "plugin/lib/risk.py:_surfaces_at"}], "fid": "R-3"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "A fully reverted owed set holds a per_release release with only a policy flip as the way out", "recommendation": "Instance. Why it broke: two halves of the batch design disagree about reverted work. `coverage_algebra.batch_review_covers` condition 2 already treats an entry's file that is back to the interval's base content as needing no reading. But `boundary_coverage._release_subject` refuses `no-subject` when every owed entry's changes no longer differ from the span start, so no review can ever bracket them. The common case: an inner-only merge (or a lane merge) is reverted on the base before the release, and nothing else since the anchor touched those files. The merge and the revert are both owed, both are net-zero, and the dispatch refuses. `project-state-keys.md`'s own table gives the only route: set `per_pr` on the integration branch for that release. That is two governance commits to ship a release whose tree carries none of the unread work. Either credit such entries directly, as nothing of them ships (a covered class, or reuse condition 2's reasoning against the span start), or let `release_subject` dispatch an empty-subject review that the batch rule can then credit. Either way, record the choice as an owner ruling beneath the 2026-11-25 amendment: 'moved, not skipped' is a norm, and whether reverted work is owed a read is the owner's call. Until that ruling exists, the key doc's 'per_pr for that release' row is the remedy operators will follow.", "files": ["plugin/lib/boundary_coverage.py", "plugin/docs/project-state-keys.md"], "scope": "instance", "closure": "A release-check state whose only documented exit is changing the boundary_review policy.", "members": [{"id": "m1", "site": "plugin/lib/boundary_coverage.py:_release_subject (RELEASE_NO_SUBJECT)"}], "fid": "R-4"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "read-cost: _batch_tail redoes whole-store work for every historical boundary review, for each owed single-parent commit", "recommendation": "Instance. Why it broke: `_Classifier._batch_tail` asks every boundary-stage review in the store (`reversed(self.boundary)`) whose head tree is anywhere on the base's first-parent line before the commit. `first_parent()` lists the line back to the root, not just from the anchor. For each one it calls `coverage_algebra.batch_review_blockers`, which re-filters every fact, re-scans for the review, and rebuilds `resolution_index(facts)` from scratch. Each review with no blocker then also costs a `coverage_verdict`. All of that repeats for every owed `direct` commit. The cost grows with the store and with the history, not with the release. This clone holds 7,598 facts, 1,525 of them reviews and about 470 boundary-stage. Under per_release the classification is now a blocking release check. `release_owed_blockers` also runs it 2-3 times per `verify-resolutions` pass on the integration base (begin_review, branch_review_record, _consolidate). Hoist the per-store work out of the loop: build the verdict-input facts and the resolution index once per `_Classifier`. Then bound the candidates, either to reviews whose head is at or after the span start, or to reviews some verify-only or free edge actually leaves from. The second is exact and needs no change to what the rule means.", "files": ["plugin/lib/boundary_coverage.py", "plugin/lib/coverage_algebra.py"], "check": "read-cost", "scope": "instance", "closure": "Per-candidate recomputation of whole-store indices inside the release classification's batch-tail loop.", "members": [{"id": "m1", "site": "plugin/lib/boundary_coverage.py:_Classifier._batch_tail"}, {"id": "m2", "site": "plugin/lib/coverage_algebra.py:batch_review_blockers"}], "fid": "R-5"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "Lane eligibility composes _short_plan_shape, not short_plan_deferral: a mid-build design call recorded only in a docstring, missing from the M-list the owner vets", "recommendation": "Class. Why it broke: the plan's inferred calls and chunk descriptions were never re-checked against the code, so a call the code reversed keeps its why only in the code's docstring. This is the same class W9 found for M2-M6; the M1-M13 sweep missed this one. The plan's Goals say 'eligibility reuses short_plan_deferral's conditions by calling it', and Chunk 04 says 'short_plan_deferral(...).defers'. Since Chunk 04 (4863d462), critic_mode._lane_eligibility calls _short_plan_shape instead. The reason, given only in lane_eligibility's docstring: `defers` also answers 'not finished', and a plan the lane's review just finished must stay in the lane. That changes what a post-review fix owes (a verify pass or a lane chunk, never the cumulative). Consequence: the owner vetoing the inferred calls approves a composition the code does not have, and a maintainer who later widens short_plan_deferral (#1247 seam 2) expects the lane to inherit the change, which it will not. Fix: record the call as an M-entry with its why in the plan's 'Decisions made mid-build', and correct the inferred-call sentence. Then compare every remaining inferred call and chunk description with the code, not with docstrings, so this class closes by a sweep rather than one more found member.", "files": ["plugin/lib/critic_mode.py"], "scope": "class", "closure": "Code behaviour that departs from a build-plan inferred call or chunk description and gives its reason only in a docstring or comment.", "members": [{"id": "m1", "site": "plugin/lib/critic_mode.py:_lane_eligibility (calls _short_plan_shape, not short_plan_deferral)"}], "fid": "R-6"}], "counts": {"blocking": 0, "warning": 6, "note": 0}, "observations": [{"goal": "Nothing Is Unintended", "title": "release_owed_blockers' broad except discards the failure without a word, while the gate's remedy promises the roll-call names the blocker", "recommendation": "The waiver's reason is true: an omission holds a release and never passes one. But the catch logs nothing. If it ever fires, the verify pass's roll-call omits the merged branch's blocker, and the release gate keeps saying 'run `/prawduct:critic verify-resolutions` there, whose roll-call names it', which it then does not. Nothing tells the operator why. Every callee is never-raising by contract, so this is close to unreachable, and that is why it is an observation. If touched, return the failure sentence (as `fix_tail_deferral`'s `why` does) so the dispatch can print it.", "files": ["plugin/lib/boundary_coverage.py"], "oid": "O-1"}, {"goal": "Nothing Is Unintended", "title": "Governing-Artifact Reconciliation: the recorded dispositions hold against the diff", "recommendation": "Checked the plan's governed_by dispositions against the code. They hold: the NFR amendment sits under the clause with the ratified words kept. Per_release gates through one reader (review_lane.release_policy), and the checkout's per_release stands when the tip is unreadable. The bare check-boundary-coverage exits are unchanged, with `--gate` as the additive surface. The batch fact is never an edge (review_edges), and no gate reads .critic-findings.json. One disposition is imprecise but not a departure: 'lane eligibility one predicate (critic_mode.lane_eligibility, composing short_plan_deferral)'. In the code, lane_eligibility composes `_short_plan_shape`, and short_plan_deferral calls lane_eligibility. One predicate still holds. No edit wanted unless the line is touched anyway.", "files": [".prawduct/artifacts/build-plan-boundary-review-per-release.md"], "oid": "O-2"}, {"goal": "The Design Is Sound", "title": "The release span is threaded through begin_review as four interdependent flags", "recommendation": "`begin_review` is now 1,428 lines (1,308 at base). The release batch review shows up there as `span_request`, `span_derived`, `release_files` and `span == SPAN_RELEASE`, each checked at a different site: the credential guard, the notes, the interval branch, files_reviewed and files_context. They are consistent by construction today, because one decision sets them all. A future span kind, or a change to the release span, still has to find all five sites. Consider extracting the release interval into one helper that returns base, head, subject, context and notes. Not a fix this round.", "oid": "O-3"}, {"goal": "The Design Is Sound", "title": "Small duplications in boundary_coverage", "recommendation": "The `git(*args)` closure around `evidence.run_git` is written four times (`_resolve_anchor`, `integration_base_tip`, `_release_subject`, and `_Classifier._git`). A first-parent position map is built three ways: `_resolve_anchor`'s `line`, `_release_subject`'s `position`, and `_Classifier._line_index`. Blocker dedup by (review_id, fid) appears as `_merged_blockers`, as the loop in `release_owed_blockers`, and as `carried_blocking.listed`. Each copy is small. The one that matters is that `_release_subject`'s choice of start and subject, and `_batch`'s bracket and condition-2 test, independently derive the same invariant: a release review dispatched from this start, rating these files, is credited for every owed entry. If they drift, a release is held for good. Consider having `_release_subject` ask the batch rule's own predicate for the start it computes.", "oid": "O-4"}, {"goal": "The Design Is Sound", "title": "fix_tail_deferral picks live-vs-merged semantics from the string tip == \"HEAD\"", "recommendation": "In `gates._fix_tail_deferral`, the literal `tip == \"HEAD\"` decides which policy reader runs (`boundary_review_policy` or `boundary_review_policy_of_merge`) and which revision risk surfaces are held at. A caller that passes HEAD's SHA gets merged-branch semantics. An explicit keyword, e.g. `merged: bool`, would separate the two. The docstring's condition 1 also says the live-branch policy reads 'the merge-base and the working tree', but `boundary_review_policy` also requires the integration branch's tip. Prose only.", "oid": "O-5"}, {"goal": "The Design Is Sound", "title": "release_gate duck-types its policy argument", "recommendation": "`boundary_coverage.release_gate` reads `getattr(policy, \"per_release\", False)` and `getattr(policy, \"read_failed\", False)` rather than taking a `review_lane.Policy`. A wrong object reads as per_pr and passes. It is used correctly today by both callers.", "oid": "O-6"}, {"goal": "Everything Is Coherent", "title": "boundary_coverage's module title still says 'merges'", "recommendation": "The first line, 'Which release-pending merges did a boundary review cover?', predates the walk. The module now classifies every judgeable first-parent commit since the anchor, and the body says so. Nothing reads the title, so no edit is wanted unless the docstring is touched anyway.", "oid": "O-7"}, {"goal": "Everything Is Coherent", "title": "review-cycle.md: two small instruction-clarity points", "recommendation": "Framework Check 8. The release-batch paragraph's last sentence, 'verify-resolutions clears them, and a merged branch's blocker the gate names (its roll-call lists it)', is missing its verb. The trim also removed the 'Delta > 2 \u00d7 the prior count + 5' row's remedy, while its sibling rows keep theirs. SKILL.md's exit table still carries that remedy (`fallback-scope-widened`), so no wrong action follows. Separately, the release gate's refusal text names `prawduct-hook critic-begin --mode cumulative --span release` as 'the explicit form' to a reader who may be an agent, while SKILL.md says never to pass `--span release`. Leading with `/prawduct:critic cumulative`, as it already does, is enough.", "oid": "O-8"}, {"goal": "Decisions Were Deliberate", "title": "Records Pass: the six oracle files were covered and none clears a bar", "recommendation": "Covered: .prawduct/artifacts/api-contract.md, .prawduct/artifacts/build-plan-boundary-review-per-release.md, .prawduct/artifacts/nonfunctional-requirements.md, .prawduct/changes/boundary-review-per-release.md, .prawduct/owner-rulings.md, .prawduct/runbooks/cut-and-publish-a-plugin-release.md. Every claim I checked against the code holds: the change record's refusal codes, the 'satisfied (fix tail deferred to the release)' string, report schema 15 with the `release` span, the --json keys, the --gate exits and the policy line, the three-way policy read, and the runbook's exit-1 fourth outcome. The imprecisions below clear no bar. No edit is wanted for the Records Pass itself.", "files": [".prawduct/changes/boundary-review-per-release.md", ".prawduct/artifacts/api-contract.md"], "oid": "O-9"}, {"goal": "The System Can Be Understood", "title": "Entry.blockers 'own trees' wording is narrower than f2512df9's behaviour", "recommendation": "Since f2512df9, an `uncovered` merge's blockers are the verdict's unresolved findings wherever their review stood, including a review of an uncommitted tree that no entry commit holds. Several places still describe them as standing 'at the entry's own trees': the Entry.blockers comment, release_owed_blockers' docstring, coverage_algebra.entry_blockers' framing, the api-contract `blockers` key and the consumer note. The new test pins the behaviour, so this is wording. Making it relational ('the merged branch's unresolved blockers') would stop a maintainer from reimplementing release_owed_blockers from entry trees.", "files": ["plugin/lib/boundary_coverage.py"], "oid": "O-10"}, {"goal": "Decisions Were Deliberate", "title": "M11 reaches per_pr repos, which the plan's Constraint line says nothing does", "recommendation": "Under per_pr, a plain `cumulative` at the integration base's tip now dispatches a release batch review where it used to answer exit 3. M11 records this deliberately ('under either policy', with its why). But the plan's Constraints still say 'The default (per_pr) changes no verdict, exit or inference anywhere'. The consumer note also opens with 'Nothing changes for a repo that does not set it', though its later paragraphs disclose the change. When the owner vets M11, they may want the Constraint line to say M11 is the exception.", "files": ["plugin/lib/critic_consolidate.py"], "oid": "O-11"}, {"goal": "The System Can Be Understood", "title": "release_owed_blockers drops a crash without a note, and part of it runs outside its try", "recommendation": "The broad except returns [] with no note. If it ever fires, a verify-resolutions roll-call on the base silently omits a merged branch's blocker, while the release refusal keeps saying that roll-call names it. The operator loops with nothing to diagnose. The release check still refuses, so nothing ships. Separately, the cheap pre-check (resolution_index / unresolved_blocking) runs before the try, so the 'Never raises' docstring is broader than the code.", "files": ["plugin/lib/boundary_coverage.py"], "oid": "O-12"}, {"goal": "Decisions Were Deliberate", "title": "The plan's Level and NFR disposition are behind events", "recommendation": "Level stays Medium even though both things it said would raise it are now settled: the pay test was ruled go on 2026-11-26, and Chunk 04 confirmed the chunk naming. The NFR governed_by disposition still says the pay test was 're-measured by Chunk 02's op in the consumer repo', but the 2026-11-26 ruling records it was read from the ledger, with the op not run there. Neither changes anything anyone does before the merge.", "files": [".prawduct/artifacts/build-plan-boundary-review-per-release.md"], "oid": "O-13"}], "duration_seconds": 1500, "scope": "boundary-review-per-release", "scope_chosen_by": "binding", "scope_unresolved_cause": null, "scope_reason": null, "base_extended_from": null, "chunks": [], "chunks_proposed": [], "chunks_declared": false, "chunks_evidence": {}, "base_reviewed": "a84fedfc1f142cbb6312b380af0bbe1a7819202a"