.DS_Store

# uv lock file — resolved fresh per environment (not committed)
uv.lock

# Prawduct session files
.prawduct/.test-evidence.json
.prawduct/.gates-waived

# Work-model vocabulary index — derived per-repo state, rebuilt from artifacts
# each session (hooks build-index / user-prompt-submit). Ephemeral, gitignored.
.prawduct/.work-model-index.json

# Prawduct session files
.prawduct/.advisories.json

# Prawduct plugin (v2.0): per-repo last-seen version marker for the version-delta
# banner (hooks/banner.py). Mutable per-repo state — gitignored so a plugin
# version bump never produces a tracked-file diff (the core no-noise guarantee).
.prawduct/.prawduct-version

# Untracked drop-box for externally-filed bug reports (triaged into .prawduct/backlog.md).
incoming-bugs/

# Prawduct session files
.prawduct/.critic-partials/
