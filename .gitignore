.claude/settings.local.json
.claude/scheduled_tasks.lock
.prawduct/.bug-inbox
.prawduct/.critic-active
.prawduct/.critic-findings.json
.prawduct/.governance-ledger.jsonl
.prawduct/.handoff-notes.md
.prawduct/.pr-reviews/
.prawduct/.session-base-tree
.prawduct/.session-git-baseline
.prawduct/.session-handoff.md
.prawduct/.session-reflected
.prawduct/.session-start
.prawduct/.subagent-briefing.md
.prawduct/reflections.md
__pycache__/
.pytest_cache/
.DS_Store

# uv lock file — resolved fresh per environment (not committed)
uv.lock

# Prawduct session files
.prawduct/.test-evidence.json
.prawduct/.gates-waived

# Work-model vocabulary index — derived per-repo state, rebuilt from artifacts
# each session (hooks build-index / user-prompt-submit). Ephemeral, gitignored.
.prawduct/.work-model-index.json

# Prawduct session files
.prawduct/.advisories.json

# Prawduct plugin (v2.0): per-repo last-seen version marker for the version-delta
# banner (hooks/banner.py). Mutable per-repo state — gitignored so a plugin
# version bump never produces a tracked-file diff (the core no-noise guarantee).
.prawduct/.prawduct-version

# Untracked drop-box for externally-filed bug reports (triaged into .prawduct/backlog.md).
incoming-bugs/

# Prawduct session files
.prawduct/.critic-partials/
.prawduct/.critic-partials-archive/

# Runbook research raw captures (large; distilled state is in CHECKPOINT.md)
.prawduct/research/**/raw/

# Repo-local agent scratch — never part of the distributed plugin (Principle 10).
# Kept out of plugin/ so it is not distributed; this rule also stops it being committed at all.
.claude/workflows/

# Setuptools metadata from `pip install ".[dev]"`, which is how CI reads the dev
# extra. The repo became installable so the dependency list would have one home;
# the build artifact that arrives with that is not part of the repo.
*.egg-info/

# Repo-root scratch dir. Ignored rather than deleted so it stops tripping the
# session briefing's architecture-staleness probe, which walks every directory
# under `source_root: "."` and reports any that architecture.md does not name —
# a recurring false advisory on a directory that is deliberately not architecture.
scratchpad/
