"tests/test_hook_cli_regressions.py", "tests/test_learning_events.py", "tests/test_measure_consumer_overhead.py", "tests/test_norm_index_scaffold.py", "tests/test_plugin_manifest.py", "tests/test_plugin_runtime.py", "tests/test_pr_review_payload.py", "tests/test_pr_reviewer.py", "tests/test_pytest_config.py", "tests/test_python_floor.py", "tests/test_record_lint.py", "tests/test_release_verification.py", "tests/test_repo_disable.py", "tests/test_retired_hook_subcommands.py", "tests/test_review_interval_extension.py", "tests/test_review_stats.py", "tests/test_session_critic_gate.py", "tests/test_short_plan_deferral.py", "tests/test_stop_abandoned_critic.py", "tests/test_subagent_stop.py"], "files_oracle": [".prawduct/artifacts/build-plan-python-floor.md", ".prawduct/artifacts/project-preferences.md", ".prawduct/changes/python-floor.md", ".prawduct/project-state.yaml"], "findings": [{"goal": "Nothing Is Broken", "severity": "note", "title": "The floor-import fail-open is pinned only for prawduct-hook, and python-floor's module-missing branch not at all", "recommendation": "Scope: class (the same fail-open block is copied into four entry points). Why it holds today: the binary-skew and plugin-cache tests copy prawduct-hook without its sibling, so they are the positive control for that one file. Nothing exercises the identical `except (NameError, ImportError)` block in banner.py, digest.py or test-reference-verify, and nothing runs `prawduct-hook python-floor` from a copied binary to reach its `exit 1` 'could not be loaded' branch. If you want it pinned, the cheapest owner is one parametrized test in tests/test_python_floor.py over ENTRY_POINTS that copies each file alone into tmp_path and runs it under sys.executable, asserting no traceback. That one test also covers python-floor's error line. No edit is required to land.", "files": ["plugin/hooks/banner.py", "plugin/hooks/digest.py", "plugin/bin/test-reference-verify", "plugin/bin/prawduct-hook", "tests/test_python_floor.py"], "fid": "R-1"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "Entry-point comments put the old-syntax boundary at the ensure() call, but the whole file must parse on old interpreters", "recommendation": "Why it broke: CPython compiles the whole module before it runs any statement, so one newer-syntax construct anywhere in an entry point raises SyntaxError before ensure() can run. The comment repeated in all four entry points says 'Everything above this call must parse on old interpreters', and the _python_floor.py docstring says 'This file, and the top of every entry point up to the ensure call'. Both tell a maintainer that the ~12k lines below the call (11,302 of them in prawduct-hook) are free to use 3.10+ syntax. The plan says 'Each entry point still parses' and the tests parse whole files, so only the comments are wrong. The tests do not fully cover the gap. test_python_floor's own docstring admits feature_version=(3,9) accepts parenthesised `with` and same-quote nested f-strings. The real-interpreter test only runs where a python3 below 3.14 exists, and on the ubuntu-latest CI leg that is the image's 3.12, which accepts both. So the wrong comment invites the exact silent-governance failure this module exists to prevent, and CI stays green when it happens. Scope: class, five sites: the bootstrap comment in plugin/bin/prawduct-hook, plugin/bin/test-reference-verify, plugin/hooks/banner.py and plugin/hooks/digest.py, plus the _python_floor.py module docstring. Remedy: make the statement relational ('this whole file must parse under the oldest python3; only modules imported after ensure() may use newer syntax'). The stronger fix is a construction: make each entry point a thin launcher that does the floor check and then imports its body from a module. That confines the 3.9-parse constraint to about 20 lines per entry point, and the plan's stated intent (3.14 features allowed after this) then holds for the hook body too. The plan rejected only a shell launcher in hooks.json, not a thin Python one.", "files": ["plugin/bin/_python_floor.py", "plugin/bin/prawduct-hook", "plugin/bin/test-reference-verify", "plugin/hooks/banner.py", "plugin/hooks/digest.py"], "fid": "R-2"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "project-state-keys.md still says the undeclared pytest fallback runs sys.executable", "recommendation": "This change made the test-evidence fallback run `<python> -m pytest` under _fallback_pytest_python(): the python3 the caller invoked, not the qualifying interpreter the floor re-executed into. The cmd_test_evidence docstring was updated to match. plugin/docs/project-state-keys.md line 239 (the test_command section, a consumer-facing reference) still says the fallback 'defaults to running `sys.executable -m pytest`', and so does the gate-soundness paragraph in the same prawduct-hook docstring (~line 4587, 'instead of ``sys.executable -m pytest``'). Consequence: a consumer whose project python3 is below 3.14 debugs a failing undeclared-suite run by installing pytest or packages into the hook's 3.14 interpreter, which the fallback no longer uses. Scope: instance (two sentences). Make both relational: 'the python3 the hook was invoked with'.", "files": ["plugin/docs/project-state-keys.md", "plugin/bin/prawduct-hook"], "fid": "R-3"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "Doctor Check #26 is ordered last and unclassified, but its ERROR fires first on every earlier prawduct-hook check", "recommendation": "Framework Check 8 (Instruction Clarity). With no qualifying interpreter, every `prawduct-hook` command fails at ensure() with the same `ERROR: prawduct needs Python \u2026` line. Checks #1, #11, #19, #20, #22, #24 and #25 all run one before #26 is reached. The Health Check Flow's general rule ('A check that could not run is degraded because ungraded') then tells the model to report each of those as a separate degraded/could-not-run finding. #19 additionally reads `.session-start` absence as a SessionStart hook that never completed. All of these get misattributed before #26 names the single cause. #26 also says to report the condition 'as its own finding \u2014 not the broken class' but never assigns a class, so the classify list (healthy/degraded/broken) cannot place it. Remedy, scope instance: run the floor check first, and state that an `ERROR: prawduct needs Python` line on any check is this condition, so the remaining hook-backed checks are reported as blocked by it rather than as individual findings. Then name the class it reports under.", "files": ["plugin/skills/doctor/SKILL.md"], "fid": "R-4"}, {"goal": "The Design Is Sound", "severity": "note", "title": "The entry-point set is hand-listed: four copied bootstrap blocks and a memory-enumerated ENTRY_POINTS", "recommendation": "The ~14-line floor bootstrap is copied verbatim into four entry points, differing only in the relative path to plugin/bin. c5148b17 already had to fix the same except clause in all four. tests/test_python_floor.py's ENTRY_POINTS ('Every file an interpreter is pointed at directly') is a literal list, so a fifth executable in plugin/bin, or a new hooks.json command, would ship without the floor and nothing would fail. Some duplication is inherent, because the block has to locate the module before it can import it. Scope: class. Bound it by deriving ENTRY_POINTS from the hooks.json `command` targets plus the executables in plugin/bin (excluding _python_floor.py), and add one assertion that every derived entry point carries the bootstrap block identically modulo its path. No code restructuring is wanted.", "files": ["tests/test_python_floor.py", "plugin/bin/prawduct-hook", "plugin/bin/test-reference-verify", "plugin/hooks/banner.py", "plugin/hooks/digest.py"], "fid": "R-5"}, {"goal": "The System Can Be Understood", "severity": "warning", "title": "The entry points' stated parse invariant is 'up to the floor check', but the whole file must parse on 3.9, which is what the test pins", "recommendation": "Scope: class. Why it broke: the prose describes run order, but Python compiles the whole module before line 1 runs, so any 3.10+ syntax anywhere in an entry point is a SyntaxError on an old python3 before ensure() can run. That is the silent failure the module exists to prevent. Five sites say otherwise: the comment block above each floor import in plugin/bin/prawduct-hook, plugin/bin/test-reference-verify, plugin/hooks/banner.py and plugin/hooks/digest.py ('Everything above this call must parse on old interpreters'), and the plugin/bin/_python_floor.py docstring ('the top of every entry point up to the ensure call'). The project-preferences.md Version row (an oracle file; Records Pass, misleads-into-action bar) repeats the claim as 'up to their floor check'. tests/test_python_floor.py::test_it_parses_at_the_oldest_feature_version is right: it parses the whole file at feature_version=(3, 9). Consequence: a maintainer who reads the comment can put 3.14 syntax (match, PEP 695, an unparenthesised except) in the 11k-line prawduct-hook body. When the test goes red, the comment tells them the test is over-broad and should be narrowed to the head, which brings back the silent governance-off failure. Fix the claim at all six sites. The whole entry-point file stays 3.9-parseable, and newer syntax goes in the lib/ modules those files import after ensure(). Rests on hook-surface's 'A docstring or comment is a claim: before one states reach or a guarantee\u2026'. Search for: 'must parse', 'up to', 'above this call' across plugin/bin, plugin/hooks and .prawduct/artifacts.", "files": ["plugin/bin/prawduct-hook", "plugin/bin/test-reference-verify", "plugin/hooks/banner.py", "plugin/hooks/digest.py", "plugin/bin/_python_floor.py", ".prawduct/artifacts/project-preferences.md"], "fid": "R-6"}, {"goal": "The System Can Be Understood", "severity": "note", "title": "An execve failure after a successful probe escapes ensure() as a traceback", "recommendation": "Scope: instance. ensure() catches OSError around every probe (qualifies, _uv_candidate) but not around the final execve. If the target vanishes or loses its exec permission between the probe and the exec, or execve otherwise raises, every role gets a raw traceback. For the banner role that is a non-blocking hook error and no 'GOVERNANCE IS OFF' notice, which is the silent failure the module exists to prevent. The window is narrow because the candidate ran a moment earlier, so this is a NOTE. Wrapping execve in `except OSError` and routing to fail(role, \u2026) with the target named would close it.", "files": ["plugin/bin/_python_floor.py"], "fid": "R-7"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Mid-build decisions for the python-floor plan", "recommendation": "Scope: none (informational, for the owner). The plan's Goals record seven mid-build decisions. (1) The pytest fallback runs under the invoked python3, carried in PRAWDUCT_PYTHON_REEXEC; settled by 'do it right'. (2) 49 bare-python3 test launches moved to sys.executable. (3) Per-line E402 waivers. (4) The tomllib tests were removed and one was kept on the remaining blocked shape. (5) This repo's suite commands moved to `uv run --extra dev`. (6) python-floor is a read-only subcommand that doctor check 26 consumes. (7) New since the last round: the floor import fails open without its sibling module, per hook-surface's 'Code in prawduct-hook main() that runs BEFORE command dispatch must fail open\u2026'. The version tier inference (3.8.0 minor) is now owner-confirmed on 2026-10-27. No goal is still hedged, and no alignment-pass miss is visible. One narration is a revision behind: the Loop guard inference still says the variable is set to `=1`, where decision (1) superseded it. It clears no Records Pass bar, so there is no finding and no edit wanted.", "files": [".prawduct/artifacts/build-plan-python-floor.md"], "fid": "R-8"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Backlog item appears resolved: brookstalley/prawduct#1097", "recommendation": "Scope: none. Backlog item appears resolved: 'runtime: raise the Python floor and have hooks find a qualifying python' (#1097, open in the cache, confirmed 2h old). Verify it, then call `/prawduct:backlog update brookstalley/prawduct#1097 status=shipped closed-by=scope:python-floor` when the backlog skill's 'When to mark shipped' rule says. The other items the affecting-query returned (#757 xdist nondeterminism, #928 host adapters) and the open-set match #249 (coverage floor is Python-only) are not touched by this change. No C-B1 to C-B4 hygiene signal fired.", "fid": "R-9"}, {"goal": "The System Can Be Understood", "severity": "note", "title": "Learnings cross-check: the change conforms to the loaded rules, and the finding that rests on one cites it", "recommendation": "Scope: none. Read list from `learnings-files --for-diff`: core.md, authoring.md, gates.md, hook-surface.md, release.md, tests.md. The parse-scope finding rests on hook-surface's 'A docstring or comment is a claim\u2026' and is cited there. The rule was not already broken in this area, so the finding stays at WARNING rather than being escalated. The fail-open floor import conforms to hook-surface's 'Code in prawduct-hook main() that runs BEFORE command dispatch must fail open\u2026'. Coverage of the entry points was checked by query, per core's 'A coverage, completeness or absence claim \u2026 holds only when its falsifying query returns nothing'. The plan says 'every entry point': hooks.json wires only banner.py, digest.py and prawduct-hook, plugin/bin holds only prawduct-hook and test-reference-verify, and the 51 skill invocations are all `python3 plugin/bin/prawduct-hook`. No learnings file changed this cycle, and no implicit supersession or unenforced rule was found.", "fid": "R-10"}], "counts": {"blocking": 0, "warning": 4, "note": 6}, "observations": [], "duration_seconds": 420, "scope": "python-floor", "scope_chosen_by": "binding", "scope_unresolved_cause": null, "scope_reason": null, "base_extended_from": null, "chunks": [], "chunks_proposed": [], "chunk": null, "base_reviewed": "be8b81fa217eee2c870847d9cf19ebedc131362c", "record_lint": {"records": [".prawduct/artifacts/build-plan-python-floor.md", ".prawduct/artifacts/project-preferences.md", ".prawduct/changes/python-floor.md", ".prawduct/project-state.yaml", "README.md", "documentation/backlog-service-prd.md", "documentation/running-tests.md", "plugin/docs/project-state-keys.md", "plugin/skills/doctor/SKILL.md"], "chunk_graded": null, "chunks_graded": [], "plan_graded": null, "findings": [], "unchecked": [], "counts": {"chunk-ref-missing": null, "governed-by-gap": 0, "suite-total-claim": 0, "learnings-over-budget": 0, "learnings-budget-unreasoned": 0, "learnings-core-raise-unapproved": 0, "learnings-rule-too-long": 0, "learnings-rule-body": 0, "learnings-area-dead": 0, "change-fragment": 0, "retired-claim-survives": 0}}, "dispatched_at": "2026-10-27T15:34:06Z"}}

