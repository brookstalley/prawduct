", "tests/test_test_report_scope.py", "tests/test_work_unit.py"], "files_changed": [".prawduct/artifacts/build-plan-testament-cache-areas.md", ".prawduct/changes/testament-cache-areas.md", ".testament.toml", "pyproject.toml", "tests/conftest.py", "tests/test_bounded_cumulative.py", "tests/test_buildplan_walkers.py", "tests/test_change_log_archive.py", "tests/test_change_log_entry_gate.py", "tests/test_change_record.py", "tests/test_check_branch_pushed.py", "tests/test_classify_diff_risk.py", "tests/test_cost_of_commit.py", "tests/test_coverage_base.py", "tests/test_critic_consolidate.py", "tests/test_critic_dispatch_refusal.py", "tests/test_critic_mode_inference.py", "tests/test_critic_session_guard.py", "tests/test_ephemeral_worktree.py", "tests/test_gitignore_contract_semantics.py", "tests/test_governance_ledger.py", "tests/test_handoff_parser_correctness.py", "tests/test_hook_env_isolation.py", "tests/test_host_seam_golden.py", "tests/test_learning_events.py", "tests/test_measure_repeat_cumulative_yield.py", "tests/test_measure_review_window.py", "tests/test_plan_check_claims.py", "tests/test_plan_hook_cmd.py", "tests/test_plan_mint.py", "tests/test_project_dir_resolution.py", "tests/test_reviewer_handoff.py", "tests/test_reviewer_model_dispatch.py", "tests/test_stop_abandoned_critic.py", "tests/test_subagent_stop.py", "tests/test_test_report_scope.py", "tests/test_work_unit.py"], "files_oracle": [".prawduct/artifacts/build-plan-testament-cache-areas.md", ".prawduct/changes/testament-cache-areas.md"], "findings": [{"goal": "Nothing Is Missing", "severity": "warning", "title": "[areas] has five dead globs: first-match shadowing misfiles six test files, and the plan's own check (`testament areas check --strict`) exits 1", "recommendation": "Testament assigns each item to the first area in declared order whose glob matches it (fnmatchcase, `*` crosses `/`; testament/areas.py `area_of`). `areas check --strict` exits 1 on a glob that takes no test, including one whose matches all go to earlier areas (cli.py: \"takes no test: all N it matches go to earlier areas\"). Simulating that rule over the 281 test files at 6ce65409 finds five dead globs: (1) plugin `tests/test_gitignore_*` (test_gitignore_contract_semantics.py, test_gitignore_management.py and test_gitignore_probes.py all go to git's earlier `tests/test_git*`); (2) plugin `tests/test_gitattributes_*` (test_gitattributes_probes.py also goes to git); (3) methodology `tests/test_coverage_algebra.py` (goes to critic's `tests/test_coverage_*`); (4) learnings `tests/test_review_stats.py` (goes to critic's `tests/test_review_*`); (5) backlog `tests/test_issue*`, which matches no file (the only near match is test_backlog_issuefmt.py, which `tests/test_backlog_*` already takes). The result: Chunk 02's deliverable, `[areas]` with every test in an area as `testament areas check --strict` checks it, does not hold. The check the plan names exits 1. `testament time/trend --by area` and `run --area plugin|methodology|learnings` also report and select those six files under areas their author did not intend: `--area plugin` misses the gitignore contract tests. Scope: class. It broke because a specific glob was listed after a broader one that already matches it, and nothing ran the strict check over the final table. Members: the five globs above. Fix each, either by moving the specific glob ahead of the broad one (for example, the gitignore and gitattributes globs before git's `tests/test_git*`) or by deleting a glob that is meant to be redundant. `tests/test_issue*` needs deleting or correcting. Then run `testament areas check --strict` to exit 0 and record that it did. The class closes only by running that check, which is derived from the matcher itself, against every table edit. A longer hand-audited list does not close it.", "files": [".testament.toml"], "fid": "R-1"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "Five [areas] globs take no test under first-match-wins, so the map misroutes six files and its own --strict check exits 1", "recommendation": "Scope: class. Why it broke: the specific single-file globs were placed in areas declared AFTER a broader prefix glob that already takes those files, and testament assigns each item to the first area in declared order whose glob matches it (testament/areas.py area_of; the .testament.toml comment says the same). The dead globs, found by applying fnmatchcase first-match over every tests/**/test_*.py at HEAD: learnings `tests/test_review_stats.py` (taken by critic `tests/test_review_*`); methodology `tests/test_coverage_algebra.py` (taken by critic `tests/test_coverage_*`); plugin `tests/test_gitignore_*` (3 files) and `tests/test_gitattributes_*` (1 file), both taken by git `tests/test_git*`; and backlog `tests/test_issue*`, which matches no file. Consequence: `testament run --area plugin`, `--area learnings` or `--area methodology` silently leaves out tests the map lists for that area, and per-area timings put them in critic/git. `areas check --strict` exits 1 on a dead glob (cli.py areas_check_found: `r.get(\"dead\")`), so the plan's Chunk 02 deliverable `every test in an area (testament areas check --strict)` does not hold as written. Fix: move each specific glob into an area declared before the broad one that swallows it, or narrow the broad globs (e.g. git `tests/test_git_*` instead of `tests/test_git*`, critic `tests/test_coverage_hook*`-style names instead of `tests/test_coverage_*`), and delete `tests/test_issue*`. Then make `testament areas check --strict` the check that pins it, rather than reading the order by eye.", "files": [".testament.toml"], "fid": "R-2"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "The scrubbed git-env helper exists in ~30 near-identical copies, and each had to be edited to spread GIT_TEST_ENV", "recommendation": "Scope: class. Why it broke: every test file that hands git a scrubbed env builds its own `_git_env`/`_env` dict (HOME outside the repo, a fixed PATH, GIT_CONFIG_GLOBAL/GIT_CONFIG_SYSTEM=/dev/null, GIT_TERMINAL_PROMPT=0). The isolation therefore reaches a helper only if its author remembers to spread `GIT_TEST_ENV`, and the conftest comment states that obligation ('it spreads GIT_TEST_ENV in itself') without anything enforcing it. This change edited 29 files to add `**GIT_TEST_ENV`, and in 31 of those sites the very next lines restate `\"GIT_CONFIG_GLOBAL\": \"/dev/null\"`, which GIT_TEST_ENV already sets. A new helper copied from one of the many scrubbed-env shapes that build without it (for example `tests/test_review_stats.py::_env`, or the hook-child envs the plan defers) silently opts out of isolation, and its tests stay uncacheable with no signal. Closure is a construction, not a longer list: one `git_env(home: Path, **extra) -> dict` in tests/conftest.py that starts from GIT_TEST_ENV and supplies the shared HOME/PATH/prompt keys, with each file's helper reduced to a call to it (members: every `**GIT_TEST_ENV` site in this diff; search `grep -rn '\"PATH\":' tests` for the rest). The redundant GIT_CONFIG_GLOBAL/SYSTEM overrides go with it.", "files": ["tests/conftest.py", "tests/test_critic_mode_inference.py", "tests/test_bounded_cumulative.py", "tests/test_change_log_archive.py", "tests/test_work_unit.py"], "fid": "R-3"}, {"goal": "The System Can Be Understood", "severity": "warning", "title": "Four area globs take nothing under the file's own first-match rule, so their tests are reported under the wrong area", "recommendation": "The [areas] comment says a test takes the FIRST area, in order, whose glob matches. Read that way, four specific globs in later areas are shadowed by broader globs in earlier ones: plugin's `tests/test_gitignore_*` and `tests/test_gitattributes_*` (taken by git's `tests/test_git*`, which matches test_gitignore_contract_semantics.py, test_gitignore_management.py, test_gitignore_probes.py and test_gitattributes_probes.py), learnings' `tests/test_review_stats.py` (taken by critic's `tests/test_review_*`), and methodology's `tests/test_coverage_algebra.py` (taken by critic's `tests/test_coverage_*`). So the per-area timing the owner asked for (plan Goals: 'see where test time goes, by area') puts gitignore/gitattributes time under `git` and review-stats/coverage-algebra time under `critic`, against what the file says it intends. It also conflicts with the plan's acceptance claim that `testament areas check --strict` passes, since the same comment says the check lists 'any glob that takes nothing'. Either the check does not flag shadowed globs, or the first-match semantics the comment states are wrong. Scope: class. It broke because a later area's specific glob can be covered by an earlier area's broader glob, and nothing flags that. Members found: the four globs above. Closure: stop the earlier broad globs from taking them (narrow `tests/test_git*` to the git subjects, and replace `tests/test_review_*`/`tests/test_coverage_*` with names that exclude the two files), or move the specific globs ahead of the broad ones. Then confirm that `testament areas check --strict` fails on a glob that takes nothing (feed it a known-dead glob first), so the class has a check and not just a fixed list.", "files": [".testament.toml"], "fid": "R-4"}], "counts": {"blocking": 0, "warning": 4, "note": 0}, "observations": [{"goal": "Nothing Is Missing", "title": "conftest says every scrubbed-env helper spreads GIT_TEST_ENV; two direct-git helpers and the deferred hook-child helpers do not", "recommendation": "The `GIT_TEST_ENV` docstring in tests/conftest.py says a helper that hands git a SCRUBBED environment \"spreads GIT_TEST_ENV in itself\". The plan's `every fact has one home` disposition also says helpers that build their own env start from it. Neither statement is relational. A query for scrubbed env dicts finds two direct-git helpers that do not spread it: `_git` in tests/test_plugin_init.py (line 473) and `_git` in tests/test_plugin_migrate.py (line 996). Their commits read the wall clock and carry none of the XDG or GIT_ALLOW_PROTOCOL isolation. About twenty scrubbed hook-child helpers also do not spread it (for example tests/test_review_stats.py `_env`, tests/test_short_plan_deferral.py `_run_stop`, tests/test_git_hygiene_probes.py:107, tests/test_stop_abandoned_critic.py:225), although the plan's Goals descope those explicitly. For now this costs no cacheability, because both files also run the hook as a child (the deferred class). Also, about twenty changed helpers still restate `\"GIT_CONFIG_GLOBAL\": \"/dev/null\"` right after `**GIT_TEST_ENV`, which repeats the dict's own fact. When the hook-child follow-up lands, spread GIT_TEST_ENV in the two `_git` helpers too, or make the docstring sentence relational, so that it names the cases it covers.", "oid": "O-1"}, {"goal": "Nothing Is Broken", "title": "the shared XDG_CONFIG_HOME directory is assumed empty and never checked", "recommendation": "`_GIT_XDG_CONFIG_HOME` is a fixed, shared path under the system temp dir (`prawduct-tests-empty-xdg-config`), created with `mkdir(exist_ok=True)` and never cleared or checked. If anything ever writes `git/ignore` or `git/attributes` there, every later run on that machine silently inherits it, and the cache would reuse results computed under it. Nothing writes there today: production only reads `$XDG_CONFIG_HOME/git/ignore` (plugin/lib/core.py:1131), and the one test that wants a global file monkeypatches its own XDG dir. An assertion at import that the directory is empty, or a per-session temp dir, would rule this out.", "oid": "O-2"}, {"goal": "The Design Is Sound", "title": "Real-clock commit dating is now hand-rolled in four test files", "recommendation": "`{**os.environ, \"GIT_AUTHOR_DATE\": stamp, \"GIT_COMMITTER_DATE\": stamp}` with `stamp = f\"@{int(time.time())} +0000\"` appears in test_stop_abandoned_critic.py (inline, new) and test_test_report_scope.py `_dated_now` (new), as well as the existing test_stranded_branch_probes.py and test_stranded_work.py. It is the inverse of GIT_FIXED_DATE, so a `git_env_dated(at=None)` beside GIT_TEST_ENV in conftest would keep the two halves of one rule together. Low cost either way. Fold it into the git_env construction if that lands.", "files": ["tests/test_stop_abandoned_critic.py", "tests/test_test_report_scope.py", "tests/conftest.py"], "oid": "O-3"}, {"goal": "Everything Is Coherent", "title": "conftest's GIT_TEST_ENV comment carries a build-history count", "recommendation": "The clause 'a future one turned 41 tests of the second kind red' is a count from this build that nothing reads, and so is the dated '(its run advice, 2026-11-23)'. The rationale works without either ('no single fixed date serves both'). Deleting them is optional: they are inert, and I am not asking for an edit on their account.", "files": ["tests/conftest.py"], "oid": "O-4"}, {"goal": "Everything Is Coherent", "title": "The uncacheable marker covers lifting GIT_CONFIG_GLOBAL but not the two tests that lift the fixed date", "recommendation": "Chunk 01 says the marker is used 'where a test lifts the isolation on purpose'. test_stop_abandoned_critic.py and test_test_report_scope.py lift the date isolation on purpose and are not marked. They already read the wall clock elsewhere, so testament's own clock detection probably makes them uncacheable anyway and behaviour does not differ. Either mark them for symmetry or narrow the stated rule to config lifts.", "files": ["tests/test_stop_abandoned_critic.py", "tests/test_test_report_scope.py"], "oid": "O-5"}, {"goal": "The Design Is Sound", "title": "The shared 'empty' XDG_CONFIG_HOME directory is not checked to be empty", "recommendation": "`$TMPDIR/prawduct-tests-empty-xdg-config` is shared by every run and worktree on the machine, presumably fixed so that the env stays cache-key-stable. Nothing asserts it is still empty, so a tool under test that writes there (gh, git with XDG paths) would leak state across runs, which is the machine-dependence this change removes. A cheap guard is to assert or clear its contents at import.", "files": ["tests/conftest.py"], "oid": "O-6"}, {"goal": "The System Can Be Understood", "title": "'Every git child' isolation claim is false for git spawned by hook subprocesses run under a scrubbed env", "recommendation": "Cites the core rule 'A coverage, completeness or absence claim (...) holds only when its falsifying query returns nothing'. The conftest docstring ('The environment every git child of this suite runs under') and the change fragment ('Every git child the test suite spawns now runs with isolated config, fixed dates and a test identity') both claim completeness. The falsifying query is test files whose env dicts set `\"PATH\":` without `**os.environ` and never spread GIT_TEST_ENV. It returns about 30 files (e.g. tests/test_evidence_store.py, tests/test_operator_verification.py, tests/test_plugin_runtime.py, tests/test_dispositions.py). They run the hook as a python3 child, and its git children inherit none of GIT_TEST_ENV. #1218 item 2 already tracks this set accurately, and those children mostly get a scratch HOME, so no one is misled into much. Make the claim relational: every git child that inherits the test process's environment, plus every helper that spreads GIT_TEST_ENV. The docstring's own helper instruction ('A helper that hands git a SCRUBBED environment') also misses a helper that hands the HOOK a scrubbed env. No edit is needed beyond that.", "files": ["tests/conftest.py", ".prawduct/changes/testament-cache-areas.md"], "oid": "O-7"}, {"goal": "Decisions Were Deliberate", "title": "conftest's stated reason for import-time application is one an autouse fixture also meets", "recommendation": "The owner ruling (owner-rulings.md 2026-11-23) and #1215 both say 'an autouse fixture'. The build departs from that, and the plan's governed_by records the deciding reason: import time also covers session-scoped fixtures. The conftest comment gives a different reason ('so that a git the PRODUCTION code spawns inherits it'), which a function-scoped autouse monkeypatch would also satisfy. A maintainer reconciling the code with the ruling from conftest alone sees no reason not to convert it back. The decision is recorded in the plan, so this is not a Goal 5 warning. If the comment states a reason, it should be the one that decided.", "oid": "O-8"}, {"goal": "The System Can Be Understood", "title": "The `core = tests/**` catch-all makes the strict assignment check vacuous, so new tests drift into core unseen", "recommendation": "With a terminal catch-all, `testament areas check --strict` can never report an unassigned test. A new critic or plans test whose name misses every listed glob lands in `core` and inflates that area's time without any signal. This is a deliberate, stated design ('core takes the rest'). It is noted so the trade-off is visible: the 'glob that takes nothing' half of the check is the only part left that can fire (see the finding).", "oid": "O-9"}], "duration_seconds": 660, "scope": "testament-cache-areas", "scope_chosen_by": "binding", "scope_unresolved_cause": null, "scope_reason": null, "base_extended_from": null, "chunks": ["01", "02"], "chunks_proposed": ["01", "02"], "chunks_declared": false, "chunks_evidence": {"01": {"paths": ["tests/conftest.py"], "paths_more": 0, "commits": []}, "02": {"paths": [".testament.toml"], "paths_more": 0, "commits": ["6ce65409e235"]}}, "base_reviewed": "e1b8ea0021100fc206183b170884b7099b9cfce6", "record_lint": {"records": [".prawduct/artifacts/build-plan-testament-cache-areas.md", ".prawduct/changes/testament-cache-areas.md"], "chunk_graded": "01", "chunks_graded": ["01", "02"], "plan_graded": ".prawduct/artifacts/build-plan-testament-cache-areas.md", "findings": [], "unchecked": [], "counts": {"chunk-ref-missing": 0, "governed-by-gap": 0, "suite-total-claim": 0, "learnings-over-budget": 0, "learnings-budget-unreasoned": 0, "learnings-core-raise-unapproved": 0, "learnings-rule-too-long": 0, "learnings-rule-body": 0, "learnings-area-dead": 0, "change-fragment": 0, "retired-claim-survives": 0, "late-requirement-record": 0}}, "span": "full", "bounded_from": null, "span_reason": "no-boundary-review", "dispatched_at": "2026-11-23T16:40:42Z"}}

{"schema": 1, "kind": "disposition", "id": "disp:rev-20261123T164037Z-5f10b40c:R-3:1:76fd547b33d8", "ts": "2026-11-23T16:49:19Z", "actor": {"worktree": "prawduct", "plugin": "3.9.1-dev", "branch": "chore/testament-cache-areas", "build": "6ce65409e235"}, "body": {"finding": {"review_id": "rev-20261123T164037Z-5f10b40c", "fid": "R-3"}, "action": "accept", "reason": "Real class defect, deferred to #1218: replacing the ~30 hand-built git-env helpers with one conftest helper means churning ~30 test files, which would collide with the in-flight real-clock fix in the same files. Each helper now starts from GIT_TEST_ENV, so today's isolation holds, and #1218 owns the consolidation (comment added there).", "backlog_id": null, "owner_ruling": null, "paths": null}}

