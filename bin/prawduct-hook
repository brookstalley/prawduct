def cmd_update_gitignore(project_dir: Path) -> int:
    """Reconcile ``.gitignore`` with the framework's session-file contract
    (``/prawduct:doctor`` repair step — gate-soundness ch.3).

    Adds missing session entries and strips lines that ignore managed files or
    RETIRED entries (the tracked-by-default build plan). ``init-product``
    early-exits on an already-scaffolded repo and the session hooks must never
    edit a tracked file (the no-noise guarantee), so this on-demand command is
    how an existing repo picks up gitignore-contract changes. Prints each
    unignored path so the caller can advise ``git add``.

    Fail-safe: if the bundled lib/ cannot be imported (an incomplete plugin
    install), print a clear message and return 1 rather than crashing.
    """
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import core as lib_core  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "update-gitignore unavailable (could not import the plugin lib/ "
            "from ${CLAUDE_PLUGIN_ROOT})",
            file=sys.stderr,
        )
        return 1
    result = lib_core.update_gitignore(project_dir)
    if result.get("unignored"):
        for path in result["unignored"]:
            print(f"unignored: {path} — now tracked-by-contract; `git add` it if present")
    print("updated .gitignore" if result.get("modified") else "no changes needed")
    return 0


def cmd_audit_learnings(project_dir: Path, argv: list[str]) -> int:
    """Audit the consumer's ``.prawduct/learnings.md`` lifecycle (F9).

    Plugin-native port of the legacy file-sync ``audit-learnings`` path (gone in
    a migrated consumer — there is no framework checkout). Walks the
    consumer's OWN ``learnings.md``, classifying entries as promotion /
    retirement / stale candidates, and with ``--apply`` moves sentinel-passing
    entries to ``learnings-detail.md``'s historical section. Invoked by
    ``/prawduct:doctor``'s Audit-Learnings flow (``--json``). ``argv`` is
    ``sys.argv[2:]`` (``--apply``, ``--json``); read-only by default.

    Fail-safe: if the bundled lib/ cannot be imported (an incomplete plugin
    install), print a clear message and return 1 rather than crashing.
    """
    rejected = _reject_unknown_args("audit-learnings", argv, {"--apply", "--json"})
    if rejected is not None:
        return rejected
    apply = "--apply" in argv
    as_json = "--json" in argv

    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import run_audit_learnings  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "error: audit-learnings could not import the plugin lib/ from "
            "${CLAUDE_PLUGIN_ROOT}.",
            file=sys.stderr,
        )
        return 1

    result = run_audit_learnings(str(project_dir), apply=apply)

    if as_json:
        print(json.dumps(result, indent=2))
        return 1 if "error" in result else 0

    if "error" in result:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1

    promotions = result["promotions"]
    retirements = result["retirements"]
    stale = result["stale_flags"]
    errors = result["errors"]
    print(
        f"audit-learnings ({'applied' if result['applied'] else 'dry-run'}): "
        f"{len(promotions)} promotion candidate(s), {len(retirements)} retirement "
        f"candidate(s), {len(stale)} stale flag(s), {len(errors)} error(s)."
    )
    for p in promotions:
        print(f"  promote: {p['title']} (confirmations={p['confirmations']})")
    for r in retirements:
        state = "retired" if r.get("applied") else ("ready" if r.get("passed") else "blocked")
        print(f"  retire[{state}]: {r['title']} (sentinel={r['sentinel']})")
    for s in stale:
        print(f"  stale: {s['title']} ({s['age_days']}d, confirmations={s['confirmations']})")
    for e in errors:
        print(f"  error: {e['title']}: {e['error']}")
    return 0


def cmd_repo_disable(project_dir: Path, argv: list[str]) -> int:
    """Disable the Prawduct plugin for the current repo (``/prawduct:repo-disable``).

    Writes ``"enabledPlugins": {"prawduct@prawduct": false}`` into
    ``.claude/settings.json`` (committed; default) or ``.claude/settings.local.json``
    (``--local``; auto-gitignored), preserving every other setting. Dry-run by
    default; ``--apply`` writes; ``--json`` emits the structured plan/result.

    There is no enable counterpart: a disabled plugin's own skills do not load, so
    re-enabling is a documented manual edit (set the value to ``true`` or delete the
    key). Fail-safe: if the bundled lib/ cannot be imported, print a clear message
    and return 1 rather than crashing.
    """
    rejected = _reject_unknown_args(
        "repo-disable", argv, {"--local", "--apply", "--json"}
    )
    if rejected is not None:
        return rejected
    local = "--local" in argv
    apply = "--apply" in argv
    as_json = "--json" in argv

    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib.repo_toggle import set_repo_disabled  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "error: repo-disable could not import the plugin lib/ from "
            "${CLAUDE_PLUGIN_ROOT}.",
            file=sys.stderr,
        )
        return 1

    result = set_repo_disabled(project_dir, local=local, apply=apply)

    if as_json:
        print(json.dumps(result, indent=2))
        return 1 if "error" in result else 0

    if "error" in result:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1

    target = result["target"]
    if result["already_disabled"]:
        print(f"Prawduct is already disabled for this repo in {target} — nothing to do.")
        return 0

    if not apply:
        print(
            f'DRY RUN: would set "enabledPlugins": {{"prawduct@prawduct": false}} in '
            f"{target} (all other settings preserved). Re-run with --apply to write it."
        )
        return 0

    print(
        f'Disabled Prawduct for this repo: wrote "prawduct@prawduct": false to {target}.\n'
        "  • Takes effect after you run /reload-plugins (this session) or restart Claude Code\n"
        "    — until then Prawduct stays active.\n"
        "  • Once disabled, the /prawduct:* commands won't load here. To RE-ENABLE later, edit\n"
        f'    {target}: set "prawduct@prawduct": true (or remove the line), then /reload-plugins.'
    )
    return 0


