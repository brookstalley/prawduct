# --- Work model: undocumented-requirement catch (build plan: work-model) -----
# The external enforcement surface for the work model (docs/work-model.md). A
# UserPromptSubmit hook surfaces, pre-turn, salient terms a user introduces that
# NO governing artifact covers — the signal a new requirement may be entering
# undocumented. The catch logic is the pure lib/work_model_index.py (Chunk 1);
# these are the thin runtime wrappers (Chunk 2). Per the plugin invariant, the
# derived index is per-repo state in ``.prawduct/.work-model-index.json`` (NOT
# plugin-bundled state), rebuilt from the repo's governing corpus (artifacts,
# CLAUDE.md, docs/, methodology/ — review-fixes Chunk 2). Both
# commands gate on ``.prawduct/`` (the user-scoped plugin fires in every repo)
# and are fail-soft — a hook error must never break session start or, above all,
# prompt submission.

_WORK_MODEL_INDEX_RELPATH = ".work-model-index.json"


def _work_model_load_lib():
    """Import the pure catch logic, seeding sys.path like the other lib readers."""
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    from lib import work_model_index  # noqa: PLC0415 — lazy import keeps top-level cheap

    return work_model_index


def _work_model_corpus_paths(project_dir: Path, prawduct_dir: Path) -> list[Path]:
    """The governing corpus the vocabulary index is built from: every markdown
    artifact under ``.prawduct/artifacts/``, plus the repo's CLAUDE.md and all
    ``docs/`` / ``methodology/`` markdown, recursively (gate-noise: product
    repos keep governing vocabulary in doc subdirectories, and the earlier
    top-level-only globs made those words read as orphans). Widening is safe in
    one direction only — extra corpus vocabulary can only suppress the nudge,
    never fire it. Missing directories simply contribute nothing — product
    repos rarely have all of them."""
    paths = sorted((prawduct_dir / "artifacts").glob("*.md"))
    claude_md = project_dir / "CLAUDE.md"
    if claude_md.is_file():
        paths.append(claude_md)
    for sub in ("docs", "methodology"):
        paths.extend(sorted((project_dir / sub).rglob("*.md")))
    return paths


def _work_model_corpus_texts(project_dir: Path, prawduct_dir: Path) -> list[str]:
    texts: list[str] = []
    for path in _work_model_corpus_paths(project_dir, prawduct_dir):
        try:
            texts.append(path.read_text(encoding="utf-8", errors="replace"))
        except OSError:
            continue
    return texts


def _work_model_ensure_index(
    project_dir: Path, prawduct_dir: Path, wmi, *, force: bool = False
) -> dict:
    """Return the vocabulary index, rebuilding from the corpus when missing,
    stale (a corpus file is newer than the index), corrupt, or ``force``."""
    index_path = prawduct_dir / _WORK_MODEL_INDEX_RELPATH
    corpus = _work_model_corpus_paths(project_dir, prawduct_dir)

    if not force and index_path.exists():
        idx_mtime = index_path.stat().st_mtime
        if all(p.stat().st_mtime <= idx_mtime for p in corpus):
            try:
                return json.loads(index_path.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                pass  # corrupt -> rebuild below

    index = wmi.build_index(_work_model_corpus_texts(project_dir, prawduct_dir))
    try:
        index_path.write_text(json.dumps(index), encoding="utf-8")
    except OSError:
        pass  # best-effort write; detection still works from the in-memory index
    return index


def cmd_build_index(project_dir: Path) -> int:
    """Rebuild the work-model vocabulary index from the repo's governing
    corpus (wired on SessionStart to warm the index). Best-effort: a build
    failure must never break session start."""
    prawduct_dir = get_prawduct_dir(project_dir)
    if not prawduct_dir.is_dir():
        return 0  # not a Prawduct-governed repo — stay silent (mirrors digest.py)
    try:
        wmi = _work_model_load_lib()
        _work_model_ensure_index(project_dir, prawduct_dir, wmi, force=True)
    except Exception as exc:  # prawduct:allow prawduct/broad-except -- index build is best-effort; must never break session start
        print(f"NOTE: Prawduct could not build the work-model index: {exc}", file=sys.stderr)
        return 0
    return 0


def cmd_user_prompt_submit(project_dir: Path) -> int:
    """UserPromptSubmit hook: inject a pre-turn nudge naming salient terms in the
    user's prompt that no governing artifact covers (tripwire #1). Silent when
    clean. Fail-soft above all else — a hook error must NEVER block the user's
    prompt, so every path returns 0 and nothing is printed on error."""
    prawduct_dir = get_prawduct_dir(project_dir)
    if not prawduct_dir.is_dir():
        return 0  # not a Prawduct-governed repo — stay silent
    try:
        raw = sys.stdin.read()
        prompt = json.loads(raw).get("prompt", "") if raw.strip() else ""
        if not prompt.strip():
            return 0
        wmi = _work_model_load_lib()
        index = _work_model_ensure_index(project_dir, prawduct_dir, wmi)
        nudge = wmi.nudge_for(prompt, index)
        if nudge:
            print(
                json.dumps(
                    {
                        "hookSpecificOutput": {
                            "hookEventName": "UserPromptSubmit",
                            "additionalContext": nudge,
                        }
                    }
                )
            )
    except Exception as exc:  # prawduct:allow prawduct/broad-except -- a hook error must never block prompt submission
        # Log to stderr only — stdout is the additionalContext channel and must
        # stay clean; the user's prompt proceeds regardless.
        print(f"NOTE: Prawduct work-model nudge skipped (hook error): {exc}", file=sys.stderr)
        return 0
    return 0


def main() -> int:
    if len(sys.argv) < 2:
        print(_USAGE, file=sys.stderr)
        return 1

    command = sys.argv[1]
    project_dir = get_project_dir()

    if command == "clear":
        return cmd_clear(project_dir, sys.argv[2:])
    elif command == "critic-begin":
        return cmd_critic_begin(project_dir)
    elif command == "critic-end":
        return cmd_critic_end(project_dir)
    elif command == "critic-consolidate":
        return cmd_critic_consolidate(project_dir)
    elif command == "subagent-stop":
        return cmd_subagent_stop(project_dir, _read_stop_stdin())
    elif command == "build-index":
        return cmd_build_index(project_dir)
    elif command == "user-prompt-submit":
        return cmd_user_prompt_submit(project_dir)
    elif command == "stop":
        return cmd_stop(project_dir, _read_stop_stdin())
    elif command == "test-status":
        return cmd_test_status(project_dir)
    elif command == "validate-evidence":
        return cmd_validate_evidence(project_dir)
    elif command == "test-evidence":
        return cmd_test_evidence(project_dir, sys.argv[2:])
    elif command == "check-cumulative-critic":
        return cmd_check_cumulative_critic(project_dir)
    elif command == "verify-chunk-refs":
        chunk_id = sys.argv[2] if len(sys.argv) > 2 else None
        return cmd_verify_chunk_refs(project_dir, chunk_id)
    elif command == "verify-coverage":
        return cmd_verify_coverage(project_dir)
    elif command == "ledger-append":
        return cmd_ledger_append(project_dir, sys.argv[2:])
    elif command == "review-stats":
        return cmd_review_stats(project_dir, sys.argv[2:])
    elif command == "classify-diff-risk":
        return cmd_classify_diff_risk(project_dir, sys.argv[2:])
    elif command == "check-operator-verification":
        return cmd_check_operator_verification(project_dir)
    elif command == "accept-operator-verification":
        rationale = sys.argv[2] if len(sys.argv) > 2 else None
        return cmd_accept_operator_verification(project_dir, rationale)
    elif command == "verify-operator-verification":
        vrf_id = sys.argv[2] if len(sys.argv) > 2 else None
        return cmd_verify_operator_verification(project_dir, vrf_id)
    elif command == "check-change-log-entry":
        return cmd_check_change_log_entry(project_dir)
    elif command == "check-pr-doc-only":
        return cmd_check_pr_doc_only(project_dir)
    elif command == "stamp-merged":
        return cmd_stamp_merged(project_dir)
    elif command == "regen-views":
        return cmd_regen_views(project_dir, sys.argv[2:])
    elif command == "infer-critic-mode":
        args = " ".join(sys.argv[2:]) if len(sys.argv) > 2 else None
        return cmd_infer_critic_mode(project_dir, args)
    elif command == "compute-verify-resolutions-scope":
        return cmd_compute_verify_resolutions_scope(project_dir)
    elif command == "resolve-base":
        return cmd_resolve_base(project_dir)
    elif command == "bug-inbox":
        return cmd_bug_inbox(project_dir)
    elif command == "advisory":
        return cmd_advisory(project_dir, sys.argv[2:])
    elif command == "migrate-plugin":
        return cmd_migrate_plugin(project_dir, sys.argv[2:])
    elif command == "init-product":
        return cmd_init_product(sys.argv[2:])
    elif command == "update-gitignore":
        return cmd_update_gitignore(project_dir)
    elif command == "audit-learnings":
        return cmd_audit_learnings(project_dir, sys.argv[2:])
    elif command == "repo-disable":
        return cmd_repo_disable(project_dir, sys.argv[2:])
    else:
        print(_USAGE, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
