def cmd_resolve_base(project_dir: Path) -> int:
    """Print the resolved diff/merge base for the PR/coverage gates and the
    reviewer/cumulative diff.

    The plugin critic/pr skills call this so the reviewer's
    ``git merge-base "$(prawduct-hook resolve-base)" HEAD`` honors the same
    configured ``base_branch:`` (gitflow ``develop``) the gates use — one
    source of truth, no prose-driven base guessing (build-plan Chunk 5 gitflow
    fix; resolves the reviewer/cumulative half of the ship-blocker).

    Exit 0: prints the resolved base ref to stdout.
    Exit 1: prints the reason to stderr (configured base unresolvable, or no
    fallback candidate present) so callers fail closed to a full review.
    """
    base, reason = _coverage()._resolve_base_branch(project_dir)
    if base is None:
        print(reason, file=sys.stderr)
        return 1
    print(base)
    return 0


