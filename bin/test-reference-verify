#!/usr/bin/env python3
"""test-reference-verify — reference floor verifier for F4a coverage evidence.

Produces the F4a fields of `.test-evidence.json`:
    - `verifier`           — this script's identifier
    - `coverage_level`     — always `referenced` (floor)
    - `changes_referenced` — changed files whose symbols appear textually in
                             at least one test file
    - `changes_unjudged`   — changed files the symbol-grep mechanism cannot
                             meaningfully judge: non-Python files, Python files
                             declaring no def/class symbols, and files deleted
                             in the diff. `verify-coverage` reports these
                             informationally instead of gating on them — a
                             gate must never block on a file its evidence
                             producer structurally cannot vouch for.
    - `tests_executed`     — test files discovered under the tests directory

The mechanism is deliberately naive: extract function/class names from each
changed Python file, then grep across the tests tree for those names. A
referenced symbol does NOT prove a test exercises the code — only that some
test mentions it. Products with non-trivial coverage concerns SHOULD supply
their own verifier (language-native coverage, test-impact analysis) and emit
`coverage_level: executed`. The framework's Critic check scales severity
language to the declared `coverage_level`.

Usage:
    python3 tools/test-reference-verify [--base REV] [--tests-dir DIR]...
                                        [--output PATH] [--merge-into PATH]

`--tests-dir` is repeatable — monorepo layouts pass each test tree once and
discovery unions across them (default: the single `tests` dir).

Without --output and --merge-into, prints the F4a fields as JSON to stdout.
With --output, writes a coverage-fields-only JSON file at PATH.
With --merge-into, reads existing evidence, merges F4a fields in, writes back
(useful for combining with the pytest-emitted v1.3.x-shape evidence record —
the "legacy" evidence with timestamp/passed/failed/skipped/command but no
F4a coverage fields; "fingerprint" was the old name from when freshness
relied on tree-hash, removed pre-v1.4).

Exit codes:
    0 — verifier completed; evidence written/printed. Note that emitting
        evidence is the only job — enforcement of `changes_referenced`
        completeness is the Critic's job (see v1.4 F4b).
    1 — argument or I/O error.
    2 — git failed (e.g., no commits to diff against).
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

VERIFIER_NAME = "test-reference-verify (floor: symbol-grep)"

# Symbol-extraction patterns — Python-focused floor.
# Matches `def NAME`, `async def NAME`, `class NAME`. Module-level identifiers
# captured naively; nested defs are fine because we only need *some* symbol
# from the file that tests might reference.
_PY_SYMBOL_RE = re.compile(
    r"^\s*(?:async\s+)?(?:def|class)\s+([A-Za-z_]\w*)", re.MULTILINE
)


def _git(args: list[str], cwd: Path) -> tuple[int, str, str]:
    """Run git with list-form argv. Returns (returncode, stdout, stderr)."""
    proc = subprocess.run(
        ["git", *args],
        cwd=str(cwd),
        capture_output=True,
        text=True,
        timeout=30,
    )
    return proc.returncode, proc.stdout, proc.stderr


def _resolve_base(cwd: Path, requested: str | None) -> tuple[str | None, str]:
    """Pick the diff base.

    If `requested` is given, it must resolve. Otherwise try, in order:
    `origin/main`, `main`, `HEAD~1`. Returns (resolved_rev, reason).
    """
    if requested:
        rc, _, err = _git(["rev-parse", "--verify", requested], cwd)
        if rc != 0:
            return None, f"--base {requested!r} does not resolve: {err.strip()}"
        return requested, f"explicit base {requested}"

    for candidate in ("origin/main", "main", "HEAD~1"):
        rc, _, _ = _git(["rev-parse", "--verify", candidate], cwd)
        if rc == 0:
            return candidate, f"auto-detected base {candidate}"
    return None, "no base candidate resolved (origin/main, main, HEAD~1 all absent)"


def _changed_files(cwd: Path, base: str) -> list[str]:
    """Files changed between `base` and the working tree.

    Combines two sources because `git diff` alone misses untracked files —
    and untracked new code with no test reference is precisely the silent
    failure this verifier exists to catch.

    - `git diff --name-only <base>` — committed-on-branch + unstaged working-tree
      changes (everything not in `base`, except untracked).
    - `git ls-files --others --exclude-standard` — untracked files Git would
      add on `git add .` (i.e. respects .gitignore).

    Returns a sorted, deduplicated list.
    """
    rc, out, err = _git(["diff", "--name-only", base], cwd)
    if rc != 0:
        raise RuntimeError(f"git diff failed: {err.strip()}")
    files = {line.strip() for line in out.splitlines() if line.strip()}

    rc2, out2, _ = _git(["ls-files", "--others", "--exclude-standard"], cwd)
    if rc2 == 0:
        files.update(line.strip() for line in out2.splitlines() if line.strip())

    return sorted(files)


def _looks_like_python(path: Path) -> bool:
    """Detect Python shebang scripts that lack a `.py` suffix.

    Catches the common `tools/foo` pattern where the file is Python but its
    name is a CLI verb. Without this, a Python CLI script would be classified
    `changes_unjudged` and escape the gate entirely, even though its
    `def`/`class` symbols are perfectly greppable.
    """
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            first = fh.readline()
    except OSError:
        return False
    return first.startswith("#!") and "python" in first


def _is_python_file(path: Path) -> bool:
    """True for `.py` files and python-shebang scripts — the only files the
    symbol-grep mechanism can judge."""
    return path.suffix == ".py" or _looks_like_python(path)


def _extract_symbols(path: Path) -> set[str]:
    """Return Python defs/classes declared in `path` (a Python file).

    An empty set means the file declares no symbols (re-export-only
    `__init__.py`, constants-only module) — the caller classifies it as
    unjudged rather than letting it sit permanently unreferenced. The old
    filename-stem fallback for non-Python files was dropped with the
    `changes_unjudged` split: stem matching was noise in both directions
    (a test mentioning the word "config" vouched for `config.yaml`; a
    doc rename broke the match), and non-Python files are now honestly
    reported as outside this verifier's judgment.
    """
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return set()
    return set(_PY_SYMBOL_RE.findall(text))


def _discover_tests(tests_dir: Path) -> list[Path]:
    """List test files under `tests_dir` (Python test_*.py / *_test.py).

    Order is sorted to keep evidence stable across runs.
    """
    if not tests_dir.is_dir():
        return []
    out: list[Path] = []
    for p in tests_dir.rglob("*.py"):
        name = p.name
        if name.startswith("test_") or name.endswith("_test.py"):
            out.append(p)
    return sorted(out)


def _read_test_texts(test_files: list[Path]) -> list[str]:
    """Read each test file's contents once.

    `_has_reference` runs once per changed file, so reading the tests inline
    there would be O(changed × tests) disk reads. Caching the text up front
    makes the per-changed-file work pure in-memory substring matching.
    Unreadable files are skipped (same OSError tolerance as before).
    """
    texts: list[str] = []
    for tp in test_files:
        try:
            texts.append(tp.read_text(encoding="utf-8", errors="replace"))
        except OSError:
            continue
    return texts


def _has_reference(test_texts: list[str], symbols: set[str]) -> bool:
    """True if any cached test text references any symbol in `symbols`."""
    if not symbols:
        return False
    for text in test_texts:
        for sym in symbols:
            if sym and sym in text:
                return True
    return False


def _build_evidence_fields(
    cwd: Path,
    base: str,
    tests_dirs: list[Path],
) -> dict:
    """Compute the F4a coverage fields for the current diff.

    ``tests_dirs`` may name several trees (monorepo layouts — gate-soundness
    ch.2): discovery unions across all of them, so ONE run covers every
    component and no multi-pass merge dance is needed.
    """
    changed = _changed_files(cwd, base)
    test_files = sorted(
        {t for d in tests_dirs for t in _discover_tests(d)}
    )
    test_file_paths = [str(t.relative_to(cwd)) for t in test_files]
    # Read every test file ONCE, then match all changed files against the
    # cached text — O(changed + tests) reads instead of O(changed × tests).
    test_texts = _read_test_texts(test_files)

    referenced: list[str] = []
    unjudged: list[str] = []
    for f in changed:
        fp = cwd / f
        if not fp.is_file():
            # Deleted in the diff — nothing on disk to test, nothing to judge.
            unjudged.append(f)
            continue
        if not _is_python_file(fp):
            # Symbol-grep has no signal for non-Python files.
            unjudged.append(f)
            continue
        symbols = _extract_symbols(fp)
        if not symbols:
            # Symbol-less Python (re-export __init__, constants module).
            unjudged.append(f)
            continue
        if _has_reference(test_texts, symbols):
            referenced.append(f)
        # else: a judged Python file with no test reference — the legitimate
        # gap `verify-coverage` exists to catch. It stays out of both lists.

    return {
        "verifier": VERIFIER_NAME,
        "coverage_level": "referenced",
        "tests_executed": test_file_paths,
        "changes_referenced": referenced,
        "changes_unjudged": sorted(unjudged),
    }


def _merge_into(evidence_path: Path, new_fields: dict) -> None:
    """Read existing evidence, overlay F4a fields, write back."""
    if not evidence_path.is_file():
        raise FileNotFoundError(evidence_path)
    existing = json.loads(evidence_path.read_text())
    if not isinstance(existing, dict):
        raise ValueError(f"{evidence_path}: existing evidence is not a JSON object")
    existing.update(new_fields)
    evidence_path.write_text(json.dumps(existing, indent=2, sort_keys=True) + "\n")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="test-reference-verify",
        description="Floor coverage verifier — naive symbol-grep across changed files.",
    )
    parser.add_argument(
        "--base",
        default=None,
        help="Git rev to diff against (default: origin/main, then main, then HEAD~1).",
    )
    parser.add_argument(
        "--tests-dir",
        action="append",
        default=None,
        help=(
            "Directory to search for test files. Repeatable for monorepo "
            "layouts (e.g. --tests-dir engine/tests --tests-dir server/tests); "
            "discovery unions across all given dirs. Default: tests."
        ),
    )
    parser.add_argument(
        "--repo",
        default=".",
        help="Project root (default: cwd). Resolves --tests-dir and the git work tree.",
    )
    parser.add_argument(
        "--output",
        default=None,
        help="Write F4a fields as standalone JSON to this path.",
    )
    parser.add_argument(
        "--merge-into",
        default=None,
        help="Merge F4a fields into an existing evidence JSON at this path.",
    )
    args = parser.parse_args(argv)

    if args.output and args.merge_into:
        print("error: --output and --merge-into are mutually exclusive", file=sys.stderr)
        return 1

    repo = Path(args.repo).resolve()
    # argparse appends onto a list default, so default via None-coalescing.
    tests_dirs = [(repo / d).resolve() for d in (args.tests_dir or ["tests"])]

    base, base_reason = _resolve_base(repo, args.base)
    if base is None:
        print(f"error: cannot resolve diff base — {base_reason}", file=sys.stderr)
        return 2

    try:
        fields = _build_evidence_fields(repo, base, tests_dirs)
    except RuntimeError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    if args.merge_into:
        try:
            _merge_into(Path(args.merge_into).resolve(), fields)
        except (FileNotFoundError, ValueError, json.JSONDecodeError, OSError) as exc:
            print(f"error: merge-into failed: {exc}", file=sys.stderr)
            return 1
        return 0

    if args.output:
        out = Path(args.output).resolve()
        try:
            out.write_text(json.dumps(fields, indent=2, sort_keys=True) + "\n")
        except OSError as exc:
            print(f"error: write failed: {exc}", file=sys.stderr)
            return 1
        return 0

    print(json.dumps(fields, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
