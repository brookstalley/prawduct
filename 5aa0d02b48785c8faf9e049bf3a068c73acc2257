.json", "tests/fixtures/host_seam_golden/banner_managed.json", "tests/fixtures/host_seam_golden/banner_no_project.json", "tests/fixtures/host_seam_golden/clear_brief_only.json", "tests/fixtures/host_seam_golden/clear_brief_only_config_home.json", "tests/fixtures/host_seam_golden/clear_session_start.json", "tests/fixtures/host_seam_golden/digest.json", "tests/fixtures/host_seam_golden/digest_ungoverned.json", "tests/fixtures/host_seam_golden/stop_advisory_complete_turn.json", "tests/fixtures/host_seam_golden/stop_advisory_empty_tasks.json", "tests/fixtures/host_seam_golden/stop_advisory_no_fields.json", "tests/fixtures/host_seam_golden/stop_advisory_null_message.json", "tests/fixtures/host_seam_golden/stop_advisory_running_turn.json", "tests/fixtures/host_seam_golden/stop_advisory_tasks.json", "tests/fixtures/host_seam_golden/stop_advisory_tasks_and_turn.json", "tests/fixtures/host_seam_golden/stop_block_complete_turn.json", "tests/fixtures/host_seam_golden/stop_block_empty_tasks.json", "tests/fixtures/host_seam_golden/stop_block_garbage.json", "tests/fixtures/host_seam_golden/stop_block_no_fields.json", "tests/fixtures/host_seam_golden/stop_block_null_message.json", "tests/fixtures/host_seam_golden/stop_block_running_turn.json", "tests/fixtures/host_seam_golden/stop_block_tasks.json", "tests/fixtures/host_seam_golden/stop_block_tasks_and_turn.json", "tests/fixtures/host_seam_golden/stop_clean_complete_turn.json", "tests/fixtures/host_seam_golden/stop_clean_empty_tasks.json", "tests/fixtures/host_seam_golden/stop_clean_no_fields.json", "tests/fixtures/host_seam_golden/stop_clean_null_message.json", "tests/fixtures/host_seam_golden/stop_clean_running_turn.json", "tests/fixtures/host_seam_golden/stop_clean_tasks.json", "tests/fixtures/host_seam_golden/stop_clean_tasks_and_turn.json", "tests/fixtures/host_seam_golden/stop_worktree_redirect.json", "tests/fixtures/host_seam_golden/subagent_stop_no_fields.json", "tests/fixtures/host_seam_golden/subagent_stop_non_reviewer.json", "tests/fixtures/host_seam_golden/subagent_stop_non_string_agent_type.json", "tests/fixtures/host_seam_golden/subagent_stop_reviewer.json", "tests/test_binary_skew_guard.py", "tests/test_host_seam.py", "tests/test_host_seam_golden.py", "tests/test_plugin_caches.py", "tests/test_short_plan_deferral.py", "tests/test_stop_gate_defer.py", "tests/test_stop_verdict_defer.py", "tools/host-seam-parity.py"], "files_oracle": [".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-host-seam.md", ".prawduct/changes/host-seam.md"], "findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "No-behavior-change refactor: the goldens never reach the rewritten block reason's advisory and canary branches", "recommendation": "Why it broke: cmd_stop's blocking exit was rewritten from incremental stderr prints into one assembled reason handed to host.block (blockers, waiver footer, `_stop_advisories_in_block`, then the COMPLIANCE CANARY lines). No golden reaches the last two. Every stop_block_* golden carries only blockers and the footer. `grep -l 'ADVISORIES\\|COMPLIANCE CANARY' tests/fixtures/host_seam_golden/stop_*` returns nothing, and no test anywhere asserts the canary in a block reason. The advisory-in-block path is pinned only by a substring check in test_short_plan_deferral.py (`'ADVISORIES (not blocking):' in result.stderr`), which is exactly the substring assertion this rule says misses drift in a no-behavior-change refactor. Reading the code, I believe the bytes are identical today (print(x) and f\"{x}\\n\" agree, and _waiver_footer has no side-effect writes), but nothing would catch an ordering or newline regression in those two branches. Fix: add two blocking golden cases, a blocker plus an exit-0 advisory (the _plan_repo fixture with the reflection removed) and a blocker plus a canary finding. Record them by running the golden test with PRAWDUCT_UPDATE_GOLDENS=1 against base b9d9489d's plugin tree (a worktree), so they are pre-refactor evidence like the others, then confirm they pass on HEAD. Scope: instance.", "files": ["plugin/bin/prawduct-hook", "tests/test_host_seam_golden.py"], "fid": "R-1"}, {"goal": "Nothing Is Missing", "severity": "warning", "title": "Built-but-unconsumed: HostEvent.fields_present has no production reader", "recommendation": "core.md: \"A channel that is produced and never consumed is a DEFECT, not an inefficiency \u2014 name the consumer in the same change that adds the producer, or don't produce\". The plan cites this same rule to leave `session_boundary` out of HostEvent. `grep -rn fields_present plugin/` finds only host.py; no gate, hook or command reads it. Every reader before the refactor treated null and absent alike, so nothing needs the distinction yet. Only test_host_seam.py reads it. Drop the field and its assertions until #1038 (or whichever change first reads it) adds field and reader together, as was done for session_boundary. Or name the reader now. Scope: instance.", "files": ["plugin/lib/host.py", "tests/test_host_seam.py"], "fid": "R-2"}, {"goal": "Nothing Is Broken", "severity": "warning", "title": "Parity sweep exits 0 having compared nothing, and its blind-spot control is not committed", "recommendation": "core.md: \"A check never seen to return non-zero proves nothing\". main() returns `1 if differing else 0`. A sweep where every repo is skipped exits 0, and so does one with no candidates at all. All repos are skipped when `cp -cRp` fails (APFS clonefile; GNU cp has no -c, so every repo becomes 'could not run'). No candidates means no `*/.prawduct` siblings. A maintainer re-deriving the R-3 real-repo claim with the command the change record cites gets success from a run that proved nothing. The change record says the tool is not blind because a run against a plugin 25 commits older showed differences. That run was by hand and left nothing behind, and no test covers normalize() (whose `_TREE_ID` / `_SNAPSHOT_AGE` substitutions are what could hide a real difference) or skip_reason(). Fix: exit non-zero when zero repos were compared. Commit a test that runs normalize() on a line carrying a tree id and a snapshot age, with a control line that must survive unchanged. Also commit the positive control: compare_repo() over a temp governed repo with two plugin trees differing by one emitted byte, which must report a DIFF. Scope: instance.", "files": ["tools/host-seam-parity.py"], "fid": "R-3"}, {"goal": "Nothing Is Broken", "severity": "note", "title": "A seam that fails to load makes the Stop gate exit 1, which Claude Code reads as non-blocking", "recommendation": "gates.md: \"'Fail closed' means the channel's BLOCKING value, not any non-zero\". get_project_dir() now calls `_host()` before dispatch and outside its ImportError fallback. If the binary's own `lib/host.py` is absent or broken, `stop` reaches main()'s error floor and exits 1, so the session ends ungated. Every other unhandled Stop crash already has this posture, and a real plugin tree always ships host.py beside bin/, so reach is low. The plan's Chunk 02 decision rejected a fallback on R-2 grounds. Two changes: record the exit-1 consequence beside that decision so the posture is chosen rather than incidental, and delete the get_project_dir docstring sentence saying a broken or absent plugin lib/ must not crash there, which is no longer true for host.py. No code change wanted. Scope: instance.", "files": ["plugin/bin/prawduct-hook"], "fid": "R-4"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "Stop's block reason is still co-written outside the seam: cmd_stop's earlier stderr lines reach the model only through Claude's exit-2 stderr semantics", "recommendation": "Scope: class. Why it broke: `host.block` took over the exit code and the final BLOCKED text, but under Claude Code the block reason is ALL of stderr, and cmd_stop still prints model-directed lines to stderr before it calls `host.block`. These include the worktree redirect note (prawduct-hook ~2907), the learnings-budget NOTEs (~3373, ~3380), the Critic mode NOTE (~3929) and GATE WAIVERS (~4023), whose comment says it exists 'so the agent (and reviewer) can see what was skipped'. On a blocking Stop those lines are part of the reason only because of how Claude treats stderr. So the comment at the block site ('The block reason is assembled whole and handed to the host, which owns how a Stop blocks'), host.py's module docstring and the change fragment's 'only writers of hook response shapes' all claim more than the code does. Consequence: the #1038 Codex implementer trusts that claim, implements `block` as Codex's structured response, and those lines silently stop reaching the model. The pinning test only shows stderr is empty in its one fixture. The same class covers SessionStart plain stdout: the banner's plain-stdout output is host-delivered context like the briefing, but only the briefing is recorded as an unrouted deviation. Fix it in one of two ways. (a) Collect cmd_stop's model-directed notes into the `reason` list (or a host-owned 'notes' channel) so everything the model reads at a blocking Stop goes through `host.block`, and record the banner's plain stdout beside the briefing deviation. (b) Narrow the claims (block-site comment, host.py docstring, fragment) to 'the exit code and the final reason text', and list stderr-before-block and plain SessionStart stdout as host semantics #1038 must re-home. Bound: `print(..., file=sys.stderr)` and bare `print(` on the stop / clear --session-start / banner paths whose delivery depends on the host.", "files": ["plugin/bin/prawduct-hook", "plugin/lib/host.py", "plugin/hooks/banner.py", "tests/test_host_seam.py"], "fid": "R-5"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "rule-unenforced: produced-never-consumed channel \u2014 HostEvent.fields_present and HostEvent.event have no production reader", "recommendation": "Scope: class. Rule (core.md): 'A channel that is produced and never consumed is a DEFECT, not an inefficiency \u2014 name the consumer in the same change that adds the producer, or don't produce'. The plan cites this exact rule to leave `session_boundary` out of HostEvent, then adds `fields_present` (null vs absent). Nothing under plugin/ reads it: `_last_message` treats null and absent the same, and absent `background_tasks` is already carried by `background_tasks is None`. Only tests/test_host_seam.py (lines ~152-153, ~185) reads it, which pins it as seam contract. `HostEvent.event` is likewise set and never read. Consequence: the outside contributor building #1038's second implementation must reproduce a field nothing consumes, under a test that treats it as contract. Remedy: drop `fields_present` (and `event`, keeping the ValueError check on the argument if wanted) until a reader lands with it, as was done for `session_boundary`. To mechanise the rule for this seam: in test_host_seam.py, assert that every `dataclasses.fields(HostEvent)` name has an attribute read (`.<name>`) in some plugin/ file other than host.py. That is a derived check that also catches the next speculative field.", "files": ["plugin/lib/host.py", "tests/test_host_seam.py"], "fid": "R-6"}, {"goal": "Everything Is Coherent", "severity": "note", "title": "get_project_dir's 'bootstrap-resilient: a broken/absent plugin lib/ must not crash here' no longer holds for the seam it now calls first", "recommendation": "Scope: instance. `hint = _host().project_dir_hint()` runs outside the ImportError fallback. A missing or broken `lib/host.py` beside the binary now crashes every command before dispatch. That is a deliberate choice (the plan's Chunk 02 decision rejected a fallback for a missing seam), but the docstring still states the old invariant. Make it relational ('a broken lib/ under the plugin root falls back; the host seam beside this script is required'), or delete the sentence. Prose only. Nothing reads it, and no other edit is wanted.", "files": ["plugin/bin/prawduct-hook"], "fid": "R-7"}, {"goal": "The Design Is Sound", "severity": "note", "title": "The seam loads under a path-blind private module name, so one process can hold two seams from two plugin trees", "recommendation": "Scope: instance. prawduct-hook, banner.py and digest.py each carry the same 15-line `_host()` loader. It caches the script tree's host.py as `sys.modules['prawduct_host']`, while plugin_activation.py and stranded_work.py import `lib.host` from whatever `_plugin_root()` put on sys.path. In a skew (`CLAUDE_PLUGIN_ROOT` names another tree, the exact case test_binary_skew_guard sets up), the host-validity check and the config-home reader come from different copies. Also, the first tree to load wins for every later loader in the process, whatever its path. Behaviourally inert today, since only Claude is implemented and the copies are identical in a normal install. Once a second host exists, the two copies can disagree. The three loaders are already behaviour-pinned together (TestSeamLoaders), so their duplication is acceptable. Either note the two-instance reality in host.py's docstring, or have lib modules take the seam from `sys.modules.get('prawduct_host')` when present. No change is required before merge.", "files": ["plugin/bin/prawduct-hook", "plugin/hooks/banner.py", "plugin/hooks/digest.py", "plugin/lib/plugin_activation.py", "plugin/lib/stranded_work.py"], "fid": "R-8"}, {"goal": "The Design Is Sound", "severity": "note", "title": "gates' payload readers duck-type with getattr, so a raw dict (the previous contract) silently reads as 'no signal'", "recommendation": "Scope: instance. `background_tasks_in_flight`, `_last_message` and their callers take an untyped `event` and read it with `getattr(event, ..., None)`. A caller still passing the old dict gets no deferral and no handover-contradiction check, and nothing errors. Today cmd_stop is the only caller and passes a HostEvent, so this is latent. Annotate the parameter as `host.HostEvent` and use attribute access, so a wrong-type call raises instead of quietly turning gates off. The 'not an event at all' rung in the docstring then goes away.", "files": ["plugin/lib/gates.py"], "fid": "R-9"}, {"goal": "The System Can Be Understood", "severity": "warning", "title": "An unknown PRAWDUCT_HOST is visible only through the Stop block, and that is the one Stop block never recorded", "recommendation": "Scope: instance. Why it broke: the unknown-host check returns `host.block(...)` early in `cmd_stop`, before the blocker-assembly path, and that path is where `_record_stop_block` runs. Every other blocking exit of `cmd_stop` goes through that path; this one skips it. `_record_stop_block` exists 'so a gate's firing rate is a query rather than a transcript search' and so 'the count stays complete'. The unknown-host block writes no fact, not even `unattributed`. It is also the only signal a mis-set variable produces. The SessionStart, SubagentStop, banner and digest refusals print a NOTE to stderr and exit 0, and exit-0 output 'is logged and reaches nobody' (this file's own `_deliver_stop_advisories` docstring). So a mis-set `PRAWDUCT_HOST` (the realistic failure of the #1038 adapter's hook registration) silently drops the briefing, digest and Critic consolidation, then blocks every Stop. The per-gate firing record, which is the query an operator uses to ask what is blocking, shows nothing. Fix: record the block under its own gate id (for example `host`) through `_record_stop_block` before returning, and pin it with a test that asserts the fact lands. Recording writes host-neutral evidence; it is not one of the gates the comment says must not run on a guess.", "files": ["plugin/bin/prawduct-hook"], "fid": "R-10"}, {"goal": "The System Can Be Understood", "severity": "warning", "title": "The parity sweep reports success when it compared nothing, and the change record's re-derive command reaches that case after merge", "recommendation": "Scope: class, the vacuous-success arms of one verdict in `main()`. Why it broke: the exit code is `1 if differing else 0`, so 'compared and equal' and 'compared nothing' are the same answer. Two members: (a) `--base` defaults to `merge-base develop <head>`. Once this branch is merged that is HEAD itself, so `tools/host-seam-parity.py --work <dir>` exports one plugin tree twice and prints SAME for every repo. That is the exact command `.prawduct/changes/host-seam.md` gives to 're-derive' the parity claim. The record also says a run against an older plugin shows differences 'so a clean result is not the tool going blind', which leads a reader to trust that vacuous SAME. (b) A sweep where every repo was skipped or 'could not run' exits 0. Per tests.md, 'When a check's subject is a SET, assert it is non-empty and holds what it names, or green means nothing was looked at'. Per core.md, 'A check never seen to return non-zero proves nothing'. Close it by construction in the verdict: refuse with a non-zero exit when `git rev-parse <base>:plugin` equals `<head>:plugin`, and exit non-zero when `same` is empty. Then make the record's command cite the refs the run used (`--base b9d9489d --head 17f84cd6`) instead of relying on the default.", "files": ["tools/host-seam-parity.py", ".prawduct/changes/host-seam.md"], "fid": "R-11"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "HostEvent.fields_present is produced with no production reader, and the plan applied the produced-never-consumed rule to its sibling field only", "recommendation": "Scope: instance. The plan drops the issue's `session_boundary` field by citing core.md, 'A channel that is produced and never consumed is a DEFECT, not an inefficiency \u2014 name the consumer in the same change that adds the producer'. It keeps `fields_present`, whose only readers are `tests/test_host_seam.py` lines 152-153 and 185. The same applies to the None-vs-() distinction on `background_tasks`: `gates.background_tasks_in_flight` reads both as 'no deferral'. Both do trace to a parent, `928-requirements.md` row 8 ('Normalize null and absent distinctly'), and the consumer is presumably #1038. What is missing is the recorded reason why one channel kept for a future reader stays while the other was cut. Without it, the next maintainer applying the same rule deletes `fields_present` as dead. Either add that sentence to the plan's 'Null versus absent' deviation, naming row 8 as the parent and #1038 as the consumer, or drop the field the same way `session_boundary` was dropped.", "files": ["plugin/lib/host.py", ".prawduct/artifacts/build-plan-host-seam.md"], "fid": "R-12"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Mid-build decisions for the owner", "recommendation": "Scope: none. Recorded mid-build decisions and what settled each: (1) the goldens normalize five run facts, not the issue's two. Settled by 'do it right', not by the goals, and the plan says so. The Chunk 01 deliverable line ('the temp path and timestamps') is superseded beneath it. (2) A populated CLAUDE_CONFIG_DIR golden, from Critic O-4. (3) Fixtures copy lib/host.py, and a missing-seam fallback was rejected under R-2. (4) The banner now expands `~` in CLAUDE_CONFIG_DIR, and DEFAULT_PLUGINS_FILE is removed ('one home'). This is the only user-visible behaviour change, and the consumer note discloses it. (5) The test_short_plan_deferral exit pin was renegotiated in the open. (6) The sweep normalizes the tree id and snapshot age, and the same-plugin control was dropped as flaky. (7) Linked worktrees are skipped. Inferences still flagged for owner veto: no `session_boundary` field, normalized task labels, `fields_present`, the config-root split, unknown-host block-vs-note, exit-2 scope, and the plain-stdout briefing left outside the seam (the plan says it is 'Noted on #1037 at the boundary'; confirm that note was posted). No alignment-pass miss found. The owner's added verification goal (parity on real repos) is delivered by Chunk 03.", "files": [".prawduct/artifacts/build-plan-host-seam.md"], "fid": "R-13"}, {"goal": "The System Can Be Understood", "severity": "note", "title": "Learnings cross-check: pre-dispatch seam load has no fail-open, and two docstrings still promise it", "recommendation": "Scope: instance. `get_project_dir` now calls `_host()` before command dispatch and outside its ImportError fallback. hook-surface.md: 'Code in `prawduct-hook` `main()` that runs BEFORE command dispatch must fail open on a `lib/` ImportError (fall back to env/cwd)'. If bin/../lib/host.py is absent or unloadable, every command, doctor included, becomes `error: <cmd>: FileNotFoundError` at exit 1 via main's floor. On Stop that exit fails open: gates.md, ''Fail closed' means the channel's BLOCKING value, not any non-zero'. The plan records rejecting the fallback (R-2), and the seam loads from the binary's own tree, so the CLAUDE_PLUGIN_ROOT skew case the rule was written for cannot reach it. For that reason this is not escalated. What is stale is prose: `get_project_dir`'s docstring and `test_get_project_dir_falls_back_when_lib_unimportable`'s docstring both still say 'a broken/absent plugin lib/ must not crash it'. That is false when host.py is the absent part (hook-surface.md: 'A docstring or comment is a claim'). Make both relational, covering a broken lib/ other than the host seam, which loads from this script's own tree. Also name the hook-surface rule in the plan's Chunk 02 decision so the departure reads as ruled. No learnings rules were added or changed this cycle. Files read: core.md, authoring.md, gates.md, hook-surface.md, release.md, tests.md (from `learnings-files --for-diff`).", "files": ["plugin/bin/prawduct-hook", ".prawduct/artifacts/build-plan-host-seam.md"], "fid": "R-14"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Backlog item appears resolved: brookstalley/prawduct#1037 (plugin-runtime: one host seam for hook payloads and roots)", "recommendatio