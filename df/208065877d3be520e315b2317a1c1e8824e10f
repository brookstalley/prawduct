logy_digest.py", "tests/test_stats.py", "tests/test_stop_block_facts.py", "tests/test_stop_verdict_defer.py", "tests/test_v5_methodology.py", "tools/measure-self-citing-clear.py"], "files_changed": [".prawduct/artifacts/build-plan-audit-guidance.md", ".prawduct/artifacts/digest-behavior-inventory.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/audit-guidance.md", ".prawduct/cross-cutting-concerns.md", "documentation/issues/928-requirements.md", "documentation/project-structure.md", "plugin/bin/prawduct-hook", "plugin/docs/discipline.md", "plugin/docs/governance-telemetry.md", "plugin/hooks/gates.json", "plugin/lib/evidence.py", "plugin/lib/gates.py", "plugin/lib/standing_block.py", "plugin/lib/stats.py", "plugin/methodology/building.md", "plugin/methodology/delegation.md", "plugin/methodology/discovery.md", "plugin/methodology/planning.md", "plugin/methodology/reflection.md", "plugin/methodology/session-digest.md", "plugin/methodology/session-hygiene.md", "plugin/skills/doctor/SKILL.md", "plugin/skills/methodology/SKILL.md", "plugin/templates/owner-rulings.md", "plugin/templates/project-preferences.md", "tests/fixtures/host_seam_golden/stop_block_advisory_canary.json", "tests/fixtures/host_seam_golden/stop_block_complete_turn.json", "tests/fixtures/host_seam_golden/stop_block_empty_tasks.json", "tests/fixtures/host_seam_golden/stop_block_garbage.json", "tests/fixtures/host_seam_golden/stop_block_no_fields.json", "tests/fixtures/host_seam_golden/stop_block_null_message.json", "tests/test_ephemeral_worktree.py", "tests/test_plugin_methodology_digest.py", "tests/test_stats.py", "tests/test_stop_block_facts.py", "tests/test_stop_verdict_defer.py", "tests/test_v5_methodology.py", "tools/measure-self-citing-clear.py"], "files_oracle": [".prawduct/artifacts/build-plan-audit-guidance.md", ".prawduct/artifacts/digest-behavior-inventory.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/audit-guidance.md", ".prawduct/cross-cutting-concerns.md"], "findings": [{"goal": "Nothing Is Broken", "severity": "note", "title": "A one-line close soft-wrapped onto a second line silently reads as no verdict", "recommendation": "Scope: instance. _one_line_close reads only the last non-blank line, so a close whose reason wraps (\"`RUNNING` \u00b7 `DO NOT CLEAR` \u2014 the review\\nis in flight\") is not a one-line close. The fallback then reads it as a three-paragraph final paragraph, which does not lead with a clear label, so clear_verdict returns None. This fails closed: the reflection and Critic gates block instead of deferring, and nothing is mis-permitted. Because the guidance asks for one line, this is a rough edge rather than a defect. If you want it pinned, add a TestTheOneLineClose case that asserts the wrapped form yields no verdict, so the behaviour is deliberate. Otherwise no edit is needed.", "files": ["plugin/lib/standing_block.py", "tests/test_stop_verdict_defer.py"], "fid": "R-1"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "delegation.md's integrator instruction cannot be followed alongside its own dispatch rule", "recommendation": "Instance. The cause is that the new integrator role was added beside dispatch prose written for build delegates. delegation.md 'Dispatch and reaping' says to dispatch with `isolation: \"worktree\"`, calls it 'the only shape that moves a delegate', and says 'Don't have it switch branches'. That puts every delegate on the harness scratch branch `worktree-agent-<id>`, which `gitstate.ephemeral_kind_of` classifies as ephemeral. But 'Who does what' tells the coordinator to give the integrator 'the branch in a tree where the run's record lands on that branch', and warns that a heavy run from a scratch worktree records only a narrowed fact, so the integration branch's gates read stale. Read top to bottom, the guide has the coordinator dispatch its integrator isolated. The integrator then runs the heavy suite, the gates still read stale, and the heavy run is paid twice: exactly the cost the rewrite exists to avoid. Fix: say where the integrator runs, i.e. in the coordinator's own checkout (shared worktree, not isolated) or in a worktree on the named integration branch, and scope the 'Dispatch with isolation' and 'Don't have it switch branches' sentences to build delegates. building.md 'Who integrates' and the project-preferences `Delegation` row name the integrator without this constraint. Check that both agree once the guide does.", "files": ["plugin/methodology/delegation.md", "plugin/methodology/building.md"], "fid": "R-2"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "owner-rulings.md is written but nothing tells a later session to read it", "recommendation": "Instance (a producer with no consumer: core learning 'A channel that is produced and never consumed is a DEFECT'). building.md 'When the Owner Rules' says 'later sessions and people read that file', and the template says 'This file is the one place a later session looks for what the owner said'. No surface makes that true. A query for `owner-rulings` across plugin/ finds only the two write instructions (building.md, session-digest.md) and the template. The alignment pass, 'Deciding Mid-Build' ('match the product's other choices ... search it'), discovery's prior-decision check, the Critic protocol and the SessionStart handoff never point a session at it. Entries point to where a decision landed, so most rulings stay reachable through their governing artifact. A ruling that landed nowhere else, such as a correction or a stated preference, sits in a file no later session is told to open, and that session rebuilds against it. Fix: name the reader in the same change. One clause in building.md's alignment pass or 'Deciding Mid-Build' order is enough ('the product's other choices' includes `.prawduct/owner-rulings.md`), since the digest is at its wall. Otherwise, delete the claim that later sessions read it.", "files": ["plugin/methodology/building.md", "plugin/templates/owner-rulings.md"], "fid": "R-3"}, {"goal": "The Design Is Sound", "severity": "note", "title": "Delegate model floor is stated in one vendor's model tiers", "recommendation": "Instance; Framework Check 7 (Generality). delegation.md's five holds and the session digest state the model policy as 'Opus- or Sonnet-class' and 'never lighter than Sonnet-class'. The content is owner-approved (#1133), and the guide already resolves it as a fallback chain rather than a pinned alias, which follows the authoring rule 'When prose picks the model a reviewer/subagent runs on, express it as an ordered fallback chain'. But the floor is named only in one host's tier names. 928-requirements.md documents a second host, and on that host 'Sonnet-class' means nothing. If the host work proceeds, phrase the floor by property, with the class names as this host's instance: for example, 'a mid-tier general model or stronger, never the session's top tier by default; on Claude, Sonnet- or Opus-class'. No edit is needed while Claude Code is the only supported host.", "files": ["plugin/methodology/delegation.md", "plugin/methodology/session-digest.md"], "fid": "R-4"}, {"goal": "The Design Is Sound", "severity": "note", "title": "gates.turn_cites_itself_as_record has no production caller, and its edited docstring describes one", "recommendation": "Instance. The Stop hook calls `turn_self_citation`. `turn_cites_itself_as_record` is now reached only from tests/test_stop_verdict_defer.py. This change rewrote its docstring to say 'because the caller records it as a firing', and no such caller exists. This was already true before the change and nothing reads the docstring, so it does not need its own commit. If the module is touched again, delete the wrapper and repoint its degradation-ladder test at `turn_self_citation`.", "files": ["plugin/lib/gates.py"], "fid": "R-5"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "scope-trace: the owner-rulings record has a writer and no reader", "recommendation": "Instance. The change tells every session to write rulings to `.prawduct/owner-rulings.md` (building.md \"When the Owner Rules\", session-digest.md line 57). The template and building.md both say \"later sessions and people read that file\", but no guide, skill or check tells anyone to read it. The alignment pass in building.md \"Before You Build\" searches product, architecture and the backlog and never this file, and the Critic's Goal 5 judges against plan Goals and the brief only. The consequence: a later session about to change something the owner already ruled on never opens the record, so #1135's \"lost ruling\" stays lost; it is just written down somewhere unread. Core learnings rule: \"A channel that is produced and never consumed is a DEFECT \u2014 name the consumer in the same change that adds the producer\". Name the consumer in this change: one clause in the alignment pass (\"check `.prawduct/owner-rulings.md` for a ruling on what you are about to change\"), which the digest's existing alignment-pass line can carry. The other option is to delete the \"later sessions read that file\" claim from building.md and the template.", "files": ["plugin/methodology/building.md", "plugin/methodology/session-digest.md", "plugin/templates/owner-rulings.md"], "fid": "R-6"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "Two plan inferences are still unconfirmed at the boundary, one of them a consumer-committed filename", "recommendation": "Instance; the owner confirms, no code changes. The build plan's Goals still mark two items *Inferred* \"for the owner to veto at the boundary\", and this is that boundary. (1) The one-line close keeps the existing labels (`RUNNING`, `YOUR TURN`, `COMPLETE`, `SAFE TO CLEAR`, `DO NOT CLEAR`). (2) The rulings record is `.prawduct/owner-rulings.md`, the builder's proposal. The second ships to every consumer as \"commit that file\" in the change fragment's Consumer note. Renaming it after repos adopt it costs a migration, so put both to the owner in the PR or the hand-over asks, and record the answer in the plan's Goals.", "files": ["plugin/templates/owner-rulings.md", "plugin/methodology/building.md"], "fid": "R-7"}, {"goal": "Learnings Cross-Check", "severity": "warning", "title": "928-requirements row 39 still calls clear-reason a blocking gate, contradicting row 8 of the same table", "recommendation": "Class, with an existing enforcer. The change updated rows 4 and 8 of the host-contract table to \"observation (clear-reason, clear-verdict)\". Row 39 still reads \"the clear-reason gate and clear-verdict observation\", classifies the row \"gate\", and its remedy keys enabling it on a parsing test. Someone porting to Codex from this table would build a blocking clear-reason Stop gate that no longer exists. Core rule: \"A mechanism change is done when every artifact DESCRIBING it agrees: search for the claim, not the tokens you edited\". Fix row 39. Then add a `Retires:` declaration for \"the clear-reason gate\" and \"clear-reason Stop gate\" to the nonfunctional-requirements Direction entry that records the 2026-11-10 ruling. `retired-claim-survives` (lib/retired_claims.py) then owns every survivor, including backlog text, rather than the next sweep's attention. A query over the main tree turns up no other survivor in plugin/ or documentation/ outside CHANGELOG history.", "files": ["documentation/issues/928-requirements.md"], "fid": "R-8"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Mid-build decisions for the owner", "recommendation": "Scope: none. The plan records these mid-build decisions, each with what settled it. (1) Chunk 02: the delegate guard reuses `_check_ephemeral_worktree`, and a delegate sharing the coordinator's worktree stays undetected; settled by the plan's stop-rather-than-guess instruction, and the change fragment discloses it. (2) Chunk 02: \"always name the model at dispatch\", settled by the owner ruling of 2026-11-10; the reviewer cap is #1136. (3) Chunk 03: the rulings-record path is the builder's proposal (see the inference finding). (4) Chunk 03: the building.md size ceiling is raised, declared, rather than cutting the backwards-compatibility trap. (5) Chunk 04: the digest sentences were paid in place, and the builder's alignment paragraph was rejected for dropping owner-ratified text. Alignment-pass miss, recorded: the plan expected Chunk 01 to free more digest room than it did. The clear-reason demotion began as an inference and was ratified by the owner the same day. Goal 6 is clean: the clear-reason path now records through `_record_stop_observation`, which reports a failed append on stderr, and `stats` scores it under observed only.", "fid": "R-9"}, {"goal": "Backlog Reconciliation", "severity": "note", "title": "Backlog item appears resolved: #1131 session-continuity: the close is one line and ends with the ask", "recommendation": "Scope: none. Verify it, then call `/prawduct:backlog update 1131 status=shipped closed-by=scope:audit-guidance` when the backlog skill's \"When to mark shipped\" rule says.", "fid": "R-10"}, {"goal": "Backlog Reconciliation", "severity": "note", "title": "Backlog item appears resolved: #1133 methodology: delegation default, integrator option, no heavy tests", "recommendation": "Scope: none. Verify it, then call `/prawduct:backlog update 1133 status=shipped closed-by=scope:audit-guidance` when the backlog skill's \"When to mark shipped\" rule says.", "fid": "R-11"}, {"goal": "Backlog Reconciliation", "severity": "note", "title": "Backlog item appears resolved: #1135 methodology: requirements guidance for looked-at output and rulings", "recommendation": "Scope: none. Verify it, then call `/prawduct:backlog update 1135 status=shipped closed-by=scope:audit-guidance` when the backlog skill's \"When to mark shipped\" rule says. Close it only after deciding the rulings-record reader finding: a ruling that nothing reads is not yet un-lost.", "fid": "R-12"}, {"goal": "Backlog Reconciliation", "severity": "note", "title": "Backlog item appears resolved: #1044 governance: decide if clear-verdict and clear-reason earn their cost", "recommendation": "Scope: none. With clear-reason now recording instead of blocking, both checks the item asks about have been decided (non-blocking, still measured; owner ruling 2026-11-10 in nonfunctional-requirements.md). Verify that the item asked nothing beyond the blocking decision, then `/prawduct:backlog update 1044 status=shipped closed-by=scope:audit-guidance`, or narrow it to what remains.", "fid": "R-13"}, {"goal": "Backlog Reconciliation", "severity": "note", "title": "Open item in a touched area: #974 a product brief mixes agent inferences with owner lines", "recommendation": "Scope: none. C-B3: Chunk 03 adds labelling of agent-originated rules (discovery.md) and an owner-words record. This may partly answer #974. Assess the item and update its status or scope; no chunk touched it.", "fid": "R-14"}], "counts": {"blocking": 0, "warning": 5, "note": 9}, "observations": [], "duration_seconds": 420, "scope": "audit-guidance", "scope_chosen_by": "binding", "scope_unresolved_cause": null, "scope_reason": null, "base_extended_from": null, "chunks": ["01", "02", "03", "04"], "chunks_proposed": ["01", "02", "03", "04"], "chunk": "01", "base_reviewed": "c266262ea58e21dd760c4e6f552d75795c0602fc", "record_lint": {"records": [".prawduct/artifacts/build-plan-audit-guidance.md", ".prawduct/artifacts/digest-behavior-inventory.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/audit-guidance.md", ".prawduct/cross-cutting-concerns.md", "documentation/issues/928-requirements.md", "documentation/project-structure.md", "plugin/docs/discipline.md", "plugin/docs/governance-telemetry.md", "plugin/methodology/building.md", "plugin/methodology/delegation.md", "plugin/methodology/discovery.md", "plugin/methodol