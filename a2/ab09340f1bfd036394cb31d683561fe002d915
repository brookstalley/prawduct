{"schema": 1, "kind": "review", "id": "rev-20261113T183443Z-b74ff916", "ts": "2026-11-13T18:37:51Z", "actor": {"worktree": "prawduct", "plugin": "3.8.2-dev.1", "branch": "feature/native-review-inner", "build": "a2ab09340f1b+dirty"}, "body": {"base_commit": "a2ab09340f1bfd036394cb31d683561fe002d915", "base_tree": "c4550c07189f860f5fb30556bba2b0a2ce8e9766", "head_tree": "113d30f000037eb159e903691605ba1c997353b8", "head_commit": null, "dispatch_commit": "a2ab09340f1bfd036394cb31d683561fe002d915", "mode": "verify-resolutions (delta review, prior findings only)", "mode_chosen_by": "explicit-args", "stage": "inner", "tier": "escalate", "roster": [{"role": "reviewer", "model": "claude-opus-5-5"}], "files_reviewed": ["plugin/docs/governance-telemetry.md", "plugin/docs/project-state-keys.md", "plugin/lib/critic_consolidate.py", "plugin/lib/native_review.py", "plugin/skills/critic/review-cycle.md", "plugin/templates/project-state.yaml", "tests/test_native_review_compare.py", "tests/test_native_review_pairing.py", "plugin/lib/telemetry.py"], "files_changed": [".prawduct/artifacts/build-plan-native-review-inner.md", ".prawduct/research/native-review-paired/README.md", ".prawduct/research/native-review-paired/compare.py", "plugin/docs/governance-telemetry.md", "plugin/docs/project-state-keys.md", "plugin/lib/critic_consolidate.py", "plugin/lib/native_review.py", "plugin/lib/telemetry.py", "tests/test_native_review_compare.py", "tests/test_native_review_pairing.py"], "files_oracle": [".prawduct/artifacts/build-plan-native-review-inner.md", ".prawduct/research/native-review-paired/README.md", ".prawduct/research/native-review-paired/compare.py", ".prawduct/changes/native-review-inner.md", ".prawduct/owner-rulings.md"], "findings": [{"goal": "Nothing Is Unintended", "severity": "blocking", "title": "review-stats' native_review block changed its key set (by_stage) with no REPORT_SCHEMA_VERSION bump", "recommendation": "Instance, with a construction to close its class. The R-3 fix adds `by_stage` to `telemetry._native_block`, which changes the `--json` report's key set. `REPORT_SCHEMA_VERSION` stays at 13, and v13 predates this branch (30293de1 is an ancestor of the merge-base 11518166). That departs from the recorded `api_versioning_approach` decision: api-contract.md \u00a7 Versioning says the 'Telemetry report carries its own `schema_version`, bumped on any change to its key set ... so a cross-project aggregator can trust the shape'. governance-telemetry.md's `schema_version` row says the same thing ('bumped on any key change'). Precedent applies it to nested keys too: 3->4 (stat-block `observations`), 6->7 (`remedies`), 11->12 (`waived_inherited` in `by_outcome`). The plan's api-contract dispositions cover additive-first and whole-surface semver, but they record no decision to leave this report's version alone. Why it slipped: `TestJsonSchemaStability` pins only the top-level key list, so a nested key added under `native_review` is never seen. Fix: bump `REPORT_SCHEMA_VERSION` to 14, adding a history line beside the 12->13 one in telemetry.py and in the `test_top_level_keys_pinned` comment. Update both `== 13` pins in tests/test_review_stats.py (lines 623 and 897). Pin `native_review`'s own key list (`runs, duration_measured, countable_runs, findings, by_stage`) in `TestJsonSchemaStability` so the next nested add is caught. The alternative is to record a decision that nested additions under `native_review` take no bump; that is an owner call against a recorded decision.", "files": ["plugin/lib/telemetry.py", "plugin/docs/governance-telemetry.md"], "fid": "R-1"}], "counts": {"blocking": 1, "warning": 0, "note": 0}, "observations": [{"goal": "Nothing Is Unintended", "title": "tree_moved's exclusion is `.prawduct/` only, narrower than the RECORD_PREFIXES the finding named", "recommendation": "R-2 suggested excluding what consolidation and the builder's bookkeeping write during a review, citing `coverage_algebra.RECORD_PREFIXES`. That constant also covers `.claude/rules/learnings/`. The fix hard-codes `.prawduct/`. Learnings are written at work boundaries, which is often right after a Critic pass while the native run may still be going. So a reflection edit to a learnings file in the interval would read as a moved tree. The native review does read that file, so `true` is defensible. The docstring and governance-telemetry.md state the `.prawduct/` rule exactly. No edit is wanted unless a run is flagged this way in practice.", "about": {"review_id": "rev-20261113T182019Z-a4ff9ded", "fid": "R-2"}, "oid": "O-1"}], "duration_seconds": 420, "scope": "native-review-inner", "scope_chosen_by": "binding", "scope_unresolved_cause": null, "scope_reason": null, "base_extended_from": null, "chunks": ["01", "02", "03"], "chunks_proposed": ["01", "02", "03"], "chunk": "01", "base_reviewed": null, "record_lint": {"records": [".prawduct/artifacts/build-plan-native-review-inner.md", ".prawduct/research/native-review-paired/README.md", "plugin/docs/governance-telemetry.md", "plugin/docs/project-state-keys.md"], "chunk_graded": "01", "chunks_graded": ["01", "02", "03"], "plan_graded": ".prawduct/artifacts/build-plan-native-review-inner.md", "findings": [], "unchecked": [], "counts": {"chunk-ref-missing": 0, "governed-by-gap": 0, "suite-total-claim": 0, "learnings-over-budget": 0, "learnings-budget-unreasoned": 0, "learnings-core-raise-unapproved": 0, "learnings-rule-too-long": 0, "learnings-rule-body": 0, "learnings-area-dead": 0, "change-fragment": 0, "retired-claim-survives": 0}}, "span": null, "bounded_from": null, "span_reason": null, "dispatched_at": "2026-11-13T18:34:47Z"}}

