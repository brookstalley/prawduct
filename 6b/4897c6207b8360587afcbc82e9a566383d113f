{"schema": 1, "kind": "review", "id": "rev-20261116T002601Z-850e3ff3", "ts": "2026-11-16T00:33:02Z", "actor": {"worktree": "prawduct", "plugin": "3.8.2-dev.1", "branch": "integration/tech-debt-2026-11-15", "build": "6f3d232ffe46"}, "body": {"base_commit": "d35c88f5492e328fe974945d4071b20365c1574a", "base_tree": "252774bde2b36b05154b9714be855058b5ed3ba4", "head_tree": "951435fb02d0560c8b0b261b5e511e86a06d61e5", "head_commit": "6b4897c6207b8360587afcbc82e9a566383d113f", "dispatch_commit": "6b4897c6207b8360587afcbc82e9a566383d113f", "mode": "cumulative (bundle review, ready for merge)", "mode_chosen_by": "explicit-args", "stage": "boundary", "tier": "escalate", "roster": [{"role": "correctness", "model": "claude-opus-5-5"}, {"role": "design", "model": "claude-opus-5-5"}, {"role": "sustainability", "model": "claude-opus-5-5"}], "files_reviewed": [".gitignore", "documentation/issues/1098-requirements.md", "documentation/running-tests.md", "plugin/bin/prawduct-hook", "plugin/docs/doctor-vs-janitor.md", "plugin/docs/governance-telemetry.md", "plugin/docs/test-report-contract.md", "plugin/lib/briefing.py", "plugin/lib/core.py", "plugin/lib/coverage.py", "plugin/lib/critic_consolidate.py", "plugin/lib/critic_mode.py", "plugin/lib/dispositions.py", "plugin/lib/evidence.py", "plugin/lib/gates.py", "plugin/lib/gitignore_probes.py", "plugin/lib/host.py", "plugin/lib/init_product.py", "plugin/lib/native_review.py", "plugin/lib/record_progress.py", "plugin/lib/release_readiness.py", "plugin/lib/work_unit.py", "plugin/methodology/building.md", "plugin/skills/critic/SKILL.md", "plugin/skills/critic/review-cycle.md", "plugin/skills/doctor/SKILL.md", "plugin/skills/onboard/SKILL.md", "plugin/skills/pr/SKILL.md", "tests/fixtures/host_seam_golden/clear_brief_only.json", "tests/fixtures/host_seam_golden/clear_brief_only_config_home.json", "tests/fixtures/host_seam_golden/clear_session_start.json", "tests/preferences/test_test_location.py", "tests/test_briefing_branch_review.py", "tests/t