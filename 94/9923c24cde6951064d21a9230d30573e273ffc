{"schema": 1, "kind": "review", "id": "rev-20261126T071103Z-f0407da5", "ts": "2026-11-26T07:17:59Z", "actor": {"worktree": "prawduct", "plugin": "3.10.1-dev", "branch": "feature/boundary-review-per-release", "build": "73d562a10977"}, "body": {"base_commit": "73d562a10977dd4fdbd11939c7e9f8ac82ef9f2a", "base_tree": "0651b73d267b28694b96ee84139b3f6ba5c09003", "head_tree": "52e6cbe20a8f2a85ca383fb085df8df65e72d411", "head_commit": "949923c24cde6951064d21a9230d30573e273ffc", "dispatch_commit": "949923c24cde6951064d21a9230d30573e273ffc", "mode": "cumulative (bundle review, ready for merge)", "mode_chosen_by": "explicit-args", "stage": "boundary", "tier": "escalate", "roster": [{"role": "correctness", "model": "claude-opus-5-5"}, {"role": "design", "model": "claude-opus-5-5"}, {"role": "sustainability", "model": "claude-opus-5-5"}], "files_reviewed": ["documentation/release-process.md", "plugin/bin/prawduct-hook", "plugin/docs/governance-telemetry.md", "plugin/docs/project-state-keys.md", "plugin/lib/boundary_coverage.py", "plugin/lib/core.py", "plugin/lib/coverage.py", "plugin/lib/coverage_algebra.py", "plugin/lib/critic_consolidate.py", "plugin/lib/critic_mode.py", "plugin/lib/evidence.py", "plugin/lib/gates.py", "plugin/lib/pr_gate.py", "plugin/lib/release_readiness.py", "plugin/lib/review_lane.py", "plugin/lib/risk.py", "plugin/lib/telemetry.py", "plugin/methodology/planning.md", "plugin/skills/critic/SKILL.md", "plugin/skills/critic/review-cycle.md", "plugin/skills/critic/review-protocol.md", "plugin/skills/pr/SKILL.md", "plugin/templates/project-state.yaml", "tests/test_batch_review_rule.py", "tests/test_boundary_coverage.py", "tests/test_fix_tail_deferral.py", "tests/test_per_release_lane_inference.py", "tests/test_release_batch_review.py", "tests/test_release_gate.py", "tests/test_review_lane.py", "tests/test_review_stats.py", "tests/test_reviewer_payload_budget.py", "tests/test_v5_methodology.py"], "files_changed": [".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-boundary-review-per-release.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/boundary-review-per-release.md", ".prawduct/owner-rulings.md", ".prawduct/runbooks/cut-and-publish-a-plugin-release.md", "documentation/release-process.md", "plugin/bin/prawduct-hook", "plugin/docs/governance-telemetry.md", "plugin/docs/project-state-keys.md", "plugin/lib/boundary_coverage.py", "plugin/lib/core.py", "plugin/lib/coverage.py", "plugin/lib/coverage_algebra.py", "plugin/lib/critic_consolidate.py", "plugin/lib/critic_mode.py", "plugin/lib/evidence.py", "plugin/lib/gates.py", "plugin/lib/pr_gate.py", "plugin/lib/release_readiness.py", "plugin/lib/review_lane.py", "plugin/lib/risk.py", "plugin/lib/telemetry.py", "plugin/methodology/planning.md", "plugin/skills/critic/SKILL.md", "plugin/skills/critic/review-cycle.md", "plugin/skills/critic/review-protocol.md", "plugin/skills/pr/SKILL.md", "plugin/templates/project-state.yaml", "tests/test_batch_review_rule.py", "tests/test_boundary_coverage.py", "tests/test_fix_tail_deferral.py", "tests/test_per_release_lane_inference.py", "tests/test_release_batch_review.py", "tests/test_release_gate.py", "tests/test_review_lane.py", "tests/test_review_stats.py", "tests/test_reviewer_payload_budget.py", "tests/test_v5_methodology.py"], "files_oracle": [".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-boundary-review-per-release.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/boundary-review-per-release.md", ".prawduct/owner-rulings.md", ".prawduct/runbooks/cut-and-publish-a-plugin-release.md"], "findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "A release batch review whose subject is only since-anchor files is refused as no-review-needed or empty-diff, so the release gate's named remedy does not reach a pass", "recommendation": "Instance. Why it broke: 3d8b57ee adds the since-anchor subject files (back at the span start's content but different from the release anchor) to files_reviewed in begin_review's `release_files` block at critic_consolidate.py ~4990, but the generic interval guards at ~4814-4930 run first and read only `files_changed` (span start -> HEAD). Those guards are the `empty diff` error and the free-interval `no-review-needed` exit 3, whose safety argument is that it refuses only what the gate would already pass. Reachable state: a pre-anchor owed entry W moves the span start S back, and every judgeable change between S and HEAD has since been reverted on the base. For example, W's change was reverted after the anchor, and U reverted work G shipped between S and the anchor. Then W and U stay owed under M15, because they differ from the anchor. release_subject returns OK with judgeable files. But files_changed holds no judgeable file (only the release file, or nothing at all with a tag anchor), so critic-begin exits 3 ('no judgeable file ... the coverage gate already composes this interval as a free edge') or errors 'empty diff'. Meanwhile `check-boundary-coverage --gate` keeps exiting 1 and names this very review as the route out. The route out is then undocumented `--force` for the free-interval case, and nothing for the empty-diff case. Fix: for a release span, decide emptiness and judgeability over the subject (files_changed plus since_anchor) rather than files_changed alone, or apply the since-anchor augmentation before those guards. Add a fixture where every owed entry's files are back at the span start but differ from the anchor, with no other judgeable change in the interval, and assert that the dispatch succeeds and the batch rule then credits the entries. Gates rule applied: 'A message naming the caller's NEXT step must ask the gate that will judge that step'.", "files": ["plugin/lib/critic_consolidate.py", "tests/test_release_gate.py"], "scope": "instance", "closure": "The release-span dispatch's emptiness and free-interval checks read files_changed alone while its subject also includes since-anchor files.", "members": [{"id": "m1", "site": "plugin/lib/critic_consolidate.py begin_review: empty-diff and free-interval guards ahead of the release_files block"}], "fid": "R-1"}, {"goal": "Nothing Is Missing", "severity": "warning", "title": "The boundary_review key doc still says `--gate` exits 0 under per_pr, which round 5's exit-3 change made false; the plan's acceptance criterion requires every artifact describing the op to agree", "recommendation": "Class: descriptions of `check-boundary-coverage --gate`'s exit under per_pr. Why it broke: cde1b004 (native 5) made `release_gate` return 3, `boundary-unevaluable`, under per_pr when the report is unevaluable. It updated api-contract.md and the pr skill, but not plugin/docs/project-state-keys.md:495-496. That line still reads \"`--gate` exits 1 and 3 on the same verdict (0 under `per_pr`, where both stay advice)\". This file is where Chunk 06 put the opt-in audit, 'where a repo deciding to opt in reads it'. Chunk 06's acceptance criterion is 'every artifact that describes the op agrees (grep the claim, not the tokens)'. Fix: make the clause relational, e.g. 'under per_pr, 0 unless it could not evaluate (3, as the bare op)', the wording the change fragment's consumer note already uses. Search for the claim ('exits 0', 'under `per_pr`' near '--gate') rather than the edited tokens. The change fragment's 'What changed' paragraph (line ~133, 'under `per_pr` it exits 0') carries the same sentence. That file is an oracle, left to the Records Pass. Core rule applied: 'A mechanism change is done when every artifact DESCRIBING it agrees'.", "files": ["plugin/docs/project-state-keys.md"], "scope": "class", "closure": "Every shipped description of what `check-boundary-coverage --gate` exits with under per_pr.", "members": [{"id": "m1", "site": "plugin/docs/project-state-keys.md:495-496"}], "fid": "R-2"}, {"goal": "Instruction Clarity (framework check 8)", "severity": "warning", "title": "A release batch review's anchor-only subject files reach the reviewer with no instruction to rate them against the release anchor", "recommendation": "begin_review appends the files that are back at the span start's content but still differ from the release anchor (`since_anchor`) to `files_reviewed`. The only thing that says how to read them is a dispatch note ('rate each against the release anchor (`git diff <anchor> HEAD -- ...`)'). That note goes to critic-begin's stderr, and neither the manifest nor any reviewer-facing protocol carries it. `dispatch_directives` is set only when `reviewer_model` is set, coordinator.md never relays dispatch notes, and review-protocol.md's new `Span: release from <commit>` sentence only says the subject is 'work merged since that release no boundary review read'. A roster reviewer told to inspect the interval diff (base_commit..HEAD) sees an empty diff for each such file, rates nothing, and reports clean. The batch rule then credits the entry, because the file is in `files_reviewed`. That ships a change no reviewer read, which is exactly the hazard the 'reverted'/ships fix was written to close. Instance: put the anchor-relative subject in the manifest (for example a `files_since_anchor` list beside `span_reason`, or the rendered Signals line). Then make review-protocol.md's release-span sentence tell the reviewer to diff those files against the anchor commit. Pin it with a test that a release manifest carrying such a file also carries the instruction.", "files": ["plugin/lib/critic_consolidate.py", "plugin/skills/critic/review-protocol.md"], "scope": "instance", "closure": "A subject file of a release batch review whose interval diff is empty but which differs from the release anchor, with nothing in the manifest or the protocol telling the reviewer to read it against the anchor.", "fid": "R-3"}, {"goal": "Instruction Clarity (framework check 8)", "severity": "warning", "title": "The critic SKILL's exit-8 row contradicts the per-release lane's instruction to pass every chunk", "recommendation": "Under the lane, inference answers `chunk` over the whole branch, and its rationale says 'it must certify Chunk 01, Chunk 02: pass `--chunks 01,02`'. step 4 now says 'a `per-release lane` rationale names the set to pass instead'. If the fork omits it, critic-begin refuses with exit 8 (as `_lane_interval` documents). SKILL.md's exit-8 row then says 're-dispatch with stdout's `--chunks` line naming the chunk you built; **never pass both to get past it**'. A model following the table names one chunk and under-certifies the lane review. The other chunks stay open, and inference later asks for another review, which costs a round. The refusal's own stdout offers the all-chunks line, so the row is the outlier. Instance: amend the exit-8 row so that under a `per-release lane` rationale the `--chunks` set the rationale names is the answer, and keep 'never pass both' for an ordinary `chunk` review.", "files": ["plugin/skills/critic/SKILL.md"], "scope": "instance", "closure": "SKILL.md instructions for the `--chunks` choice on a `chunk` dispatch that disagree with what the per-release lane's rationale requires.", "fid": "R-4"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "release_subject re-derives the classifier's first-parent line, each owed entry's parents and its brought-on diff instead of reading them from the report", "recommendation": "`_Classifier.credit_reverted` computes owed, its first parents (`Entry.parents`, added for this purpose), the first-parent position map, `_span_start` over them and each entry's diff against its first parent. `_release_subject` then recomputes all of them through separate git calls: `rev-list --first-parent HEAD`, `rev-list --parents -n 1` per entry, `rev-parse <c>^{tree}`, and `diff --name-only` per entry. Those inputs must agree, or the batch review's subject or start omits something the gate holds the release for, and the release is held with no route out. This branch's later rounds were spent on exactly that agreement (the 'everywhere that is read' fix). `_changed_since_either` and `_span_start` gave the formulas one home, but their inputs are still gathered twice. Instance: have the Report carry the span start credit_reverted settled on, and each entry's first-parent judgeable files, beside `parents`. Then make `_release_subject` read `entry.parents` and those fields rather than re-asking git, so one computation answers both the gate and the dispatch.", "files": ["plugin/lib/boundary_coverage.py"], "scope": "instance", "closure": "Inputs to the release span start and subject that boundary_coverage computes in both credit_reverted and _release_subject.", "fid": "R-5"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "NFR 'Clarified' line credits the owner's R-4 ruling with two clauses the owner did not rule", "recommendation": "Records Pass, bar 'misleads into action'. The 2026-11-26 'Clarified' line beneath the stage-keyed clause in nonfunctional-requirements.md is attributed to 'owner ruling (round-4 R-4)'. The ruling it cites (owner-rulings.md, '2026-11-26 (round-4 review asks)', item 1) credits only an entry 'whose changes are all back to the release span's starting content (merged, then fully reverted)'. The NFR line also states two calls that M15 in the build plan records as the coordinator's, from round 5, and marks 'Veto-able'. The first is that a file must match BOTH the anchor and the span start, so 'a revert of work the last release shipped stays owed'. That one tightens the ruling. The second is that 'a merge that brought no judgeable change onto the base' is `reverted`. That one relaxes the release gate the ruling did not reach (round-5 W1). The norm record therefore names the owner as authority for an agent's relaxation. Two consequences follow. The owner reading the norm sees nothing left to veto, so M15's veto never gets asked. A later reviewer applying Normative authority to `reverted` reads both clauses as owner-ratified and will not flag a departure. core.md applies: 'A governance change cannot supply its own authority: when an agent amends a binding norm mid-build, land the owner's confirmation somewhere the amendment isn't'. Instance fix, either one: (a) attribute the two added clauses in the NFR line to M15 as inferred and veto-able, keeping R-4 as the authority for the start-content credit only; or (b) get the owner's confirmation of M15 into owner-rulings.md and cite that ruling.", "files": [".prawduct/artifacts/nonfunctional-requirements.md"], "scope": "instance", "closure": "A norm-record clause whose cited owner ruling does not contain it.", "members": [{"id": "m1", "site": ".prawduct/artifacts/nonfunctional-requirements.md stage-keyed clause, 'Clarified: 2026-11-26' line (anchor-and-start condition; no-judgeable-diff credit)"}], "fid": "R-6"}], "counts": {"blocking": 0, "warning": 6, "note": 0}, "observations": [{"goal": "Nothing Is Unintended", "title": "Under per_release, a plain cumulative on the integration base's tip with a dirty tree is now derived into the release span and refused as dirty-tree", "recommendation": "M11 justifies the derivation as 'the one state where a plain cumulative reviews nothing'. That holds on a clean tree only. With uncommitted work on the base (trunk-style work under per_release), the plain cumulative would have reviewed merge-base...working tree, and now refuses with release-dirty-tree. Failing this way is safe, and committing first leads to a release batch review that reads the commit as `direct`. If that is intended, the M11 record could say it covers the dirty-tree case too. No test pins the derived-dirty case.", "oid": "O-1"}, {"goal": "Nothing Is Broken", "title": "`_Classifier._shipping_at` returning None (anchor tree unreadable) silently skips every bracketing review", "recommendation": "This is the safe direction: no credit, and the entry stays owed. But the entry's reason then says nothing about why no review credited it, and no test exercises the path. Consider appending the git failure to the entry's reason, as the deferral path does with `deferral_why`.", "oid": "O-2"}, {"goal": "Everything Is Coherent", "title": "rule-unenforced: build-plan call ids and review finding ids in shipped comments (M15, R-4)", "recommendation": "boundary_coverage.py (module docstring, `_batch`, `_changed_since_either`, `_release_subject`), coverage_algebra.batch_review_covers and critic_consolidate.begin_review cite '(M15)' and 'R-4'. Those are plan-internal mid-build call ids and a review finding id. The rule is written: principles.md 'Durable artifacts are self-contained', and review-protocol.md 'Review and finding ids, chunk numbers and review history never belong in a shipped comment'. Precedent in the codebase (advisory_store's R-2, backlog/migrate's M6) shows the class recurs, and no record_lint CHECK or hook reads code comments for it. The 'owner ruling 2026-11-26' half of each citation already resolves through owner-rulings.md, so deleting the ids loses nothing. Mechanizing it would take a record_lint/determinism-style check over added lines in plugin/lib and plugin/bin matching `\\((M|R-)\\d+[,)]` and `Chunk \\d+`. As an instance this is prose and changes nothing anyone does, so no edit is owed for this review alone.", "files": ["plugin/lib/boundary_coverage.py", "plugin/lib/coverage_algebra.py", "plugin/lib/critic_consolidate.py"], "check": "rule-unenforced", "oid": "O-3"}, {"goal": "The Design Is Sound", "title": "A failed walk is modelled as a sentinel Entry rather than a Report field", "recommendation": "`_classify_pending` appends an `UNKNOWN` Entry with `source=SOURCE_WALK_FAILED` and no commit, and `count_line`, `release_gate`, `render` and `Entry.label` each detect it with `any(e.source == SOURCE_WALK_FAILED ...)`. It also counts as one `unknown` entry in `counts` and in the 'N of M' denominator, so `--json` consumers see a phantom entry. `no_anchor_reason` already shows the other shape: a `walk_failed` (or `walk_reason`) field on Report would let every reader ask one attribute. Two signals and localized, so borderline.", "files": ["plugin/lib/boundary_coverage.py"], "oid": "O-4"}, {"goal": "The Design Is Sound", "title": "branch_coverage_verdict's status set grows by string literal across four modules", "recommendation": "`deferred` joins `covered`/`transferred`/`blocked`/`uncovered` as bare strings read in gates, critic_mode._branch_already_covered, critic_consolidate.span_clause and pr_gate. Every reader was updated this time. But the docstring's 'a reader that does not know this status must not read it as covered' has no enforcer. Named constants (or a COVERING/PASSING frozenset owned by gates) would make the next status addition one edit.", "files": ["plugin/lib/gates.py", "plugin/lib/critic_mode.py", "plugin/lib/critic_consolidate.py"], "oid": "O-5"}, {"goal": "The Design Is Sound", "title": "New private cross-module reach-ins", "recommendation": "review_lane reads `coverage._state_in` and `coverage._resolve_base_branch`, boundary_coverage reads `release_verification._read_declaration`, and critic_mode reads `risk._review_scope_paths` (with a new `renames=` parameter) and `gitstate._git_head_sha`. This follows the codebase's existing pattern (gates._cached_diff_fn and others), so it is no departure. `_state_in` is now a policy reader's dependency in three places, and is a candidate for a public name.", "files": ["plugin/lib/review_lane.py", "plugin/lib/boundary_coverage.py", "plugin/lib/critic_mode.py"], "oid": "O-6"}, {"goal": "The Design Is Sound", "title": "test_release_batch_review copies test_boundary_coverage's git/fact helpers", "recommendation": "`_git`, `_write`, `_commit`, `_tree`, `_fragment`, `_review` (extended with `reviewed`/`extra`), `_branch`, `_merge` and `_cut` are near-identical copies. Sibling files here already import helpers across test modules (test_release_gate imports from test_release_batch_review), so importing them from test_boundary_coverage and extending `_review` there would keep one fixture shape.", "files": ["tests/test_release_batch_review.py", "tests/test_boundary_coverage.py"], "oid": "O-7"}, {"goal": "Everything Is Coherent", "title": "Two small wording drifts in the per_release prose", "recommendation": "project-state-keys.md says eligible plans have 'none declaring `Critic mode:` or `Type: cumulative-final`', but `declares_boundary_cumulative` reads only the last chunk. review-protocol.md's 'on `Span: release from <commit>`, work merged since that release' names a commit that `signals_line` renders from `base_commit`. That is the span start, which can be an owed entry's first parent before the anchor rather than the release. Neither changes what a reader does in practice, so no edit is wanted.", "files": ["plugin/docs/project-state-keys.md", "plugin/skills/critic/review-protocol.md"], "oid": "O-8"}, {"goal": "Decisions Were Deliberate", "title": "Fourteen mid-build calls reach the merge boundary inferred and unconfirmed, several of them release-gate relaxations", "recommendation": "The plan's Governance Checkpoints ask this cumulative to check 'each inferred call'. Each one carries a recorded why and is marked veto-able, which is what the Authority Rule requires, so this is not a finding. Only M2 was put to the owner and confirmed; M12 was retired by an owner ruling. Still owner-unseen: M1, M3-M11 and M13-M16, together with the six 'Inferred design calls'. Among them are relaxations of the gate a per_release consumer will rely on: M5 (octopus, unrelated-history and undiffable merges credited by the batch rule), M6 (a squash merge read batch-covered), M8 (a Stop-gate transfer grant accepted where the owner's 2026-11-26 item 4 named the PR gate's) and M15's no-judgeable-diff credit. Merging closes the veto window the plan opened. Batching them into one confirm-or-correct ask before the PR merges would settle them.", "files": [".prawduct/artifacts/build-plan-boundary-review-per-release.md"], "oid": "O-9"}, {"goal": "Decisions Were Deliberate", "title": "Plan Level stays Medium after one of its two named raisers has happened", "recommendation": "Goals' 'Level: Medium' says the consumer repo's per-merge counts (decision 6) would raise it. Those counts were taken and ruled 'go' on 2026-11-26, and the Level was not revisited. Nothing reads the Level and no edit is wanted. It is stated so the record's confidence is not misread.", "files": [".prawduct/artifacts/build-plan-boundary-review-per-release.md"], "oid": "O-10"}, {"goal": "Decisions Were Deliberate", "title": "Plan narration superseded by its own later decisions", "recommendation": "Several passages describe the mechanism before later decisions changed it. 'Tradeoffs accepted' says 'Anchor B picks up any version-shaped tag reachable from the base', which M10 (prerelease tags never anchor) and the 2026-11-26 merge-base amendment both supersede. Chunk 02's description still says 'the newest version tag reachable from the base', and Chunk 03's says the subject is files 'that still differ from the anchor', where M15 makes it 'from the start or the anchor'. All of these chunks are built and none of the text instructs future work, so it clears no Records Pass bar. Noted only.", "files": [".prawduct/artifacts/build-plan-boundary-review-per-release.md"], "oid": "O-11"}, {"goal": "Decisions Were Deliberate", "title": "Template drops the learnings-budget sentence to pay for the new key's hint", "recommendation": "plugin/templates/project-state.yaml cuts 'every rule is one line; core.md is capped and only the owner raises it' while adding the `boundary_review` hint. That is consistent with the learnings rule 'Pay a prose size ceiling in place: cut a class another file owns': record-lint's learnings-* checks and core.md own the cap. The template is place-once, so only new repos lose the hint. No edit wanted.", "files": ["plugin/templates/project-state.yaml"], "oid": "O-12"}], "duration_seconds": 780, "scope": "boundary-review-per-release", "scope_chosen_by": "binding", "scope_unresolved_cause": null, "scope_reason": null, "base_extended_from": null, "chunks": [], "chunks_proposed": [], "chunks_declared": false, "chunks_evidence": {}, "base_reviewed": "73d562a10977dd4fdbd11939c7e9f8ac82ef9f2a", "record_lint": {"records": [".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-boundary-review-per-release.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/boundary-review-per-release.md", ".prawduct/owner-rulings.md", ".prawduct/runbooks/cut-and-publish-a-plugin-release.md", "documentation/release-process.md", "plugin/docs/governance-telemetry.md", "plugin/docs/project-state-keys.md", "plugin/methodology/planning.md", "plugin/skills/critic/SKILL.md", "plugin/skills/critic/review-cycle.md", "plugin/skills/critic/review-protocol.md", "plugin/skills/pr/SKILL.md"], "chunk_graded": null, "chunks_graded": [], "plan_graded": null, "findings": [], "unchecked": [], "counts": {"chunk-ref-missing": null, "governed-by-gap": 0, "suite-total-claim": 0, "learnings-over-budget": 0, "learnings-budget-unreasoned": 0, "learnings-core-raise-unapproved": 0, "learnings-rule-too-long": 0, "learnings-rule-body": 0, "learnings-area-dead": 0, "change-fragment": 0, "retired-claim-survives": 0, "late-requirement-record": 0, "test-scope-conftest": 0, "test-scope-autouse": 0, "test-scope-init": 0, "test-clock-fake": 0, "test-clock-import": 0}}, "span": "full", "bounded_from": null, "span_reason": "base-moved", "dispatched_at": "2026-11-26T07:11:11Z"}}
