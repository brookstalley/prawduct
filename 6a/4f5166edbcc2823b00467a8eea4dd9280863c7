{"schema": 1, "kind": "review", "id": "rev-20261111T205745Z-3349874a", "ts": "2026-11-11T20:58:49Z", "actor": {"worktree": "prawduct", "plugin": "3.8.2-dev", "branch": "fix/import-status-remove-block", "build": "6a4f5166edbc"}, "body": {"base_commit": "6a4f5166edbcc2823b00467a8eea4dd9280863c7", "base_tree": "060e018ba551b6eb1e6c730a547ac57032e22c9b", "head_tree": "3541f57d432f41240d0ba4aeec8a0424c8f53c7a", "head_commit": null, "dispatch_commit": "6a4f5166edbcc2823b00467a8eea4dd9280863c7", "mode": "final (full review, ready for push)", "mode_chosen_by": "explicit-args", "stage": "inner", "tier": "escalate", "roster": [{"role": "correctness", "model": "claude-opus-5-5"}, {"role": "design", "model": "claude-opus-5-5"}, {"role": "sustainability", "model": "claude-opus-5-5"}], "files_reviewed": ["plugin/bin/prawduct-hook", "tests/test_plan_import_status.py"], "files_changed": [".prawduct/changes/import-status-remove-block.md", "plugin/bin/prawduct-hook", "tests/test_plan_import_status.py"], "files_oracle": [".prawduct/changes/import-status-remove-block.md"], "findings": [], "counts": {"blocking": 0, "warning": 0, "note": 0}, "observations": [{"goal": "Nothing Is Missing", "title": "Setext-style headings inside the Status span are not detected by the new heading refusal", "recommendation": "The new check recognizes only ATX headings (1-6 '#' then whitespace or end of line). A setext heading (a text line underlined with '===' or '---') inside the span is neither a reader bound nor a refusal, so its section would still be deleted with the block. This is rare in build plans and the ATX case is the one #1137 reported. If you want the writer's 'claims nothing it cannot delimit' rule to cover it too, refuse on a '===' or '---' line that directly follows a non-blank content line. Smaller point: an indented '    # x' line (an indented code block) now refuses. That over-refusal is safe and needs no change.", "files": ["plugin/bin/prawduct-hook"], "oid": "O-1"}, {"goal": "The Design Is Sound", "title": "The heading test reads a stripped line, so an indented code line beginning '# ' inside the Status block is refused as 'a heading'", "recommendation": "No edit wanted. The refusal fails safe: nothing is written and the remedy (add a `## ` heading or remove the block by hand) still works. The only cost is wording, because an indented shell comment would be reported as 'a heading at line N'. If it ever matters, test the unstripped line for a leading run of 0-3 spaces, as CommonMark ATX headings require. That is an instance, not a class.", "files": ["plugin/bin/prawduct-hook"], "oid": "O-2"}], "duration_seconds": 240, "scope": null, "scope_chosen_by": "none", "scope_unresolved_cause": "unbound", "scope_reason": "no live plan claims `fix/import-status-remove-block`", "base_extended_from": null, "chunks": [], "chunks_proposed": [], "chunk": null, "base_reviewed": null, "record_lint": {"records": [".prawduct/changes/import-status-remove-block.md"], "chunk_graded": null, "chunks_graded": [], "plan_graded": null, "findings": [], "unchecked": [], "counts": {"chunk-ref-missing": null, "governed-by-gap": 0, "suite-total-claim": 0, "learnings-over-budget": 0, "learnings-budget-unreasoned": 0, "learnings-core-raise-unapproved": 0, "learnings-rule-too-long": 0, "learnings-rule-body": 0, "learnings-area-dead": 0, "change-fragment": 0, "retired-claim-survives": 0}}, "dispatched_at": "2026-11-11T20:57:51Z"}}
