_consumer_overhead.py", "tests/test_norm_index_scaffold.py", "tests/test_plugin_manifest.py", "tests/test_plugin_runtime.py", "tests/test_pr_review_payload.py", "tests/test_pr_reviewer.py", "tests/test_pytest_config.py", "tests/test_python_floor.py", "tests/test_record_lint.py", "tests/test_release_verification.py", "tests/test_repo_disable.py", "tests/test_retired_hook_subcommands.py", "tests/test_review_interval_extension.py", "tests/test_review_stats.py", "tests/test_session_critic_gate.py", "tests/test_short_plan_deferral.py", "tests/test_stop_abandoned_critic.py", "tests/test_subagent_stop.py"], "files_oracle": [".prawduct/artifacts/build-plan-python-floor.md", ".prawduct/changes/python-floor.md", ".prawduct/project-state.yaml"], "findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "The enforced floor (_python_floor.FLOOR) is an unpinned copy of requires-python", "recommendation": "tests.yml calls `requires-python` 'the fact', and test_ci_workflow_conventions.py keeps the CI matrix in step with it. The value that actually gates execution, `FLOOR = (3, 14)` in plugin/bin/_python_floor.py, has no such test, and neither does verify-release.yml's `python-version: \"3.14\"`. The literal '3.14' assertions in test_python_floor.py pin today's number, not agreement with pyproject. Who gets hurt: someone raises requires-python, which this change explicitly invites by allowing newer features in lib/ afterwards. CI stays green, and on a machine whose python3 sits between the old and new floor, the check passes and lib/ then fails on import. That is the silent hook crash this module exists to prevent. Fix: add an assertion that `_python_floor.FLOOR` equals the parsed requires-python floor, and that verify-release.yml's setup-python version equals it too, in test_ci_workflow_conventions.py or test_python_floor.py.", "files": ["plugin/bin/_python_floor.py", ".github/workflows/verify-release.yml", "tests/test_python_floor.py", "tests/preferences/test_ci_workflow_conventions.py"], "fid": "R-1"}, {"goal": "Nothing Is Broken", "severity": "warning", "title": "The old-interpreter parse guard is only proven against `match`; ast feature_version is best-effort", "recommendation": "Rule: 'A check never seen to return non-zero proves nothing'. `test_the_parser_check_can_fail` feeds `ast.parse(..., feature_version=(3, 9))` only a `match` statement. The Python docs call feature_version 'best-effort' and do not promise it rejects all newer grammar. The newer syntax a developer on a 3.14-only suite is most likely to write is PEP 701 nested-quote f-strings (3.12), PEP 758 unparenthesized `except A, B:` (3.14) and PEP 695 `type` statements, and none of those has a control. If any of them parses, this test passes while the file raises SyntaxError at compile time on macOS's 3.9 python3, before ensure() can run. Only prawduct-hook is ever compiled by a real older interpreter, in TestOnARealOlderInterpreter, and that test skips where none exists. banner.py, digest.py and test-reference-verify never are, and CI now has a single 3.14 leg. Fix: add positive controls for those three constructs. For any construct feature_version does not reject, back the AST check with a real compile of all four entry points under the older python3 that `_older_python3()` already finds (`-m py_compile`), using the same skip-with-reason.", "files": ["tests/test_python_floor.py", "plugin/hooks/banner.py", "plugin/hooks/digest.py", "plugin/bin/test-reference-verify"], "fid": "R-2"}, {"goal": "Nothing Is Broken", "severity": "note", "title": "Rewritten release-verification test dropped two assertions, and the branch it was written for is now unreachable", "recommendation": "test_a_blocked_file_does_not_swallow_a_disagreement_beside_it now uses a declared layout. That takes the early `FAILED` return (failures dominate), so the test no longer asserts that the unreadable file is reported or that 'did agree' is absent. The plan records the change from UNVERIFIABLE to FAILED but not the dropped assertions. Underneath that: with `tomllib` always present, the undeclared fallback layout (bare, json, toml, each with a key) can never produce `blocked`. In declared mode, any problem returns FAILED before the merge. So the `[*blocked, *problems]` merge in check_version_files, with both lists non-empty, is now dead, along with the comment that justifies it. Either say so in the plan's decision, or simplify the branch (design's call). Separately, a blank line is missing between this test and the next `def` (tests/test_release_verification.py ~L475).", "files": ["tests/test_release_verification.py", "plugin/lib/release_verification.py"], "fid": "R-3"}, {"goal": "Nothing Is Broken", "severity": "note", "title": "Bare `python3` hook launches remain in tests the sweep did not reach", "recommendation": "tests/test_critic_consolidate.py (about 11 launches, e.g. L106, L162, L178, L3624) and tests/scenarios (kernel_v3_harness.py:36, test_kernel_v3_upgrade.py:96) still start prawduct-hook with a bare \"python3\". They pass today because PATH resolves python3 to 3.14, or because the floor re-executes the hook. They are not broken. They are the one place the suite depends on the machine's python3, and the plan's mid-build decision says those launches 'now use sys.executable'. Convert them for consistency, or narrow the plan's sentence to the stripped-PATH launches it actually changed. No suite red is expected either way.", "files": ["tests/test_critic_consolidate.py"], "fid": "R-4"}, {"goal": "Nothing Is Broken", "severity": "note", "title": "Re-exec records \"unknown\" as the origin interpreter when sys.executable is empty", "recommendation": "ensure() sets `env[REEXEC_ENV] = executable or \"unknown\"`. `_fallback_pytest_python()` then returns \"unknown\", and the undeclared-suite fallback tries to exec a program named `unknown` instead of falling back to sys.executable. The case is rare (embedded or odd launchers leave sys.executable empty) and untested. Fix: set a sentinel that `_fallback_pytest_python` and `cmd_python_floor` treat as 'origin not known', or skip the fallback substitution when the origin is not an existing path.", "files": ["plugin/bin/_python_floor.py", "plugin/bin/prawduct-hook"], "fid": "R-5"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "Floor sweep missed restatements of the old floor (ruff target, preferences row, core.py rationale)", "recommendation": "Class. Chunk 02 promised that every surface stating the floor would agree, but the sweep searched for the tokens it edited, not for the claim. Three places still state the old floor. (1) pyproject.toml `[tool.ruff] target-version = \"py310\"`. This is in the same file whose `requires-python` was raised. Ruff lints against 3.10, so it will flag the 3.11+ syntax the plan says lib/ may now use. Fix: set it to py314, or delete it so ruff infers the target from requires-python. (2) .prawduct/artifacts/project-preferences.md `**Version**: 3.10+`. Every session is told to read this row before writing code, and a builder who obeys it keeps avoiding 3.11+ stdlib such as tomllib. Fix: update the row and cite the owner's 2026-10-27 ruling from the plan. (3) plugin/lib/core.py:179. Its comment justifies `open` over `write_text(newline=...)` by saying the hook runs under whatever `python3` PATH resolves, which is 3.9.6 on stock macOS. The floor check now makes that false. This is prose, so delete the rationale. Per core learning \"A mechanism change is done when every artifact DESCRIBING it agrees: search for the claim, not the tokens you edited\", search for the claim (`3.10`, `py310`, `3.9`, `whatever python3`) across plugin/, .prawduct/artifacts/ and pyproject.toml. Expect more members outside the diff.", "files": ["pyproject.toml", ".prawduct/artifacts/project-preferences.md", "plugin/lib/core.py"], "fid": "R-6"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "The floor value has unpinned copies; only the CI matrix is checked against requires-python", "recommendation": "Class. The fix is to build the check, not to add a step to a list. The test_ci_workflow_conventions module calls pyproject's requires-python \"the fact\" and pins the tests.yml matrix to it. Three more copies of the same fact are pinned by nothing: `_python_floor.FLOOR = (3, 14)`, verify-release.yml `python-version: \"3.14\"` (whose comment calls it \"the floor\"), and the literal `3.14` in doctor Check 26. Raising the floor again moves pyproject and the matrix together, because the test forces it, while FLOOR stays put. Entry points would then accept an interpreter that lib/ no longer parses on, so the hooks crash as non-blocking errors. That is the silent un-governance this module exists to prevent. The plugin tree does not ship pyproject.toml, so FLOOR has to stay a copy. Fix: in tests/preferences/test_ci_workflow_conventions.py, assert `_python_floor.FLOOR` and verify-release's setup-python version (plus ruff's target-version, if kept) all equal the requires-python floor. Then make the doctor prose relational (\"resolve to the floor `python-floor` names\") rather than a literal. This applies core learning \"A rule you must RECALL at the right moment is its weakest form \u2014 if it governs a queryable claim, mechanise it\".", "files": ["plugin/bin/_python_floor.py", ".github/workflows/verify-release.yml", "plugin/skills/doctor/SKILL.md", "tests/preferences/test_ci_workflow_conventions.py"], "fid": "R-7"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "Doctor Check 26 says 'report broken', but the Classify section's broken class routes to /prawduct:migrate", "recommendation": "Instance (Framework Check 9, cross-section consistency). On the `ERROR: prawduct needs Python ...` line, Check 26 says to report **broken** and relay the install line. The Classify section defines **broken** only as \"no install reference, or file-sync residue still committed\", with the remedy \"recommend `/prawduct:migrate` (or installing the plugin first)\". A model following the class definition attaches the migrate remedy to a missing interpreter, or reports something the broken definition does not admit. The #19 `inactive` case is handled by a carve-out sentence in the broken line; give this case the same treatment. Add the no-qualifying-interpreter case to the broken definition with its own remedy (install the floor Python and restart Claude Code), so the two sections agree.", "files": ["plugin/skills/doctor/SKILL.md"], "fid": "R-8"}, {"goal": "The Design Is Sound", "severity": "note", "title": "role_of hard-codes hooks.json wiring and nothing pins the two together", "recommendation": "Instance. `_python_floor.role_of` decides how a failure surfaces from entry-point names and subcommands (`banner.py`, `digest.py`, `clear`, `stop`, `subagent-stop`), which repeats what hooks.json declares. The role tests hand it literal argv, not hooks.json's commands. A hook added to hooks.json silently falls into the `cli` role. The default is benign today (exit 1 never blocks), so this is a NOTE. If it is worth closing, add one test that walks hooks.json's SessionStart/Stop/SubagentStop commands and asserts each event's expected role.", "files": ["plugin/bin/_python_floor.py"], "fid": "R-9"}, {"goal": "The System Can Be Understood", "severity": "warning", "title": "The `pyenv install 3.14` remedy does not fix the case it is shown for, and the error hides the candidate it rejected", "recommendation": "Class: a remedy that is not tested against the predicate that produced the condition. Rule cited: 'A REMEDY named in a checklist must be tested against the predicate that produced the condition'. `_python_floor._named_candidates`' docstring says a pyenv shim named `python3.14` fails when the version selected for the directory does not provide it. That is the typical below-floor repo: a `.python-version` pinning an older Python, the population the plan counts as about 20 of 33 repos. In that repo `pyenv install 3.14` creates exactly that failing shim. Unless Homebrew or a uv-managed interpreter happens to be on PATH, discovery still finds nothing. `fail()` then reports 'the hooks found only Python 3.x and no python3.14' while `which python3.14` shows one, and repeats the same pyenv hint. The user follows the remedy, governance stays off, and the message cannot explain why. The same hint ships in `_INSTALL_HINT` and in the change record's consumer note (Records Pass, 'misleads into action'). Close it once, through the owner of the hint and of discovery, `plugin/bin/_python_floor.py`. Either make discovery find what the remedy installs (probe `$(pyenv root)/versions/3.1[4-9]*/bin/python3`, or `PYENV_VERSION=3.14 python3.14`), or drop the pyenv remedy and say what it actually takes. Either way, name a rejected candidate in the `ERROR:` and banner text, so 'found only X' is not contradicted by what `which` shows. Then make the consumer note agree.", "files": ["plugin/bin/_python_floor.py", ".prawduct/changes/python-floor.md"], "fid": "R-10"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Mid-build decisions for the python-floor plan", "recommendation": "Scope: none, for the owner. Decisions and what settled each: (1) The pytest fallback runs under the invoked interpreter carried in PRAWDUCT_PYTHON_REEXEC. Settled by the fallback's 'shares the project's environment' contract; the plan's Inference still says the variable is set to `1`, superseded in its own decision list. (2) 49 test launches moved from bare `python3` to `sys.executable`. Settled by the floor; which interpreter runs is now test_python_floor's subject. (3) Per-line E402 waivers in banner.py/digest.py. (4) The tomllib fallback was removed with its tests, and one test re-subjected to an unknown format. (5) This repo's local suite command became `uv run --extra dev python -m pytest`. (6) The doctor check is a new read-only `python-floor` subcommand. (7) Fail-open on a missing sibling `_python_floor`, settled by the hook-surface rule 'Code in `prawduct-hook` `main()` that runs BEFORE command dispatch must fail open'. Alignment pass: Proceed, citing #1097 and the owner's 2026-10-27 ruling. I found no miss.", "files": [".prawduct/artifacts/build-plan-python-floor.md"], "fid": "R-11"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "The version tier is still an inference awaiting the owner: a minor release that turns governance off on machines without 3.14", "recommendation": "Scope: none. This is a real fork, flagged for this boundary. The plan ships this inside 3.8.0 as a minor, reasoning that a machine with any 3.14 keeps working. A consumer machine without one loses every gate at the next plugin update, and the only warning is the session banner. Get the owner's explicit confirm-or-correct on minor vs major before the release cut, and record it in the plan beside the inference.", "files": [".prawduct/artifacts/build-plan-python-floor.md"], "fid": "R-12"}, {"goal": "The System Can Be Understood", "severity": "note", "title": "Two surfaces still describe the pre-3.14 interpreter world", "recommendation": "Instance; both are inert, and no edit is wanted beyond deleting the claim when next touched. Rule cited: 'A mechanism change is done when every artifact DESCRIBING it agrees'. The comment at `plugin/lib/core.py:179-181` says the hook 'runs under whatever `python3` a product's PATH resolves to \u2014 3.9.6 on a stock macOS'. Since the floor check that is false, and the comment justifies avoiding an API the floor now guarantees. `pyproject.toml` `[tool.ruff] target-version = \"py310\"` lags `requires-python = \">=3.14\"`. Nothing gates ruff yet, per that file's own comment, so nothing reads it. Search: `git grep -nE '3\\.9|whatever .?python3|py31[0-3]'`. Neither file was in the plan's sweep.", "files": ["pyproject.toml", "plugin/lib/core.py"], "fid": "R-13"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Backlog item appears resolved: #1097 runtime: raise the Python floor and have hooks find a qualifying python", "recommendation": "Scope: none. Backlog item appears resolved: brookstalley/prawduct#1097 'runtime: raise the Python floor and have hooks find a qualifying python' (open, stage design). Verify it, then call `/prawduct:backlog update brookstalley/prawduct#1097 status=shipped closed-by=scope:python-floor` when the backlog skill's 'When to mark shipped' rule says. `affecting` over the changed non-test files also returned #757 (suite nondeterminism under xdist), which this work does not resolve. The store was about 1.8h old at query time (synced 2026-10-27T13:05Z), with no sync_error.", "fid": "R-14"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Learnings Cross-Check: read set, no regression, no rules added this cycle", "recommendation": "Scope: none. Read the files `learnings-files --for-diff` lists: core.md, authoring.md, gates.md, hook-surface.md, release.md, tests.md. The diff conforms to hook-surface 'Code in `prawduct-hook` `main()` that runs BEFORE command dispatch must fail open on a `lib/` ImportError' (the floor import fails open), and to release 'A change-log entry's BODY must cover every chunk it shipped'. The change record covers Chunks 01 and 02. The one regression of a warned-against pattern is the authoring remedy rule, already carried at its own severity by the pyenv-hint finding. No learnings rule was added or changed in this diff, so the supersession and new-rule passes have nothing to rate.", "fid": "R-15"}], "counts": {"blocking": 0, "warning": 6, "note": 9}, "observations": [], "duration_seconds": 600, "scope": "python-floor", "scope_chosen_by": "binding", "scope_unresolved_cause": null, "scope_reason": null, "base_extended_from": null, "chunks": ["01", "02", "03"], "chunks_proposed": ["01", "02", "03"], "chunk": "01", "base_reviewed": "7c4fb9ff8a461cd0fce5f483b08360e1274892c7", "record_lin