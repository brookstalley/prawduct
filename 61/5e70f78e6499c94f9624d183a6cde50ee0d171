{"schema": 1, "kind": "review", "id": "rev-20261126T062450Z-967b1908", "ts": "2026-11-26T06:34:32Z", "actor": {"worktree": "prawduct", "plugin": "3.10.1-dev", "branch": "feature/boundary-review-per-release", "build": "73d562a10977"}, "body": {"base_commit": "05a1dceb997d0a861f951c64bc721e9939b3d6e8", "base_tree": "e0ff9a692c92b44674b96f9c8bc8f6045a4f4e05", "head_tree": "207061ff09e1208a5ac1cf99dbda8b284fc32404", "head_commit": "615e70f78e6499c94f9624d183a6cde50ee0d171", "dispatch_commit": "615e70f78e6499c94f9624d183a6cde50ee0d171", "mode": "cumulative (bundle review, ready for merge)", "mode_chosen_by": "explicit-args", "stage": "boundary", "tier": "escalate", "roster": [{"role": "correctness", "model": "claude-opus-5-5"}, {"role": "design", "model": "claude-opus-5-5"}, {"role": "sustainability", "model": "claude-opus-5-5"}], "files_reviewed": ["documentation/release-process.md", "plugin/bin/prawduct-hook", "plugin/docs/governance-telemetry.md", "plugin/docs/project-state-keys.md", "plugin/lib/boundary_coverage.py", "plugin/lib/core.py", "plugin/lib/coverage.py", "plugin/lib/coverage_algebra.py", "plugin/lib/critic_consolidate.py", "plugin/lib/critic_mode.py", "plugin/lib/gates.py", "plugin/lib/pr_gate.py", "plugin/lib/release_readiness.py", "plugin/lib/review_lane.py", "plugin/lib/risk.py", "plugin/lib/telemetry.py", "plugin/methodology/planning.md", "plugin/skills/critic/SKILL.md", "plugin/skills/critic/review-cycle.md", "plugin/skills/critic/review-protocol.md", "plugin/skills/pr/SKILL.md", "plugin/templates/project-state.yaml", "tests/test_batch_review_rule.py", "tests/test_boundary_coverage.py", "tests/test_fix_tail_deferral.py", "tests/test_per_release_lane_inference.py", "tests/test_release_batch_review.py", "tests/test_release_gate.py", "tests/test_review_lane.py", "tests/test_review_stats.py", "tests/test_reviewer_payload_budget.py", "tests/test_v5_methodology.py"], "files_changed": [".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-boundary-review-per-release.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/boundary-review-per-release.md", ".prawduct/owner-rulings.md", ".prawduct/runbooks/cut-and-publish-a-plugin-release.md", "documentation/release-process.md", "plugin/bin/prawduct-hook", "plugin/docs/governance-telemetry.md", "plugin/docs/project-state-keys.md", "plugin/lib/boundary_coverage.py", "plugin/lib/core.py", "plugin/lib/coverage.py", "plugin/lib/coverage_algebra.py", "plugin/lib/critic_consolidate.py", "plugin/lib/critic_mode.py", "plugin/lib/gates.py", "plugin/lib/pr_gate.py", "plugin/lib/release_readiness.py", "plugin/lib/review_lane.py", "plugin/lib/risk.py", "plugin/lib/telemetry.py", "plugin/methodology/planning.md", "plugin/skills/critic/SKILL.md", "plugin/skills/critic/review-cycle.md", "plugin/skills/critic/review-protocol.md", "plugin/skills/pr/SKILL.md", "plugin/templates/project-state.yaml", "tests/test_batch_review_rule.py", "tests/test_boundary_coverage.py", "tests/test_fix_tail_deferral.py", "tests/test_per_release_lane_inference.py", "tests/test_release_batch_review.py", "tests/test_release_gate.py", "tests/test_review_lane.py", "tests/test_review_stats.py", "tests/test_reviewer_payload_budget.py", "tests/test_v5_methodology.py"], "files_oracle": [".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-boundary-review-per-release.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/boundary-review-per-release.md", ".prawduct/owner-rulings.md", ".prawduct/runbooks/cut-and-publish-a-plugin-release.md"], "findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "An owed release entry that brought no judgeable change onto the base holds a per_release release with a remedy that refuses (no-subject)", "recommendation": "Why it broke: `_Classifier.credit_reverted` skips an entry on `if not files`, which treats a READ, EMPTY judgeable first-parent diff the same as an unread one (None). The case is reachable only through the fragment join, because the walk lists only commits with a judgeable first-parent change. Example: a merge whose branch changed judgeable files against its merge-base, all of them already identical on the base (the same fix cherry-picked or landed by a separate boundary-reviewed PR). `_classify_shape` reads it `inner-only` or `uncovered` from the branch's merge-base diff. `_batch` can credit it (`batch_review_covers` with `entry_files=[]` reads covered), but only when some boundary review brackets it. When it is the only owed entry, nothing does: `release_gate` exits 1 (`boundary-uncovered:`) and names the release batch review as the route, and `release_subject` then refuses `no-subject`, because the merge's first-parent diff holds only non-judgeable paths (its fragment). The remedy never terminates. The only ways out are flipping the integration branch to `per_pr` or bypassing the release check, which is the shape the R-4 ruling (`test_when_what_was_owed_is_reverted_nothing_is_owed`) set out to end. Scope: instance. Fix it in `credit_reverted` by crediting an entry whose judgeable first-parent diff was read and is `[]` (distinguish `files is None` from `files == []`): nothing it brought ships, which is R-4's own reasoning. Pin it with a fixture: a pr-covered merge lands `src/x.py`, then a lane merge whose branch carries the identical `src/x.py` plus its fragment. Assert `check-boundary-coverage --gate` exits 0, or that `critic-begin --mode cumulative` at the tip is not refused `no-subject` while the gate exits 1.", "files": ["plugin/lib/boundary_coverage.py"], "scope": "instance", "closure": "An owed entry with a commit whose judgeable diff against its first parent was read and is empty.", "members": [{"id": "m1", "site": "plugin/lib/boundary_coverage.py:_Classifier.credit_reverted (`if not files or ...`)"}], "fid": "R-1"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "release-bookkeeping reason still says 'changing only the version' after the version-shape check was retired", "recommendation": "Instance. Why it broke: 41e6bd2d (owner ruling 2026-11-26, M12) deleted `_version_only` and `_is_version`, so `_release_bookkeeping` now credits any single-parent commit after the anchor whose judgeable changes are all declared version files, and never looks at what those files now hold. But the Entry reason `_classify_shape` emits for RELEASE_BOOKKEEPING (boundary_coverage.py ~L421-424) still reads \"a single-parent commit after the release anchor changing only the version in release version file(s) declared there\". That string is what `check-boundary-coverage` renders and what `--json` returns as `reason`, and it is the release operator's only per-entry account of why a covered commit needs no reading. It claims a check that no longer runs. The wrong action it causes: an operator sees a reopen commit that also bumped a dependency or an entry point in `pyproject.toml`/`package.json` reported as 'changing only the version' and ships it unread, when the owner's ruling was that the content goes uninspected. Make the reason relational to what the code checks, e.g. \"changing only file(s) declared in `release_version_files:` at the release anchor (their content is not inspected)\". The docstring, api-contract and project-state-keys already describe it that way. If you want the text pinned, a test asserting the reason never claims a version-only change would hold it.", "files": ["plugin/lib/boundary_coverage.py"], "scope": "instance", "closure": "The one RELEASE_BOOKKEEPING reason string boundary_coverage._Classifier._classify_shape emits.", "members": [{"id": "m1", "site": "plugin/lib/boundary_coverage.py:_Classifier._classify_shape (RELEASE_BOOKKEEPING Entry reason)"}], "fid": "R-2"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "R-4's reverted credit is said to be recorded beneath the NFR amendment, but the NFR carries no such note", "recommendation": "Records Pass, bar 'misleads into action'. owner-rulings.md '2026-11-26 (round-4 review asks)' item 1 says the `reverted` credit is 'Recorded beneath the 2026-11-25 amendment (\"the boundary review is moved, not skipped\"), whose words stand: what is moved is the review of what ships.' The NFR stage-keyed clause has the 2026-11-25 amendment and a 2026-11-26 'Narrowed:' note for the over-built ruling, and nothing about `reverted` (grep -i revert in nonfunctional-requirements.md returns nothing). The amendment still says 'the release check refuses the release until a boundary-stage review has read every merge since the last release', and `boundary_coverage` (`credit_reverted`, M15) now credits a fully reverted merge that no review read. The consequence: a later Critic doing the Normative-authority check reads the binding clause, sees code that departs from it, and finds no recorded decision at the norm. That is a BLOCKING norm departure on its face, and it costs a round to discover that the ruling exists elsewhere. Per the authoring rule 'A ruling recorded only where the deciders read it is NOT recorded', fix this instance by adding a dated 'Narrowed:'/'Ruling:' line beneath the 2026-11-25 amendment, shaped like the 2026-11-26 line this commit added. Scope: instance. The over-built ruling's item 3 did get its NFR line, so only R-4 is missing one.", "files": [".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/owner-rulings.md"], "scope": "instance", "closure": "An owner ruling on #1232 that says it is recorded beneath the NFR amendment, but has no line there.", "members": [{"id": "m1", "site": ".prawduct/artifacts/nonfunctional-requirements.md stage-keyed clause, after the 2026-11-25 amendment (R-4 / M15 reverted)"}], "fid": "R-3"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "Change record ships a superseded prerelease-tag claim and never says prerelease tags no longer anchor (M10)", "recommendation": "Records Pass, bar 'it ships': the scope's change fragment becomes the CHANGELOG entry. Chunk 02's paragraph says 'Prerelease tags order as SemVer does (`rc.10` above `rc.9`).' dad2ff6d added that sentence while prerelease tags could still be anchor candidates. a97c5e6e (M10) then excluded them: `_tag_candidates` keeps only keys whose second element is `(1,)`, and the release-file path only tests `_version_key(...) is not None`. So no production code path now compares two prerelease keys, and the ordering the record advertises has no effect anyone can observe. The record never states M10 itself. A consumer who tags `-rc.N` reads that sentence, and the consumer note's 'opt in after your first tagged or cut release', as meaning their rc tag anchors the walk. It does not. If rc tags are their only tags, `check-releasability` refuses with `boundary-unevaluable` (no anchor). Otherwise the walk reaches back past the rc to the last final release, and the release is held for work they thought had shipped. Fix: delete the ordering sentence, and say that a prerelease tag is never a release anchor (only a cut's release file can make one). Scope: instance. The SemVer prerelease branch of `_version_key` and its pin, `TestVersionOrder::test_prerelease_identifiers_compare_as_semver_orders_them`, are what kept the sentence looking true. Whether that branch should stay is a design question, not part of this finding.", "files": [".prawduct/changes/boundary-review-per-release.md"], "scope": "instance", "closure": "A sentence in the scope's change fragment describing prerelease-tag behaviour that M10 superseded.", "members": [{"id": "m1", "site": ".prawduct/changes/boundary-review-per-release.md Chunk 02, 'Prerelease tags order as SemVer does'"}], "fid": "R-4"}], "counts": {"blocking": 0, "warning": 4, "note": 0}, "observations": [{"goal": "Nothing Is Unintended", "title": "M15's pre-anchor sub-case credits a revert of shipped work as `reverted`, which R-4's stated reason does not cover", "recommendation": "R-4 credits an entry covered because \"nothing of it ships\". M15 extends this: when the span starts before the anchor, an entry that reverts a change shipped between that start and the anchor also reads `reverted`, and batch-rule condition 2 shares that reading. Such an entry does ship: the next release changes that file relative to the last release, and no review reads it. The change it ships restores content that shipped earlier, so the risk is low, and M15 records the call as veto-able. Make sure the owner's veto or confirmation of M15 states this sub-case rather than resting on R-4's wording. No code change is wanted unless the owner vetoes it.", "files": ["plugin/lib/boundary_coverage.py", "plugin/lib/coverage_algebra.py"], "oid": "O-1"}, {"goal": "Nothing Is Unintended", "title": "Governing-Artifact Reconciliation: the dispositions hold, but R-4's ruling says it is recorded beneath the NFR amendment and the NFR has no such line", "recommendation": "I checked every `governed_by:` disposition in the plan against the diff, and none is a departure without a recorded decision. Where the diff moved off a disposition's text, a recorded call covers it: M3 for the release-side policy fallback against 'unreadable reads per_pr', M14 for lane_eligibility composing `_short_plan_shape` where the disposition says it composes short_plan_deferral, and the owner rulings for the reverted class and the merged-branch-blocker retirement. One gap, which the Records Pass owns since both files are oracle: owner-rulings.md's 2026-11-26 R-4 entry says it is 'Recorded beneath the 2026-11-25 amendment'. Yet nonfunctional-requirements.md carries only the item-3 'Narrowed' line beneath the amendment, and nothing about `reverted` entries passing the release without a read, which departs from the amendment's 'until a boundary-stage review has read every merge'.", "oid": "O-2"}, {"goal": "Everything Is Coherent", "title": "fix_tail_deferral's docstring understates which revisions it reads", "recommendation": "Condition 1 says a live branch's policy is read at 'the merge-base and the working tree'. `review_lane.boundary_review_policy` also requires the integration branch's tip. Condition 4 says risk surfaces are read at 'this checkout, the merge-base and the base's tip', but for a merged branch `held_at` is the merged branch's tip, as the inline comment says. `lane_eligibility`'s docstring makes the same narrowing ('at the merge-base, so a branch cannot opt itself in'). Every gap leaves out a stricter side, so nothing anyone does goes wrong. If you touch these, point at `review_lane`'s module docstring, which states the combinations once, rather than listing the sides again.", "files": ["plugin/lib/gates.py", "plugin/lib/critic_mode.py"], "oid": "O-3"}, {"goal": "Everything Is Coherent", "title": "project-state-keys: 'a PR needs it at both the merge-base and the branch's tip' is ambiguous about which branch", "recommendation": "The code (`boundary_review_policy`) needs the merge-base, the INTEGRATION branch's tip and the working tree. For a merged branch (`boundary_review_policy_of_merge`) it needs the merge-base and the FEATURE branch's tip. The sentence reads true under the first meaning only, because it opens with 'the integration branch's'. Naming the integration branch's tip outright would remove the second reading. Prose only, no gate reads it.", "files": ["plugin/docs/project-state-keys.md"], "oid": "O-4"}, {"goal": "The Design Is Sound", "title": "Redundant re-reads inside one decision on the per_release paths", "recommendation": "`session_fix_tail_deferral` asks `boundary_review_policy` first so a per_pr Stop pays nothing more, then `_fix_tail_deferral` asks it again: merge-base resolution plus two `git show`s. `_lane_eligibility` lists the branch's paths via `risk._review_scope_paths` after `_short_plan_shape` has already listed them, and checks the working tree's risk surfaces twice (the shape's check, then the 'this checkout' side of `paths_touch_held_risk_surface`). `_release_subject` re-reads each owed entry's parents with `git rev-list --parents`, though `classify_known` already set `Entry.parents`. All of this is bounded and per_release-only, so it costs nothing measurable now. Passing the already-read answer down, for example the policy into `fix_tail_deferral`, would remove each one.", "files": ["plugin/lib/gates.py", "plugin/lib/critic_mode.py", "plugin/lib/boundary_coverage.py"], "oid": "O-5"}, {"goal": "The Design Is Sound", "title": "tail-deferred is re-derived at release, so its reason narrates a PR-gate decision nobody recorded", "recommendation": "Unlike the transfer, which the gate records (`record_transfer_grant`) and the release op reads first, the deferral is re-decided at release time: the policy at the merge-base and the merged tip, the risk surfaces at the same two, and this clone's store. Yet the reason says 'the PR gate deferred the fix tail'. A merge pushed past the gate, or one evaluated in another clone, can be labelled differently from what happened. Both readings are not-covered and share one remedy (the release batch review), so only the label is at stake. The asymmetry is sound because the transfer grants coverage and the deferral grants none. Wording such as 'the fix tail qualifies for the PR gate's deferral' would stop the reason claiming a recorded event.", "files": ["plugin/lib/boundary_coverage.py"], "oid": "O-6"}, {"goal": "The System Can Be Understood", "title": "api-contract's `--gate` exit-3 list omits the failed policy read (M9)", "recommendation": "The `--gate` paragraph lists exit 3 as 'unevaluable, a fragment the pending set refused, no release anchor, or a walk since the anchor git could not run'. `release_gate` checks `policy.read_failed` before all of these. The stderr message names the cause, so a script that branches on exit 3 does nothing wrong. Recorded so the next sweep of the contract sees it; no edit is wanted for its own sake.", "files": [".prawduct/artifacts/api-contract.md"], "oid": "O-7"}, {"goal": "Decisions Were Deliberate", "title": "Plan's Goals Level is Medium, with both raising conditions already met", "recommendation": "Level says the consumer repo's per-merge counts and the Chunk 04 `--chunks` check would raise it. Decision 6 records the pay test as run and ruled go (2026-11-26), and Chunk 04 is built. The plan is an oracle that ships nowhere, and no gate reads the Level, so this clears no Records Pass bar. A refreshed Level at archive time would read truer.", "files": [".prawduct/artifacts/build-plan-boundary-review-per-release.md"], "oid": "O-8"}, {"goal": "The System Can Be Understood", "title": "Change record's 'A declaration added since the release never qualifies' now follows the `reverted` sentence it does not describe", "recommendation": "The `reverted` sentence was inserted between `release-bookkeeping` and its qualifier, so the qualifier now reads as if it were about `reverted`. It is prose that changes no one's action, so it is not a finding. It would be worth fixing alongside the prerelease-sentence fix in the same paragraph.", "files": [".prawduct/changes/boundary-review-per-release.md"], "oid": "O-9"}], "duration_seconds": 720, "scope": "boundary-review-per-release", "scope_chosen_by": "binding", "scope_unresolved_cause": null, "scope_reason": null, "base_extended_from": null, "chunks": [], "chunks_proposed": [], "chunks_declared": false, "chunks_evidence": {}, "base_reviewed": "05a1dceb997d0a861f951c64bc721e9939b3d6e8", "record_lint": {"records": [".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-boundary-review-per-release.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/boundary-review-per-release.md", ".prawduct/owner-rulings.md", ".prawduct/runbooks/cut-and-publish-a-plugin-release.md", "documentation/release-process.md", "plugin/docs/governance-telemetry.md", "plugin/docs/project-state-keys.md", "plugin/methodology/planning.md", "plugin/skills/critic/SKILL.md", "plugin/skills/critic/review-cycle.md", "plugin/skills/critic/review-protocol.md", "plugin/skills/pr/SKILL.md"], "chunk_graded": null, "chunks_graded": [], "plan_graded": null, "findings": [], "unchecked": [], "counts": {"chunk-ref-missing": null, "governed-by-gap": 0, "suite-total-claim": 0, "learnings-over-budget": 0, "learnings-budget-unreasoned": 0, "learnings-core-raise-unapproved": 0, "learnings-rule-too-long": 0, "learnings-rule-body": 0, "learnings-area-dead": 0, "change-fragment": 0, "retired-claim-survives": 0, "late-requirement-record": 0, "test-scope-conftest": 0, "test-scope-autouse": 0, "test-scope-init": 0, "test-clock-fake": 0, "test-clock-import": 0}}, "span": "full", "bounded_from": null, "span_reason": "base-moved", "dispatched_at": "2026-11-26T06:24:57Z"}}

