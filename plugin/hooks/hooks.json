{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/banner.py\"",
            "statusMessage": "Prawduct: loading governance…"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/digest.py\"",
            "statusMessage": "Prawduct: loading guidance…"
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/prawduct-hook\" clear --session-start",
            "statusMessage": "Prawduct: preparing session…"
          }
        ]
      },
      {
        "matcher": "resume|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/prawduct-hook\" clear --session-start --brief-only",
            "statusMessage": "Prawduct: orienting session…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/prawduct-hook\" stop",
            "statusMessage": "Prawduct: checking governance gates…"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "(^|:)critic-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/prawduct-hook\" subagent-stop",
            "statusMessage": "Prawduct: consolidating Critic partials…"
          }
        ]
      }
    ]
  }
}
