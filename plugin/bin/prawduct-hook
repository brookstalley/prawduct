def cmd_check_releasability(project_dir: Path, args: list[str] | None = None) -> int:
    """Phase 0 releasability gate for the release runbook (REL-8P6M part f).

    Answers the question the runbook never asked — *is everything on
    ``develop`` fit to ship?* — by requiring every release-pending scope to be
    classified as shipping or withheld behind a named open blocker. Thin
    wrapper; the body lives in ``lib.release_readiness``, reached lazily so the
    hook's top level stays lib-free."""
    usage = "usage: prawduct-hook check-releasability [--release vX.Y.Z]"
    release = None
    argv = list(args or [])
    i = 0
    # Explicit scan rather than ``"--release" in argv``: that pattern silently
    # discards every token it doesn't recognize, so a typo or a bare positional
    # would fall through to the plugin/VERSION fallback and grade a DIFFERENT
    # release than the operator named — the same swallow STH-5R2Q fixed for
    # flag-only subcommands. Unknown tokens are usage errors (exit 2), never
    # ignored, because this gate's whole job is to refuse to guess.
    while i < len(argv):
        token = argv[i]
        if token == "--release":
            if i + 1 >= len(argv):
                print(f"{usage}\n--release requires a version argument", file=sys.stderr)
                return 2
            release = argv[i + 1]
            i += 2
            continue
        if token.startswith("--release="):
            release = token.split("=", 1)[1]
            if not release:
                print(f"{usage}\n--release requires a version argument", file=sys.stderr)
                return 2
            i += 1
            continue
        print(f"unknown argument: {token}\n{usage}", file=sys.stderr)
        return 2
    return _release_readiness().check_releasability(project_dir, release)


def cmd_archive_plan(project_dir: Path, args: list[str] | None = None) -> int:
    """Give a build plan its end of life: stamp it, then move it into `archive/`.

    A state-mutating writer, so it follows that row of the error-model table:
    0 written (or an idempotent no-op), 1 refused with nothing written, 2 usage
    error. It writes on invocation rather than defaulting to a dry run — the
    dry-run default belongs to the repo-wide lifecycle commands, and this one
    acts on a single file the operator named. `--dry-run` is available for the
    preview.

    Thin wrapper; the body lives in ``lib.plan_archive``, reached lazily so the
    hook's top level stays lib-free."""
    usage = (
        "usage: prawduct-hook archive-plan <path> [--state completed|superseded] "
        "[--date YYYY-MM-DD] [--release vX.Y.Z] [--superseded-by <text>] [--dry-run]"
    )
    plan_arg: str | None = None
    state = "completed"
    date: str | None = None
    release: str | None = None
    superseded_by: str | None = None
    dry_run = False
    argv = list(args or [])
    # Explicit scan for the same reason `check-releasability` uses one: a
    # swallowed token would archive under a DIFFERENT terminal state than the
    # operator named, and the state is the whole content of the record. Unknown
    # tokens are usage errors, never ignored.
    valued = {
        "--state": "state",
        "--date": "date",
        "--release": "release",
        "--superseded-by": "superseded_by",
    }
    parsed: dict[str, str] = {}
    i = 0
    while i < len(argv):
        token = argv[i]
        if token == "--dry-run":
            dry_run = True
            i += 1
            continue
        key = None
        value = None
        if token in valued:
            if i + 1 >= len(argv):
                print(f"{usage}\n{token} requires an argument", file=sys.stderr)
                return 2
            key, value, i = valued[token], argv[i + 1], i + 2
        else:
            for flag, name in valued.items():
                if token.startswith(f"{flag}="):
                    key, value, i = name, token.split("=", 1)[1], i + 1
                    break
        if key is not None:
            if not value:
                print(f"{usage}\n{token} requires a non-empty argument", file=sys.stderr)
                return 2
            parsed[key] = value
            continue
        if token.startswith("-"):
            print(f"unknown argument: {token}\n{usage}", file=sys.stderr)
            return 2
        if plan_arg is not None:
            print(f"unexpected second path: {token}\n{usage}", file=sys.stderr)
            return 2
        plan_arg, i = token, i + 1

    if plan_arg is None:
        print(f"{usage}\nname the plan to archive", file=sys.stderr)
        return 2
    state = parsed.get("state", state)
    date = parsed.get("date")
    release = parsed.get("release")
    superseded_by = parsed.get("superseded_by")

    plan_archive = _plan_archive()
    if state not in plan_archive.TERMINAL_STATES:
        # A usage error, not a refusal: the operator mistyped an enumerated
        # value, which the CLI can tell them without reading a single file.
        print(
            f"unknown --state {state!r} (expected one of "
            f"{', '.join(plan_archive.TERMINAL_STATES)})\n{usage}",
            file=sys.stderr,
        )
        return 2

    if date is None:
        date = datetime.now(timezone.utc).strftime("%Y-%m-%d")

    plan_path = Path(plan_arg)
    if not plan_path.is_absolute():
        plan_path = project_dir / plan_path
    artifacts_dir = project_dir / ".prawduct" / "artifacts"

    if dry_run:
        # The SAME refusal predicate the real run uses, so the preview cannot
        # promise an operation the write would refuse. It used to skip the guards
        # entirely and print `would archive:` at exit 0 for a traversal path the
        # real run rejects — a preview that overstates permission, which is the
        # shape where a check reports clean about something that is wrong.
        refusal = plan_archive.refusal_reason(
            plan_path, artifacts_dir, state=state, superseded_by=superseded_by
        )
        if refusal is not None:
            print(f"not-archived: {refusal}", file=sys.stderr)
            return 1
        destination = plan_archive.archive_destination(plan_path, artifacts_dir)
        # The preview reads the plan for the SAME reason the write does: the
        # `unbuilt_at_archive` stamp is derived from the plan's own Status, so a
        # preview that skipped it would silently understate the record about to
        # be written — the mirror of the overstatement this dry-run branch was
        # already fixed for.
        #
        # Guarded even though `refusal_reason` just read the same file and
        # returned None. The window between the two reads is narrow, not closed,
        # and an escaping OSError here would leave the CLI raising a stack trace
        # across its own boundary — which `api-contract.md` § Direction forbids
        # outright. Refusing at exit 1 is what the write path does for the
        # identical condition, so the preview and the write agree here too.
        try:
            plan_content = plan_path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as exc:
            print(f"not-archived: cannot read {plan_path}: {exc}", file=sys.stderr)
            return 1
        fields = plan_archive.completion_fields(
            state=state,
            date=date,
            release=release,
            superseded_by=superseded_by,
            unbuilt=plan_archive.unbuilt_at_archive(plan_content),
        )
        print(f"would archive: {plan_path} -> {destination}")
        for key, value in fields.items():
            print(f"  {key}: {value}")
        return 0

    result = plan_archive.archive_plan(
        plan_path,
        artifacts_dir,
        state=state,
        date=date,
        release=release,
        superseded_by=superseded_by,
    )
    if result["status"] != "archived":
        print(f"not-archived: {result['reason']}", file=sys.stderr)
        return 1

    print(f"archived: {result['source']} -> {result['destination']}")
    for key, value in result["fields"].items():
        print(f"  {key}: {value}")

    # The pointer is state a session owns, so this reports rather than writes —
    # but it must report, because a pointer left naming a moved file is read by
    # every gate as "no active build plan", which is the right end state reached
    # by an accident nobody recorded.
    pointer = _read_str_yaml_key(
        project_dir / ".prawduct" / "project-state.yaml", "active_build_plan"
    )
    pointed_at = _core().pointer_plan_path(project_dir / ".prawduct")
    if pointer and pointed_at is not None:
        pointed_at = pointed_at.resolve()
        if pointed_at == Path(result["source"]).resolve():
            print(
                "NOTE: active_build_plan still names the plan just archived "
                f"({pointer}) — clear it, or point it at the plan that is now live.",
                file=sys.stderr,
            )
    return 0


def cmd_check_released(project_dir: Path, args: list[str] | None = None) -> int:
    """Post-release verification: did the whole release actually arrive?

    The mirror of ``check-releasability``. Thin wrapper; the body lives in
    ``lib.release_verification``, reached lazily so the hook's top level stays
    lib-free."""
    usage = "usage: prawduct-hook check-released vX.Y.Z [--json] [--allow-unverifiable]"
    release = None
    json_output = False
    allow_unverifiable = False
    argv = list(args or [])
    # Explicit scan for the same reason check-releasability uses one: a swallowed
    # token would verify a DIFFERENT release than the operator named, and this
    # gate's whole job is to refuse to guess. Unknown tokens are usage errors.
    for token in argv:
        if token == "--json":
            json_output = True
            continue
        if token == "--allow-unverifiable":
            allow_unverifiable = True
            continue
        if token.startswith("-"):
            print(f"unknown argument: {token}\n{usage}", file=sys.stderr)
            return 2
        if release is not None:
            print(f"unexpected second version: {token}\n{usage}", file=sys.stderr)
            return 2
        release = token
    if not release:
        print(f"{usage}\na version argument is required", file=sys.stderr)
        return 2
    return _release_verification().check_released(
        project_dir, release, json_output, allow_unverifiable
    )


