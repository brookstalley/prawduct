def cmd_handoff(project_dir: Path, argv: list[str]) -> int:
    """Preview the session handoff the next session would receive.
    Thin wrapper — body lives in ``lib.briefing.handoff_cmd``. Read-only: it
    renders without writing, so checking what `/clear` would produce no longer
    requires running the one command that destroys what it replaces."""
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import briefing  # noqa: PLC0415 — lazy keeps top-level cheap + lib-free
    except ImportError:
        print(
            "handoff unavailable (could not import the plugin lib/ from "
            "${CLAUDE_PLUGIN_ROOT})",
            file=sys.stderr,
        )
        return 1

    # The preview's Resume line is the chunk reading, so an unticked finished
    # chunk makes the thing being previewed wrong — and this preview is what a
    # session hands the next one, which is precisely how a false progress signal
    # propagates as testimony. Emitted here rather than inside `briefing.py`: the
    # notice belongs to the deliberately invoked command, and the same renderer
    # also serves the SessionStart hot path, where this must NOT fire.
    notice = _buildplan_refs().unticked_committed_chunk_notice(project_dir)
    if notice:
        print(notice, file=sys.stderr)

    return briefing.handoff_cmd(project_dir, argv)


