    subcommands it operates on a TARGET path passed in ``argv`` (the new repo),
    not the current project dir — onboarding creates a repo elsewhere. ``argv`` is
    ``sys.argv[2:]`` (``<target> --name "<name>" [--apply] [--json]``); defaults to
    a safe dry run. The scaffold creates only product-owned state + the install
    reference (design §3) — never any file-sync machinery.

    Fail-safe: if the bundled lib/ cannot be imported (an incomplete plugin
    install), print a clear message and return 1 rather than crashing.
    """
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import init_product  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "init-product unavailable (could not import the plugin lib/ from "
            "${CLAUDE_PLUGIN_ROOT})",
            file=sys.stderr,
        )
        return 1
    return init_product.run(argv)


def cmd_update_gitignore(project_dir: Path) -> int:
    """Reconcile ``.gitignore`` with the framework's session-file contract
    (``/prawduct:doctor`` repair step — gate-soundness ch.3).

    Adds missing session entries and strips lines that ignore managed files or
    RETIRED entries (the tracked-by-default build plan). ``init-product``
    early-exits on an already-scaffolded repo and the session hooks must never
    edit a tracked file (the no-noise guarantee), so this on-demand command is
    how an existing repo picks up gitignore-contract changes. Prints each
    unignored path so the caller can advise ``git add``.

    Fail-safe: if the bundled lib/ cannot be imported (an incomplete plugin
    install), print a clear message and return 1 rather than crashing.
    """
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import core as lib_core  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "update-gitignore unavailable (could not import the plugin lib/ "
            "from ${CLAUDE_PLUGIN_ROOT})",
            file=sys.stderr,
        )
        return 1
    result = lib_core.update_gitignore(project_dir)
    if result.get("unignored"):
        for path in result["unignored"]:
            print(f"unignored: {path} — now tracked-by-contract; `git add` it if present")
    print("updated .gitignore" if result.get("modified") else "no changes needed")
    return 0


def cmd_audit_learnings(project_dir: Path, argv: list[str]) -> int:
    """Audit the consumer's ``.prawduct/learnings.md`` lifecycle (F9).

    Plugin-native port of the legacy file-sync ``audit-learnings`` path (gone in
    a migrated consumer — there is no framework checkout). Walks the
    consumer's OWN ``learnings.md``, classifying entries as promotion /
    retirement / stale candidates, and with ``--apply`` moves sentinel-passing
    entries to ``learnings-detail.md``'s historical section. Invoked by
    ``/prawduct:doctor``'s Audit-Learnings flow (``--json``). ``argv`` is
    ``sys.argv[2:]`` (``--apply``, ``--json``); read-only by default.

    Fail-safe: if the bundled lib/ cannot be imported (an incomplete plugin
    install), print a clear message and return 1 rather than crashing.
    """
    rejected = _reject_unknown_args("audit-learnings", argv, {"--apply", "--json"})
    if rejected is not None:
        return rejected
    apply = "--apply" in argv
    as_json = "--json" in argv

    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import run_audit_learnings  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "error: audit-learnings could not import the plugin lib/ from "
            "${CLAUDE_PLUGIN_ROOT}.",
            file=sys.stderr,
        )
        return 1

    result = run_audit_learnings(str(project_dir), apply=apply)

    if as_json:
        print(json.dumps(result, indent=2))
        return 1 if "error" in result else 0

    if "error" in result:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1

    promotions = result["promotions"]
    retirements = result["retirements"]
    stale = result["stale_flags"]
    errors = result["errors"]
    print(
        f"audit-learnings ({'applied' if result['applied'] else 'dry-run'}): "
        f"{len(promotions)} promotion candidate(s), {len(retirements)} retirement "
        f"candidate(s), {len(stale)} stale flag(s), {len(errors)} error(s)."
    )
    for p in promotions:
        print(f"  promote: {p['title']} (confirmations={p['confirmations']})")
    for r in retirements:
        state = "retired" if r.get("applied") else ("ready" if r.get("passed") else "blocked")
        print(f"  retire[{state}]: {r['title']} (sentinel={r['sentinel']})")
    for s in stale:
        print(f"  stale: {s['title']} ({s['age_days']}d, confirmations={s['confirmations']})")
    for e in errors:
        print(f"  error: {e['title']}: {e['error']}")
    return 0


def cmd_repo_disable(project_dir: Path, argv: list[str]) -> int:
    """Disable the Prawduct plugin for the current repo (``/prawduct:repo-disable``).

    Writes ``"enabledPlugins": {"prawduct@prawduct": false}`` into
    ``.claude/settings.json`` (committed; default) or ``.claude/settings.local.json``
    (``--local``; auto-gitignored), preserving every other setting. Dry-run by
    default; ``--apply`` writes; ``--json`` emits the structured plan/result.

    There is no enable counterpart: a disabled plugin's own skills do not load, so
    re-enabling is a documented manual edit (set the value to ``true`` or delete the
    key). Fail-safe: if the bundled lib/ cannot be imported, print a clear message
    and return 1 rather than crashing.
    """
    rejected = _reject_unknown_args(
        "repo-disable", argv, {"--local", "--apply", "--json"}
    )
    if rejected is not None:
        return rejected
    local = "--local" in argv
    apply = "--apply" in argv
    as_json = "--json" in argv

    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib.repo_toggle import set_repo_disabled  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "error: repo-disable could not import the plugin lib/ from "
            "${CLAUDE_PLUGIN_ROOT}.",
            file=sys.stderr,
        )
        return 1

    result = set_repo_disabled(project_dir, local=local, apply=apply)

    if as_json:
        print(json.dumps(result, indent=2))
        return 1 if "error" in result else 0

    if "error" in result:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1

    target = result["target"]
    if result["already_disabled"]:
        print(f"Prawduct is already disabled for this repo in {target} — nothing to do.")
        return 0

    if not apply:
        print(
            f'DRY RUN: would set "enabledPlugins": {{"prawduct@prawduct": false}} in '
            f"{target} (all other settings preserved). Re-run with --apply to write it."
        )
        return 0

    print(
        f'Disabled Prawduct for this repo: wrote "prawduct@prawduct": false to {target}.\n'
        "  • Takes effect after you run /reload-plugins (this session) or restart Claude Code\n"
        "    — until then Prawduct stays active.\n"
        "  • Once disabled, the /prawduct:* commands won't load here. To RE-ENABLE later, edit\n"
        f'    {target}: set "prawduct@prawduct": true (or remove the line), then /reload-plugins.'
    )
    return 0


_USAGE = (
    "Usage: prawduct-hook "
    "{clear [--session-start|--force|--brief-only]|critic-begin --mode <m>|critic-end|critic-consolidate|"
    "subagent-stop|"
    "stop|build-index|user-prompt-submit|"
    "jurisdiction [--file <path>|<text...>] [--artifacts-only]|"
    "test-status|validate-evidence|"
    "test-evidence record [--from-junit <r>|--from-counts passed=N failed=M skipped=K|--no-rerun] [-- pytest args]|"
    "check-cumulative-critic|"
    "verify-chunk-refs [chunk_id]|"
    "verify-records [--base <t>] [--head <t>] [--chunk <id>] [--json]|verify-coverage|"
    "ledger-append --event <kind> [--scope <s>] [--chunk <id>] [--model <id>]|"
    "handoff preview|"
    "review-stats [--json]|classify-diff-risk [<base>]|"
    "check-operator-verification|accept-operator-verification <rationale>|"
    "verify-operator-verification <vrf-id>|"
    "check-pr-doc-only|check-change-log-entry|check-releasability [--release vX.Y.Z]|"
    "regen-views [--check]|stamp-merged|"
    "infer-critic-mode [args]|"
    "resolve-base|version|"
    "evidence {status|list [--kind <k>] [-n <count>]}|advisory <subcmd> [args]|"
    "disposition <review-id> <fid> {--accept <reason>|--file <backlog-id>} [--owner-ruling <text>]|"
    "render-dispositions [--review <id>|--scope <s>] [--json]|"
    "coverage-status [--json]|coverage-scaffold [--apply] [--json]|"
    "migrate-plugin [--apply] [--json]|init-product <target> --name <name> [--backlog-repo owner/repo] [--apply] [--json]|"
    "update-gitignore|"
    "audit-learnings [--apply] [--json]|repo-disable [--local] [--apply] [--json]}"
)


# --- Work model: undocumented-requirement catch (build plan: work-model) -----
# The external enforcement surface for the work model (documentation/work-model.md,
# prawduct-internal -- not shipped with the plugin). A
# UserPromptSubmit hook surfaces, pre-turn, salient terms a user introduces that
# NO governing artifact covers — the signal a new requirement may be entering
# undocumented. The catch logic is the pure lib/work_model_index.py (Chunk 1);
# these are the thin runtime wrappers (Chunk 2). Per the plugin invariant, the
# derived index is per-repo state in ``.prawduct/.work-model-index.json`` (NOT
# plugin-bundled state), rebuilt from the repo's governing corpus (artifacts,
# CLAUDE.md, docs/, methodology/ — review-fixes Chunk 2). Both
# commands gate on ``.prawduct/`` (the user-scoped plugin fires in every repo)
# and are fail-soft — a hook error must never break session start or, above all,
# prompt submission.

_WORK_MODEL_INDEX_RELPATH = ".work-model-index.json"


def _work_model_load_lib():
    """Import the pure catch logic, seeding sys.path like the other lib readers."""
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    from lib import work_model_index  # noqa: PLC0415 — lazy import keeps top-level cheap

    return work_model_index


def _work_model_corpus_paths(project_dir: Path, prawduct_dir: Path) -> list[Path]:
    """The governing corpus the vocabulary index is built from: every markdown
    artifact under ``.prawduct/artifacts/``, plus the repo's CLAUDE.md and all
    ``docs/`` / ``methodology/`` markdown, recursively (gate-noise: product
    repos keep governing vocabulary in doc subdirectories, and the earlier
    top-level-only globs made those words read as orphans). Widening is safe in
    one direction only — extra corpus vocabulary can only suppress the nudge,
    never fire it. Missing directories simply contribute nothing — product
    repos rarely have all of them."""
    paths = sorted((prawduct_dir / "artifacts").glob("*.md"))
    claude_md = project_dir / "CLAUDE.md"
    if claude_md.is_file():
        paths.append(claude_md)
    for sub in ("docs", "methodology"):
        paths.extend(sorted((project_dir / sub).rglob("*.md")))
    return paths


def _work_model_corpus_texts(project_dir: Path, prawduct_dir: Path) -> list[str]:
    texts: list[str] = []
    for path in _work_model_corpus_paths(project_dir, prawduct_dir):
        try:
            texts.append(path.read_text(encoding="utf-8", errors="replace"))
        except OSError:
            continue
    return texts


def _work_model_ensure_index(
    project_dir: Path, prawduct_dir: Path, wmi, *, force: bool = False
) -> dict:
    """Return the vocabulary index, rebuilding from the corpus when missing,
    stale (a corpus file is newer than the index), corrupt, or ``force``."""
    index_path = prawduct_dir / _WORK_MODEL_INDEX_RELPATH
    corpus = _work_model_corpus_paths(project_dir, prawduct_dir)

    if not force and index_path.exists():
        idx_mtime = index_path.stat().st_mtime
        if all(p.stat().st_mtime <= idx_mtime for p in corpus):
            try:
                return json.loads(index_path.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                pass  # corrupt -> rebuild below

    index = wmi.build_index(_work_model_corpus_texts(project_dir, prawduct_dir))
    try:
        index_path.write_text(json.dumps(index), encoding="utf-8")
    except OSError:
        pass  # best-effort write; detection still works from the in-memory index
    return index


def cmd_build_index(project_dir: Path) -> int:
    """Rebuild the work-model vocabulary index from the repo's governing
    corpus (wired on SessionStart to warm the index). Best-effort: a build
    failure must never break session start."""
    prawduct_dir = get_prawduct_dir(project_dir)
    if not prawduct_dir.is_dir():
        return 0  # not a Prawduct-governed repo — stay silent (mirrors digest.py)
    try:
        wmi = _work_model_load_lib()
        _work_model_ensure_index(project_dir, prawduct_dir, wmi, force=True)
    except Exception as exc:  # prawduct:allow prawduct/broad-except -- index build is best-effort; must never break session start
        print(f"NOTE: Prawduct could not build the work-model index: {exc}", file=sys.stderr)
        return 0
    return 0


def cmd_user_prompt_submit(project_dir: Path) -> int:
    """UserPromptSubmit hook: inject a pre-turn nudge naming salient terms in the
    user's prompt that no governing artifact covers (tripwire #1). Silent when
    clean. Fail-soft above all else — a hook error must NEVER block the user's
    prompt, so every path returns 0 and nothing is printed on error."""
    prawduct_dir = get_prawduct_dir(project_dir)
    if not prawduct_dir.is_dir():
        return 0  # not a Prawduct-governed repo — stay silent
    try:
        raw = sys.stdin.read()
        prompt = json.loads(raw).get("prompt", "") if raw.strip() else ""
        if not prompt.strip():
            return 0
        wmi = _work_model_load_lib()
        index = _work_model_ensure_index(project_dir, prawduct_dir, wmi)
        nudge = wmi.nudge_for(prompt, index)
        if nudge:
            print(
                json.dumps(
                    {
                        "hookSpecificOutput": {
                            "hookEventName": "UserPromptSubmit",
                            "additionalContext": nudge,
                        }
                    }
                )
            )
    except Exception as exc:  # prawduct:allow prawduct/broad-except -- a hook error must never block prompt submission
        # Log to stderr only — stdout is the additionalContext channel and must
        # stay clean; the user's prompt proceeds regardless.
        print(f"NOTE: Prawduct work-model nudge skipped (hook error): {exc}", file=sys.stderr)
        return 0
    return 0


def cmd_jurisdiction(project_dir: Path, argv: list[str]) -> int:
    """On-demand authoring aid: given plan/prompt text, list the governing
    artifacts whose vocabulary the text's salient terms fall under — the
    INVERSION of the orphan tripwire (orphans = terms NO artifact covers;
    jurisdiction = which artifacts cover this text's terms). It seeds a plan's
    ``governed_by:`` field with mechanical candidates for the planner's
    judgment; it is NEVER a gate, so every path returns 0.

    Input, first match wins: ``--file <path>`` reads the text from a file;
    otherwise the positional args are joined as the text; otherwise stdin.
    ``--artifacts-only`` restricts the corpus to ``.prawduct/artifacts/``
    (the rest of the corpus — CLAUDE.md, docs/, methodology/ — is dropped).

    Output: one line per candidate, ranked (count desc, path asc):
    ``<path relative to project dir>  (<count>: term1, term2, ...)``. No
    matches prints nothing. Fail-open — a bad ``--file`` path or any other
    error prints a NOTE to stderr and still exits 0.
    """
    prawduct_dir = get_prawduct_dir(project_dir)
    if not prawduct_dir.is_dir():
        return 0  # not a Prawduct-governed repo — stay silent (mirrors build-index)

    # Manual argv parse (no argparse — matches the other subcommands' style).
    artifacts_only = False
    file_arg: str | None = None
    positional: list[str] = []
    i = 0
    while i < len(argv):
        token = argv[i]
        if token == "--artifacts-only":
            artifacts_only = True
        elif token == "--file":
            i += 1
            if i < len(argv):
                file_arg = argv[i]
        elif token.startswith("--file="):
            file_arg = token[len("--file=") :]
        else:
            positional.append(token)
        i += 1

    try:
        wmi = _work_model_load_lib()

        # Resolve the text to place (first match wins): file, then positional,
        # then stdin. A missing --file raises FileNotFoundError -> NOTE below.
        if file_arg is not None:
            text = Path(file_arg).read_text(encoding="utf-8", errors="replace")
        elif positional:
            text = " ".join(positional)
        else:
            text = sys.stdin.read()
        if not text.strip():
            return 0  # nothing to place -> nothing to print

        paths = _work_model_corpus_paths(project_dir, prawduct_dir)
        if artifacts_only:
            artifacts_root = prawduct_dir / "artifacts"
            paths = [p for p in paths if artifacts_root in p.parents]

        # Build (relpath, content) pairs; the pure function ranks and caps.
        files: list[tuple[str, str]] = []
        for p in paths:
            try:
                content = p.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue  # unreadable corpus file contributes nothing
            try:
                rel = str(p.relative_to(project_dir))
            except ValueError:
                rel = str(p)  # outside the project dir (unexpected) -> absolute
            files.append((rel, content))

        for cand in wmi.jurisdiction_candidates(text, files):
            print(f"{cand['path']}  ({cand['count']}: {', '.join(cand['matched'])})")
    except (OSError, ValueError) as exc:
        # Missing/unreadable --file, decode issues, etc. This is an authoring
        # aid, never a gate — surface the reason, but exit 0.
        print(f"NOTE: prawduct-hook jurisdiction could not run: {exc}", file=sys.stderr)
        return 0
    except Exception as exc:  # prawduct:allow prawduct/broad-except -- authoring aid must never error out; always exit 0
        print(f"NOTE: prawduct-hook jurisdiction skipped (error): {exc}", file=sys.stderr)
        return 0
    return 0


def main() -> int:
    if len(sys.argv) < 2:
        print(_USAGE, file=sys.stderr)
        return 1

    command = sys.argv[1]
    project_dir = get_project_dir()

    if command == "clear":
        return cmd_clear(project_dir, sys.argv[2:])
    elif command == "critic-begin":
        return cmd_critic_begin(project_dir, sys.argv[2:])
    elif command == "critic-end":
        return cmd_critic_end(project_dir)
    elif command == "critic-consolidate":
        return cmd_critic_consolidate(project_dir)
    elif command == "subagent-stop":
        return cmd_subagent_stop(project_dir, _read_stop_stdin())
    elif command == "build-index":
        return cmd_build_index(project_dir)
    elif command == "user-prompt-submit":
        return cmd_user_prompt_submit(project_dir)
    elif command == "jurisdiction":
        return cmd_jurisdiction(project_dir, sys.argv[2:])
    elif command == "stop":
        return cmd_stop(project_dir, _read_stop_stdin())
    elif command == "test-status":
        return cmd_test_status(project_dir)
    elif command == "validate-evidence":
        return cmd_validate_evidence(project_dir)
    elif command == "test-evidence":
        return cmd_test_evidence(project_dir, sys.argv[2:])
    elif command == "check-cumulative-critic":
        return cmd_check_cumulative_critic(project_dir)
    elif command == "verify-chunk-refs":
        chunk_id = sys.argv[2] if len(sys.argv) > 2 else None
        return cmd_verify_chunk_refs(project_dir, chunk_id)
    elif command == "verify-records":
        return cmd_verify_records(project_dir, sys.argv[2:])
    elif command == "verify-coverage":
        return cmd_verify_coverage(project_dir)
    elif command == "ledger-append":
        return cmd_ledger_append(project_dir, sys.argv[2:])
    elif command == "handoff":
        return cmd_handoff(project_dir, sys.argv[2:])
    elif command == "review-stats":
        return cmd_review_stats(project_dir, sys.argv[2:])
    elif command == "classify-diff-risk":
        return cmd_classify_diff_risk(project_dir, sys.argv[2:])
    elif command == "check-operator-verification":
        return cmd_check_operator_verification(project_dir)
    elif command == "accept-operator-verification":
        rationale = sys.argv[2] if len(sys.argv) > 2 else None
        return cmd_accept_operator_verification(project_dir, rationale)
    elif command == "verify-operator-verification":
        vrf_id = sys.argv[2] if len(sys.argv) > 2 else None
        return cmd_verify_operator_verification(project_dir, vrf_id)
    elif command == "check-change-log-entry":
        return cmd_check_change_log_entry(project_dir)
    elif command == "check-releasability":
        return cmd_check_releasability(project_dir, sys.argv[2:])
    elif command == "check-pr-doc-only":
        return cmd_check_pr_doc_only(project_dir)
    elif command == "stamp-merged":
        return cmd_stamp_merged(project_dir)
    elif command == "regen-views":
        return cmd_regen_views(project_dir, sys.argv[2:])
    elif command == "infer-critic-mode":
        args = " ".join(sys.argv[2:]) if len(sys.argv) > 2 else None
        return cmd_infer_critic_mode(project_dir, args)
    elif command == "resolve-base":
        return cmd_resolve_base(project_dir)
    elif command == "disposition":
        return cmd_disposition(project_dir, sys.argv[2:])
    elif command == "render-dispositions":
        return cmd_render_dispositions(project_dir, sys.argv[2:])
    elif command == "evidence":
        return cmd_evidence(project_dir, sys.argv[2:])
    elif command == "bug-inbox":
        return cmd_bug_inbox(project_dir)
    elif command == "version":
        return cmd_version()
    elif command == "advisory":
        return cmd_advisory(project_dir, sys.argv[2:])
    elif command == "backlog":
        return cmd_backlog(project_dir, sys.argv[2:])
    elif command == "coverage-status":
        return cmd_coverage_status(project_dir, sys.argv[2:])
    elif command == "coverage-scaffold":
        return cmd_coverage_scaffold(project_dir, sys.argv[2:])
    elif command == "migrate-plugin":
        return cmd_migrate_plugin(project_dir, sys.argv[2:])
    elif command == "init-product":
        return cmd_init_product(sys.argv[2:])
    elif command == "update-gitignore":
        return cmd_update_gitignore(project_dir)
    elif command == "audit-learnings":
        return cmd_audit_learnings(project_dir, sys.argv[2:])
    elif command == "repo-disable":
        return cmd_repo_disable(project_dir, sys.argv[2:])
    else:
        print(_USAGE, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
