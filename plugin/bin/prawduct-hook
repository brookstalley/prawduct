    return backlog_cli.run(project_dir, argv)


def _coverage_scaffold_stub(artifact_name: str) -> str:
    """A neutral placeholder for a missing strategy-class artifact.

    It deliberately does NOT pre-fill ``(not relevant)`` — whether an artifact is
    relevant is the owner's decision to record, not the tool's to guess. Coverage
    is satisfied by the file existing (any content), so dropping this stub clears
    the layer-1 nudge and leaves the owner to fill it: a real spec, or a one-line
    ``(not relevant — <reason>)`` decision the Critic can then weigh."""
    title = artifact_name.removesuffix(".md").replace("-", " ").title()
    return (
        f"# {title}\n\n"
        "<!--\n"
        "Strategy-class artifact expected by structural coverage. Replace this stub\n"
        "with EITHER a real specification, OR a one-line decision that it is not\n"
        "relevant to this product, for example:\n\n"
        "    (Not relevant — <reason>.)\n\n"
        "Coverage is satisfied by this file existing; the Critic and risk\n"
        "calibration judge whether the decision holds. See /prawduct:methodology planning.\n"
        "-->\n\n"
        "_Unwritten stub — author this artifact, or record why it is not relevant._\n"
    )


def cmd_coverage_status(project_dir: Path, argv: list[str]) -> int:
    """Report the structural-coverage chain status (the doctor coverage check).

    Reports all three layers of the coverage chain, reading the SAME expectation
    table the probe fires on (``lib/coverage_probes.missing_expected_artifacts``) —
    never a transcription, so the doctor check can't drift from the nudge:

      - **Layer 0 (discovery):** are structural characteristics recorded?
      - **Layer 1 (artifacts):** which expected strategy-class artifacts are missing?
      - **Layer 2 (norms):** are the product's norms ratified?

    and names the highest-priority active layer as the primary fix. Layers 0 and 1
    are exact complements (never both), but layer 2's gate is independent, so
    during partial authoring layers 1 and 2 can both be active (docs/norms.md
    § Enforcement — proportionality, not a hard one-at-a-time invariant). ``--json``
    emits the structured status for the doctor skill; default is human-readable.

    Read-only and informational — always exits 0. A broken plugin import or a
    faulty sub-check degrades to a NOTE / "unknown", never a crash (a health
    *report* must not fail the operator's shell)."""
    want_json = "--json" in argv
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import coverage_probes as cp  # noqa: PLC0415 — lazy keeps top-level cheap
        from lib import advisory_store as store  # noqa: PLC0415
        from lib import norm_probes  # noqa: PLC0415
    except ImportError as exc:
        print(f"NOTE: coverage-status unavailable (plugin lib/ not importable: {exc})", file=sys.stderr)
        return 0

    state_path = project_dir / ".prawduct" / "project-state.yaml"
    codebase = store.make_codebase(project_dir)
    recorded = cp.structural_characteristics_recorded(state_path)
    missing = cp.missing_expected_artifacts(codebase)  # [(name, characteristic|None)]

    # Layer 2 composes over the norm probe (its own gate is "strategy artifacts
    # exist AND registry unratified"). The probe is declared non-raising, but a
    # health report must not crash on a malformed state, so degrade to "unknown"
    # and NAME the reason on stderr rather than swallow it.
    norms_unratified: bool | None
    try:
        proj_state = store.load_project_state(project_dir)
        norms_unratified = bool(norm_probes.probe_norm_registry_unratified(proj_state, codebase))
    except Exception as exc:  # prawduct:allow prawduct/broad-except -- report must not crash; degrade layer 2 to unknown + log
        print(f"NOTE: coverage-status layer-2 (norm ratification) check skipped: {exc}", file=sys.stderr)
        norms_unratified = None

    # Which single layer currently owns the nudge (the chain stages).
    if not recorded:
        active_layer: int | None = 0
        fix: str | None = "record structural characteristics: /prawduct:methodology discovery"
    elif missing:
        active_layer = 1
        fix = ("author each missing artifact (/prawduct:methodology planning), or drop stubs "
               "in one act: prawduct-hook coverage-scaffold --apply")
    elif norms_unratified:
        active_layer = 2
        fix = "ratify the product's norms via /prawduct:doctor"
    else:
        active_layer = None
        fix = None

    if want_json:
        import json as _json  # noqa: PLC0415
        print(_json.dumps({
            "structural_recorded": recorded,
            "missing_artifacts": [{"artifact": name, "characteristic": char} for name, char in missing],
            "norms_unratified": norms_unratified,
            "active_layer": active_layer,
            "fix": fix,
        }, indent=2))
        return 0

    print("Structural coverage (three-layer chain):")
    print(f"  Layer 0 · discovery         : characteristics {'RECORDED' if recorded else 'NOT RECORDED'}")
    if missing:
        print(f"  Layer 1 · strategy artifacts : {len(missing)} expected artifact(s) missing")
        for name, char in missing:
            suffix = "" if char is None else f"  (required — {char} recorded)"
            print(f"       - {name}{suffix}")
    else:
        print("  Layer 1 · strategy artifacts : all expected artifacts present")
    if norms_unratified is None:
        print("  Layer 2 · norm ratification : unknown (norm check unavailable)")
    elif norms_unratified:
        print("  Layer 2 · norm ratification : norms not yet ratified")
    else:
        print("  Layer 2 · norm ratification : ratified or not yet applicable")
    if active_layer is not None:
        print(f"  Active nudge → Layer {active_layer}: {fix}")
    elif norms_unratified is None:
        # Layers 0-1 satisfied, but layer 2 couldn't be checked — don't claim the
        # whole chain is satisfied (the --json consumer discriminates on the
        # norms_unratified: null field; the human reader gets this explicit line).
        print("  Active nudge → none actionable: layers 0-1 satisfied; layer 2 (norms) could not be checked.")
    else:
        print("  Active nudge → none: the coverage chain is satisfied.")
    return 0


def cmd_coverage_scaffold(project_dir: Path, argv: list[str]) -> int:
    """Drop stub files for the expected-but-missing strategy-class artifacts.

    The coverage forcing function nudges a product to author (or explicitly
    decline) each strategy-class artifact. Resolving several at once should be a
    30-second confirm-and-fill, not a chore — this drops a neutral stub for each
    missing expected artifact in one act, which the owner then fills with a real
    spec or a one-line ``(not relevant — <reason>)`` decision.

    Default is a **DRY RUN**: it lists what it WOULD create and changes nothing.
    ``--apply`` writes the stubs. Two guarantees keep the owner in control: the
    framework never silently auto-stubs (``--apply`` is the owner's confirm — that
    a relevance decision is theirs to make, not the tool's to default), and it
    never overwrites an existing file (an authored artifact or a prior stub is left
    untouched). Reads the SAME expectation table as the probe and the status check
    (``lib/coverage_probes.missing_expected_artifacts``).

    Exit 0 on dry run or successful ``--apply``; exit 1 if the plugin ``lib/`` is
    not importable (a state-mutating command must not claim success on a broken
    install — mirrors ``regen-views``)."""
    apply = "--apply" in argv
    want_json = "--json" in argv
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import coverage_probes as cp  # noqa: PLC0415 — lazy keeps top-level cheap
        from lib import advisory_store as store  # noqa: PLC0415
    except ImportError as exc:
        print(f"error: coverage-scaffold could not import the plugin lib/ ({exc})", file=sys.stderr)
        return 1

    state_path = project_dir / ".prawduct" / "project-state.yaml"
    codebase = store.make_codebase(project_dir)
    recorded = cp.structural_characteristics_recorded(state_path)
    missing = cp.missing_expected_artifacts(codebase)  # [(name, characteristic|None)]
    artifacts_dir = project_dir / ".prawduct" / "artifacts"

    created: list[str] = []
    skipped_existing: list[str] = []
    if apply and missing:
        try:
            artifacts_dir.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            print(f"error: could not create {artifacts_dir} ({exc})", file=sys.stderr)
            return 1
        for name, _char in missing:
            dest = artifacts_dir / name
            if dest.exists():  # never overwrite — an authored artifact or prior stub stays
                skipped_existing.append(name)
                continue
            try:
                _core().atomic_write_text(dest, _coverage_scaffold_stub(name))
                created.append(name)
            except OSError as exc:
                print(f"NOTE: could not write {dest} ({exc})", file=sys.stderr)

    if want_json:
        import json as _json  # noqa: PLC0415
        print(_json.dumps({
            "structural_recorded": recorded,
            "missing_artifacts": [{"artifact": name, "characteristic": char} for name, char in missing],
            "applied": apply,
            "created": created,
            "skipped_existing": skipped_existing,
        }, indent=2))
        return 0

    if not missing:
        print("No missing expected strategy-class artifacts — coverage is satisfied.")
        return 0

    def _line(name: str, char: str | None) -> str:
        return f"       - {name}" + ("" if char is None else f"  (required — {char} recorded)")

    if not recorded:
        print("Note: structural characteristics are not yet recorded (layer 0). Recording them")
        print("      first (/prawduct:methodology discovery) may add characteristic-triggered")
        print("      artifacts to this set.")
    if apply:
        print(f"coverage-scaffold — created {len(created)} stub file(s) in .prawduct/artifacts/:")
        for name, char in missing:
            if name in created:
                print(_line(name, char))
        if skipped_existing:
            print(f"  skipped {len(skipped_existing)} existing file(s): {', '.join(skipped_existing)}")
        print("Fill each with a real spec or a '(not relevant — <reason>)' decision, then git add them.")
    else:
        print(f"coverage-scaffold (dry run) — would create {len(missing)} stub file(s) in .prawduct/artifacts/:")
        for name, char in missing:
            print(_line(name, char))
        print("Each stub is a neutral placeholder for you to fill (a real spec, or a")
        print("'(not relevant — <reason>)' decision). Re-run with --apply to create them.")
    return 0


def cmd_resolve_base(project_dir: Path) -> int:
    """Print the resolved diff/merge base for the PR/coverage gates and the
    reviewer/cumulative diff.

    The plugin critic/pr skills call this so the reviewer's
    ``git merge-base "$(prawduct-hook resolve-base)" HEAD`` honors the same
    configured ``base_branch:`` (gitflow ``develop``) the gates use — one
    source of truth, no prose-driven base guessing (build-plan Chunk 5 gitflow
    fix; resolves the reviewer/cumulative half of the ship-blocker).

    Exit 0: prints the resolved base ref to stdout.
    Exit 1: prints the reason to stderr (configured base unresolvable, or no
    fallback candidate present) so callers fail closed to a full review.
    """
    base, reason = _coverage()._resolve_base_branch(project_dir)
    if base is None:
        print(reason, file=sys.stderr)
        return 1
    print(base)
    return 0


def cmd_bug_inbox(project_dir: Path) -> int:
    """Resolve the upstream bug-report inbox and print it, or exit 1 when none.

    The `/prawduct:report-bug` skill branches on the exit code: 0 = an inbox is
    configured and reachable (file the report into the printed path); 1 = no
    inbox (capture the bug in the product's own backlog + point at GitHub
    issues). Inert by design for plugin-only users — they configure neither
    ``PRAWDUCT_BUG_INBOX`` nor ``.prawduct/.bug-inbox``, so resolution returns
    None and this exits 1.

    Fail-soft: a missing/stale/unwritable inbox OR an incomplete plugin install
    (lib not importable) both resolve to exit 1, never a crash — the channel
    must stay silent and harmless in a repo that does not use it.
    """
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import bug_inbox  # noqa: PLC0415 — lazy keeps top-level lib-free
    except ImportError:
        return 1
    inbox = bug_inbox.resolve_inbox(os.environ, project_dir)
    if inbox is None:
        return 1
    print(inbox)
    return 0


def cmd_version() -> int:
    """Print the running prawduct plugin version (bare semver from the bundled
    ``.claude-plugin/plugin.json``) and exit 0; exit 1 if the manifest is
    unreadable.

    The **deterministic version source** consumers stamp into upstream bug reports
    (the ``Found in: prawduct vX.Y.Z`` field — XP2 provenance / the MG5 report-bug
    path) instead of *recalling* a version from the model. A recalled version
    drifts silently as the plugin updates; this one is read from the manifest at
    call time. Output is one bare line (``3.1.0``, no ``v`` prefix, no decoration)
    so a skill or script can capture it and format ``prawduct v<version>`` itself.
    """
    version = _plugin_manifest_version()
    if not version:
        return 1
    print(version)
    return 0


def cmd_stamp_merged(project_dir: Path) -> int:
    """Stamp ``status=merged`` onto statusless tagged change-log entries.

    DEPRECATED — no flow runs this anymore (single-pr-bookkeeping). A
    statusless tagged entry is first-class release-pending state: the entry
    rides in the feature PR, so its presence on the integration branch
    already proves the work is merged. The post-merge stamp commit this
    command fed forced consumers with protected integration branches into a
    second, bookkeeping-only PR. The command stays callable (stamping is
    harmless, convergent, and idempotent) and announces its deprecation on
    stderr; removal is deferred to a future major.

    Branch guard: stamping asserts "this work is integrated," which is only
    true ON the integration branch — running on a feature branch would lie.
    The current branch must equal the configured ``base_branch:`` (or ``main``
    when the knob is unset). Fails closed when the branch cannot be determined.

    Exit codes:
      0 - stamped (titles printed) or nothing to stamp
      1 - refused (not on the integration branch / branch undeterminable) or
          the plugin lib/ could not be imported (state-mutating command must
          not claim success on a broken install — mirrors regen-views)
      2 - I/O error (missing/unreadable change-log)
    """
    print(
        "deprecated: stamp-merged is no longer part of any flow — a "
        "statusless tagged entry IS the release-pending state, and the "
        "release checklist flips statusless and merged entries alike. "
        "Stamping remains harmless; the command may be removed in a future "
        "major version.",
        file=sys.stderr,
    )
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import views  # noqa: PLC0415 — lazy import keeps top-level cheap
        from lib.core import read_str_yaml_key  # noqa: PLC0415
    except ImportError:
        print(
            "error: stamp-merged could not import the plugin lib/ from "
            "${CLAUDE_PLUGIN_ROOT}; change-log not stamped.",
            file=sys.stderr,
        )
        return 1

    prawduct_dir = get_prawduct_dir(project_dir)
    configured = read_str_yaml_key(
        prawduct_dir / "project-state.yaml", "base_branch"
    )
    integration_branch = configured or "main"
    # REL-7P3X: project-state.yaml's own comment calls `origin/develop`
    # "preferred", but this guard compares against the LOCAL branch name from
    # `git rev-parse --abbrev-ref HEAD` (a deliberate divergence from
    # `_resolve_base_branch`, on record in the 2026-06-10 ch.02 Critic
    # findings). Strip a single leading `origin/` so an origin-prefixed config
    # normalizes to the local branch instead of refusing permanently.
    if integration_branch.startswith("origin/"):
        integration_branch = integration_branch[len("origin/"):]
    proc = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"],
        cwd=str(project_dir),
        capture_output=True,
        text=True,
        timeout=30,
    )
    current = proc.stdout.strip() if proc.returncode == 0 else ""
    if not current or current == "HEAD":
        print(
            "refusing: current branch could not be determined (detached HEAD "
            "or not a git repo) — stamp-merged runs on the integration branch.",
            file=sys.stderr,
        )
        return 1
    if current != integration_branch:
        print(
            f"refusing: current branch {current!r} is not the integration "
            f"base {integration_branch!r} — status=merged asserts the work is "
            f"integrated; run stamp-merged after the merge, on the base branch.",
            file=sys.stderr,
        )
        return 1

    change_log_path = prawduct_dir / "change-log.md"
    try:
        content = change_log_path.read_text(encoding="utf-8")
    except OSError as e:
        print(f"ERROR reading change-log: {e}", file=sys.stderr)
        return 2
    new_content, stamped = views.stamp_merged(content)
    if not stamped:
        print("nothing to stamp: no statusless tagged entries.")
        return 0
    try:
        change_log_path.write_text(new_content, encoding="utf-8")
    except OSError as e:
        print(f"ERROR writing change-log: {e}", file=sys.stderr)
        return 2
    for title in stamped:
        print(f"stamped status=merged: {title}")
    return 0


