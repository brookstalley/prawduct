#!/usr/bin/env python3
"""
prawduct-hook — Session governance, plugin runtime (v2.0.0 distribution).

The plugin-distribution port of ``tools/product-hook`` (build-plan Chunk 5).
Same governance, two structural gates, NO file-sync:
1. Reflection: files modified -> reflection must be captured before session end
2. Critic review: code built against a plan -> independent review must happen

Differences from the legacy ``tools/product-hook`` (the file-sync runtime):
  * Ships in the plugin's ``bin/`` (auto-added to the Bash PATH); skills invoke
    it as bare ``prawduct-hook``, hooks via ``${CLAUDE_PLUGIN_ROOT}/bin/``.
  * Imports the bundled governance ``lib/`` via ``CLAUDE_PLUGIN_ROOT`` (see
    ``_plugin_root``), not a ``tools/``-relative path.
  * Does NOT sync. The plugin ships immutable, read-only code; framework updates
    arrive via marketplace auto-update, not file-sync (design §2, §7). The
    sync-trigger cluster (``try_sync`` + freshness/version checks) is excluded.
  * Honors a configured ``base_branch:`` (gitflow ``develop``) for the PR /
    coverage gates and the reviewer/cumulative base (``_resolve_base_branch`` +
    the ``resolve-base`` subcommand) — the 2.0.0 gitflow ship-blocker fix.

Governing invariant (design §2): reads/writes ONLY the governed repo's
``.prawduct/`` — the session's active git worktree, resolved by
``get_project_dir`` (the worktree toplevel of cwd, or ``${CLAUDE_PROJECT_DIR}``
when not in a same-repo worktree; STH-4K7N). No mutable state is shared between
*unrelated* repos through the plugin — the resolver's same-repo
``--git-common-dir`` guard preserves that.

Usage (wired by ``hooks/hooks.json``):
  python3 "${CLAUDE_PLUGIN_ROOT}/bin/prawduct-hook" clear   (SessionStart hook)
  python3 "${CLAUDE_PLUGIN_ROOT}/bin/prawduct-hook" stop    (Stop hook)
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


def get_project_dir() -> Path:
    """Resolve the project dir to the session's active git worktree.

    Was ``CLAUDE_PROJECT_DIR`` (or cwd). The harness pins ``CLAUDE_PROJECT_DIR``
    to the launch dir, but a session that moves into a git worktree operates —
    and writes ``.prawduct/`` state — from the worktree; resolving against the
    worktree keeps the hooks reading the same state the agent wrote (STH-4K7N).
    Delegates to the shared resolver so bin and lib agree; the resolver fails
    open to ``CLAUDE_PROJECT_DIR``/cwd so non-worktree sessions are unchanged.

    Bootstrap-resilient: this runs before command dispatch, so a broken/absent
    plugin ``lib/`` must not crash here — fall back to the env/cwd behavior and
    let the command that actually needs ``lib`` surface the import error with its
    own handling (e.g. ``coverage-scaffold``)."""
    try:
        gitstate = _gitstate()
    except ImportError:
        return Path(os.environ.get("CLAUDE_PROJECT_DIR", ".")).resolve()
    return gitstate.resolve_project_dir(
        os.environ.get("CLAUDE_PROJECT_DIR"), Path.cwd()
    )


def get_prawduct_dir(project_dir: Path) -> Path:
    return project_dir / ".prawduct"


def _plugin_root() -> str:
    """Resolve the plugin root for importing the bundled governance ``lib/``.

    Prefers ``CLAUDE_PLUGIN_ROOT`` (exported by Claude Code into the hook
    process and the Bash tool env while the plugin is enabled). Falls back to
    the parent of this script's dir (``bin/`` -> root) so the hook is runnable
    directly (tests, ``--plugin-dir`` probes) without the env var. Returns a
    ``str`` for ``sys.path`` insertion; ``from lib import …`` then resolves to
    ``${root}/lib`` (design §11: plugin Python must seed ``sys.path`` itself).
    """
    env_root = os.environ.get("CLAUDE_PLUGIN_ROOT")
    if env_root:
        return env_root
    return str(Path(__file__).resolve().parent.parent)


def _gitstate():
    """Lazy-import the read-only git/state probes (lib/gitstate). Seeds sys.path
    like the other lib accessors so the hook's top level stays lib-free; after the
    lib/__init__ slim (ch.1) this loads only gitstate.py (~1ms, isolated)."""
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    from lib import gitstate  # noqa: PLC0415 — lazy keeps top-level cheap + lib-free

    return gitstate


