def cmd_check_releasability(project_dir: Path, args: list[str] | None = None) -> int:
    """Phase 0 releasability gate for the release runbook (REL-8P6M part f).

    Answers the question the runbook never asked — *is everything on
    ``develop`` fit to ship?* — by requiring every release-pending scope to be
    classified as shipping or withheld behind a named open blocker. Thin
    wrapper; the body lives in ``lib.release_readiness``, reached lazily so the
    hook's top level stays lib-free."""
    usage = "usage: prawduct-hook check-releasability [--release vX.Y.Z]"
    release = None
    argv = list(args or [])
    i = 0
    # Explicit scan rather than ``"--release" in argv``: that pattern silently
    # discards every token it doesn't recognize, so a typo or a bare positional
    # would fall through to the plugin/VERSION fallback and grade a DIFFERENT
    # release than the operator named — the same swallow STH-5R2Q fixed for
    # flag-only subcommands. Unknown tokens are usage errors (exit 2), never
    # ignored, because this gate's whole job is to refuse to guess.
    while i < len(argv):
        token = argv[i]
        if token == "--release":
            if i + 1 >= len(argv):
                print(f"{usage}\n--release requires a version argument", file=sys.stderr)
                return 2
            release = argv[i + 1]
            i += 2
            continue
        if token.startswith("--release="):
            release = token.split("=", 1)[1]
            if not release:
                print(f"{usage}\n--release requires a version argument", file=sys.stderr)
                return 2
            i += 1
            continue
        print(f"unknown argument: {token}\n{usage}", file=sys.stderr)
        return 2
    return _release_readiness().check_releasability(project_dir, release)


