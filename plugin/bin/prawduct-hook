def cmd_infer_critic_mode(project_dir: Path, args: str | None) -> int:
    """Print ``<mode>|<rationale>`` for the inferred ``/prawduct:critic`` mode.

    Thin wrapper around ``lib.critic_mode.infer_mode`` (v1.5
    Chunk 03). The subcommand exists so the Critic SKILL can call
    inference without expanding its ``allowed-tools`` to ``Bash(python3
    -c *)`` — keeping the structural "no arbitrary code execution"
    constraint enforceable.

    Precedence (delegated to ``infer_mode``): explicit ``args`` (the
    per-invocation override) win first, then the active build plan's
    CURRENT chunk ``**Critic mode:**`` field (the plan-level "successive
    override", rationale ``plan-override: <mode>`` — CRT-3M8Q), then the
    four inference rules. This is why a plan-mandated ``final`` is now
    honored here instead of being silently demoted to the inferred
    ``chunk``.

    Output format: a single stdout line ``<mode>|<rationale>`` where
    ``<mode>`` is one of the short tokens (``chunk`` / ``final`` /
    ``cumulative`` / ``verify-resolutions``) and ``<rationale>`` is the
    human-readable explanation suitable for both stdout reporting and
    the ``mode_chosen_by`` field in ``.critic-findings.json``.

    Fail-safe: if the bundled ``lib/`` cannot be imported (an incomplete plugin
    install), print a clear message and return 1 rather than crashing — mirroring
    ``cmd_advisory``. The Critic SKILL treats a non-zero exit as inference
    failure and defaults to ``final`` (fail-safe to thoroughness).
    """
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import infer_mode  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "infer-critic-mode unavailable (could not import the plugin lib/ from "
            "${CLAUDE_PLUGIN_ROOT})",
            file=sys.stderr,
        )
        return 1
    mode, rationale = infer_mode(project_dir, args)
    print(f"{mode}|{rationale}")
    # PDT-WT9K: name the resolved tree on stderr (stdout stays the machine-read
    # `<mode>|<rationale>` line the skill parses) so a wrong-tree inference is
    # visible before the review is even dispatched.
    branch = _gitstate().current_branch(project_dir)
    print(
        f"PRAWDUCT: inferring against worktree {project_dir} "
        f"branch {branch or '(detached)'}.",
        file=sys.stderr,
    )
    return 0


def cmd_advisory(project_dir: Path, argv: list[str]) -> int:
    """Dispatch the ``/prawduct:advisory`` management CLI (spec §6, Chunk 05).

    Thin wrapper around the bundled ``lib.advisory_cmd.run`` — the subcommand
    exists so the skill's ``allowed-tools`` can be scoped to
    ``Bash(prawduct-hook advisory*)`` instead of arbitrary code execution,
    mirroring the ``infer-critic-mode`` pattern. ``argv`` is ``sys.argv[2:]``
    (everything after ``advisory``).

    Fail-safe: if the bundled lib/ cannot be imported (an incomplete plugin
    install), print a clear message and return 1 rather than crashing — the
    advisory CLI is informational, never a gate.
    """
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import advisory_cmd  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "advisory CLI unavailable (could not import the plugin lib/ from "
            "${CLAUDE_PLUGIN_ROOT})",
            file=sys.stderr,
        )
        return 1
    return advisory_cmd.run(project_dir, argv)


def cmd_backlog(project_dir: Path, argv: list[str]) -> int:
    """Dispatch the ``prawduct-hook backlog <op>`` CLI (the backlog service).

    Thin wrapper around the bundled ``lib.backlog.cli.run`` — one entry point (a
    subcommand group, not a second binary; API §1/O5), so there is a single
    platform-exposure/PATH surface. ``argv`` is ``sys.argv[2:]`` (everything after
    ``backlog``); the per-subcommand import stays lazy so other commands pay no
    startup cost.

    Fail-safe: if the bundled lib/ cannot be imported (an incomplete plugin
    install), print a clear message and return 1 rather than crashing.
    """
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib.backlog import cli as backlog_cli  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "backlog CLI unavailable (could not import the plugin lib/ from "
            "${CLAUDE_PLUGIN_ROOT})",
            file=sys.stderr,
        )
        return 1
    return backlog_cli.run(project_dir, argv)


def _coverage_scaffold_stub(artifact_name: str) -> str:
    """A neutral placeholder for a missing strategy-class artifact.

    It deliberately does NOT pre-fill ``(not relevant)`` — whether an artifact is
    relevant is the owner's decision to record, not the tool's to guess. Coverage
    is satisfied by the file existing (any content), so dropping this stub clears
    the layer-1 nudge and leaves the owner to fill it: a real spec, or a one-line
    ``(not relevant — <reason>)`` decision the Critic can then weigh."""
    title = artifact_name.removesuffix(".md").replace("-", " ").title()
    return (
        f"# {title}\n\n"
        "<!--\n"
        "Strategy-class artifact expected by structural coverage. Replace this stub\n"
        "with EITHER a real specification, OR a one-line decision that it is not\n"
        "relevant to this product, for example:\n\n"
        "    (Not relevant — <reason>.)\n\n"
        "Coverage is satisfied by this file existing; the Critic and risk\n"
        "calibration judge whether the decision holds. See /prawduct:methodology planning.\n"
        "-->\n\n"
        "_Unwritten stub — author this artifact, or record why it is not relevant._\n"
    )


def cmd_coverage_status(project_dir: Path, argv: list[str]) -> int:
    """Report the structural-coverage chain status (the doctor coverage check).

    Reports all three layers of the coverage chain, reading the SAME expectation
    table the probe fires on (``lib/coverage_probes.missing_expected_artifacts``) —
    never a transcription, so the doctor check can't drift from the nudge:

      - **Layer 0 (discovery):** are structural characteristics recorded?
      - **Layer 1 (artifacts):** which expected strategy-class artifacts are missing?
      - **Layer 2 (norms):** are the product's norms ratified?

    and names the highest-priority active layer as the primary fix. Layers 0 and 1
    are mutually exclusive (never both — and possibly neither, on a repo that has
    not started), but layer 2's gate is independent, so
    during partial authoring layers 1 and 2 can both be active (docs/norms.md
    § Enforcement — proportionality, not a hard one-at-a-time invariant). ``--json``
    emits the structured status for the doctor skill; default is human-readable.

    Read-only and informational — always exits 0. A broken plugin import or a
    faulty sub-check degrades to a NOTE / "unknown", never a crash (a health
    *report* must not fail the operator's shell)."""
    # Read-only, so a swallowed token cannot mutate here — but it can still make
    # the report answer a question nobody asked, which is the same class the
    # pre-dispatch guard closes for the commands that take no argv at all.
    rejected = _reject_unknown_args("coverage-status", argv, {"--json"})
    if rejected is not None:
        return rejected
    want_json = "--json" in argv
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import coverage_probes as cp  # noqa: PLC0415 — lazy keeps top-level cheap
        from lib import advisory_store as store  # noqa: PLC0415
        from lib import norm_probes  # noqa: PLC0415
    except ImportError as exc:
        print(f"NOTE: coverage-status unavailable (plugin lib/ not importable: {exc})", file=sys.stderr)
        return 0

    codebase = store.make_codebase(project_dir)
    # Layers 0-1 in one evaluation (each predicate walks the tree; layer_status pays
    # for each once). Guarded like layer 2 below and for the same reason — this
    # function promises a health REPORT, and a report that raises has failed harder
    # than one that says "unknown". `staging` reads None-per-key when it could not
    # run, and every consumer below discriminates on that.
    staging: dict = {}
    try:
        staging = cp.layer_status(codebase)
    except Exception as exc:  # prawduct:allow prawduct/broad-except -- report must not crash; degrade layers 0-1 to unknown + log
        print(f"NOTE: coverage-status layers 0-1 (staging) check skipped: {exc}", file=sys.stderr)
    recorded = staging.get("structural_recorded")
    missing = staging.get("missing") or []  # [(name, characteristic|None)]
    # Whether discovery is owed YET. False means "no product work this scan
    # RECOGNISES" (the source-suffix allowlist, #561), never "this repo is empty" —
    # every rendering below is worded to that, because the one population it is
    # wrong about is a repo full of source in an unlisted language.
    expected = staging.get("discovery_expected")

    # Layer 2 composes over the norm probe (its own gate is "strategy artifacts
    # exist AND registry unratified"). The probe is declared non-raising, but a
    # health report must not crash on a malformed state, so degrade to "unknown"
    # and NAME the reason on stderr rather than swallow it.
    norms_unratified: bool | None
    try:
        proj_state = store.load_project_state(project_dir)
        norms_unratified = bool(norm_probes.probe_norm_registry_unratified(proj_state, codebase))
    except Exception as exc:  # prawduct:allow prawduct/broad-except -- report must not crash; degrade layer 2 to unknown + log
        print(f"NOTE: coverage-status layer-2 (norm ratification) check skipped: {exc}", file=sys.stderr)
        norms_unratified = None

    # Which single layer currently owns the nudge (the chain stages). Layers 0 and 1
    # are asked of the probe module, never re-derived here: this report's whole claim
    # is that it mirrors the ambient nudge, and it earns that only by composing the
    # same predicates the probes fire on.
    if staging.get("layer0_active"):
        active_layer: int | None = 0
        fix: str | None = "record structural characteristics: /prawduct:methodology discovery"
    elif staging.get("layer1_active"):
        active_layer = 1
        fix = ("author each missing artifact (/prawduct:methodology planning), or drop stubs "
               "in one act: prawduct-hook coverage-scaffold --apply")
    elif norms_unratified:
        active_layer = 2
        fix = "ratify the product's norms via /prawduct:doctor"
    else:
        active_layer = None
        fix = None

    if want_json:
        import json as _json  # noqa: PLC0415
        print(_json.dumps({
            "structural_recorded": recorded,
            "discovery_expected": expected,
            "missing_artifacts": [{"artifact": name, "characteristic": char} for name, char in missing],
            "norms_unratified": norms_unratified,
            "active_layer": active_layer,
            "fix": fix,
        }, indent=2))
        return 0

    print("Structural coverage (three-layer chain):")
    if not staging:
        print("  Layer 0 · discovery         : unknown (staging check unavailable)")
        print("  Layer 1 · strategy artifacts : unknown (staging check unavailable)")
    else:
        if recorded:
            print("  Layer 0 · discovery         : characteristics RECORDED")
        elif expected:
            print("  Layer 0 · discovery         : characteristics NOT RECORDED")
        else:
            # Unrecorded AND nothing recognised to characterise. A bare "NOT
            # RECORDED" reads as the finding it is not — but the scan sees source
            # by suffix, so the honest claim is about what it FOUND, not about what
            # is there (#561).
            print("  Layer 0 · discovery         : characteristics NOT RECORDED "
                  "(not owed yet — no source code or docs/ that this scan recognises)")
        if missing:
            print(f"  Layer 1 · strategy artifacts : {len(missing)} expected artifact(s) missing")
            for name, char in missing:
                suffix = "" if char is None else f"  (required — {char} recorded)"
                print(f"       - {name}{suffix}")
        else:
            print("  Layer 1 · strategy artifacts : all expected artifacts present")
    if norms_unratified is None:
        print("  Layer 2 · norm ratification : unknown (norm check unavailable)")
    elif norms_unratified:
        print("  Layer 2 · norm ratification : norms not yet ratified")
    else:
        print("  Layer 2 · norm ratification : ratified or not yet applicable")
    if active_layer == 2 and not staging:
        # Layer 2 is real, but it sits DOWNSTREAM of two layers that were never
        # evaluated — naming it "the" fix would claim a chain position nothing
        # checked. Same refusal the mirror case below already makes.
        print(f"  Active nudge → Layer 2: {fix}")
        print("    (layers 0-1 could not be checked, so this may not be the first thing owed)")
    elif active_layer is not None:
        print(f"  Active nudge → Layer {active_layer}: {fix}")
    elif not staging:
        print("  Active nudge → none actionable: layers 0-1 could not be checked.")
    elif norms_unratified is None:
        # Layers 0-1 satisfied, but layer 2 couldn't be checked — don't claim the
        # whole chain is satisfied (the --json consumer discriminates on the
        # norms_unratified: null field; the human reader gets this explicit line).
        print("  Active nudge → none actionable: layers 0-1 satisfied; layer 2 (norms) could not be checked.")
    elif not expected and not recorded:
        # "Satisfied" would be a false clean bill: nothing has been asked of this
        # repo yet. Name what starts the chain instead.
        print("  Active nudge → none: no product work found yet — the chain engages "
              "once the repo has source code or docs/.")
    else:
        print("  Active nudge → none: the coverage chain is satisfied.")
    return 0


def cmd_coverage_scaffold(project_dir: Path, argv: list[str]) -> int:
    """Drop stub files for the expected-but-missing strategy-class artifacts.

    The coverage forcing function nudges a product to author (or explicitly
    decline) each strategy-class artifact. Resolving several at once should be a
    30-second confirm-and-fill, not a chore — this drops a neutral stub for each
    missing expected artifact in one act, which the owner then fills with a real
    spec or a one-line ``(not relevant — <reason>)`` decision.

    Default is a **DRY RUN**: it lists what it WOULD create and changes nothing.
    ``--apply`` writes the stubs. Two guarantees keep the owner in control: the
    framework never silently auto-stubs (``--apply`` is the owner's confirm — that
    a relevance decision is theirs to make, not the tool's to default), and it
    never overwrites an existing file (an authored artifact or a prior stub is left
    untouched). Reads the SAME expectation table as the probe and the status check
    (``lib/coverage_probes.missing_expected_artifacts``).

    Exit 0 on dry run or successful ``--apply``; exit 1 if the plugin ``lib/`` is
    not importable (a state-mutating command must not claim success on a broken
    install — mirrors ``accept-operator-verification``)."""
    # This command MUTATES under `--apply`, and the flag-only idiom below reads a
    # token it does not recognise as absent. So `--apply --dry-run` wrote the
    # stubs while the caller believed they had asked for a preview — the same
    # surprise `update-gitignore` served, in the command held up as its
    # well-behaved sibling. `--dry-run` is not accepted here because the bare
    # invocation already IS the dry run; the point is that it is refused rather
    # than ignored.
    rejected = _reject_unknown_args("coverage-scaffold", argv, {"--apply", "--json"})
    if rejected is not None:
        return rejected
    apply = "--apply" in argv
    want_json = "--json" in argv
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import coverage_probes as cp  # noqa: PLC0415 — lazy keeps top-level cheap
        from lib import advisory_store as store  # noqa: PLC0415
    except ImportError as exc:
        print(f"error: coverage-scaffold could not import the plugin lib/ ({exc})", file=sys.stderr)
        return 1

    state_path = project_dir / ".prawduct" / "project-state.yaml"
    codebase = store.make_codebase(project_dir)
    recorded = cp.structural_characteristics_recorded(state_path)
    missing = cp.missing_expected_artifacts(codebase)  # [(name, characteristic|None)]
    artifacts_dir = project_dir / ".prawduct" / "artifacts"

    created: list[str] = []
    skipped_existing: list[str] = []
    if apply and missing:
        try:
            artifacts_dir.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            print(f"error: could not create {artifacts_dir} ({exc})", file=sys.stderr)
            return 1
        for name, _char in missing:
            dest = artifacts_dir / name
            if dest.exists():  # never overwrite — an authored artifact or prior stub stays
                skipped_existing.append(name)
                continue
            try:
                _core().atomic_write_text(dest, _coverage_scaffold_stub(name))
                created.append(name)
            except OSError as exc:
                print(f"NOTE: could not write {dest} ({exc})", file=sys.stderr)

    if want_json:
        import json as _json  # noqa: PLC0415
        print(_json.dumps({
            "structural_recorded": recorded,
            "missing_artifacts": [{"artifact": name, "characteristic": char} for name, char in missing],
            "applied": apply,
            "created": created,
            "skipped_existing": skipped_existing,
        }, indent=2))
        return 0

    if not missing:
        print("No missing expected strategy-class artifacts — coverage is satisfied.")
        return 0

    def _line(name: str, char: str | None) -> str:
        return f"       - {name}" + ("" if char is None else f"  (required — {char} recorded)")

    if not recorded:
        print("Note: structural characteristics are not yet recorded (layer 0). Recording them")
        print("      first (/prawduct:methodology discovery) may add characteristic-triggered")
        print("      artifacts to this set.")
    if apply:
        print(f"coverage-scaffold — created {len(created)} stub file(s) in .prawduct/artifacts/:")
        for name, char in missing:
            if name in created:
                print(_line(name, char))
        if skipped_existing:
            print(f"  skipped {len(skipped_existing)} existing file(s): {', '.join(skipped_existing)}")
        print("Fill each with a real spec or a '(not relevant — <reason>)' decision, then git add them.")
    else:
        print(f"coverage-scaffold (dry run) — would create {len(missing)} stub file(s) in .prawduct/artifacts/:")
        for name, char in missing:
            print(_line(name, char))
        print("Each stub is a neutral placeholder for you to fill (a real spec, or a")
        print("'(not relevant — <reason>)' decision). Re-run with --apply to create them.")
    return 0


def cmd_resolve_base(project_dir: Path) -> int:
    """Print the resolved diff/merge base for the PR/coverage gates and the
    reviewer/cumulative diff.

    The plugin critic/pr skills call this so the reviewer's
    ``git merge-base "$(prawduct-hook resolve-base)" HEAD`` honors the same
    configured ``base_branch:`` (gitflow ``develop``) the gates use — one
    source of truth, no prose-driven base guessing (build-plan Chunk 5 gitflow
    fix; resolves the reviewer/cumulative half of the ship-blocker).

    Exit 0: prints the resolved base ref to stdout.
    Exit 1: prints the reason to stderr (configured base unresolvable, or no
    fallback candidate present) so callers fail closed to a full review.
    """
    base, reason = _coverage()._resolve_base_branch(project_dir)
    if base is None:
        print(reason, file=sys.stderr)
        return 1
    print(base)
    return 0


def cmd_bug_inbox(project_dir: Path) -> int:
    """Resolve the upstream bug-report inbox and print it, or exit 1 when none.

    The `/prawduct:report-bug` skill branches on the exit code: 0 = an inbox is
    configured and reachable (file the report into the printed path); 1 = no
    inbox (capture the bug in the product's own backlog + point at GitHub
    issues). Inert by design for plugin-only users — they configure neither
    ``PRAWDUCT_BUG_INBOX`` nor ``.prawduct/.bug-inbox``, so resolution returns
    None and this exits 1.

    Fail-soft: a missing/stale/unwritable inbox OR an incomplete plugin install
    (lib not importable) both resolve to exit 1, never a crash — the channel
    must stay silent and harmless in a repo that does not use it.
    """
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import bug_inbox  # noqa: PLC0415 — lazy keeps top-level lib-free
    except ImportError:
        return 1
    inbox = bug_inbox.resolve_inbox(os.environ, project_dir)
    if inbox is None:
        return 1
    print(inbox)
    return 0


def cmd_version() -> int:
    """Print the running prawduct plugin version (bare semver from the bundled
    ``.claude-plugin/plugin.json``) and exit 0; exit 1 if the manifest is
    unreadable.

    The **deterministic version source** consumers stamp into upstream bug reports
    (the ``Found in: prawduct vX.Y.Z`` field — XP2 provenance / the MG5 report-bug
    path) instead of *recalling* a version from the model. A recalled version
    drifts silently as the plugin updates; this one is read from the manifest at
    call time. Output is one bare line (``3.1.0``, no ``v`` prefix, no decoration)
    so a skill or script can capture it and format ``prawduct v<version>`` itself.
    """
    version = _plugin_manifest_version()
    if not version:
        return 1
    print(version)
    return 0


def cmd_print_install_reference() -> int:
    """Print the canonical install reference as JSON on stdout; exit 0, or 1 if
    the constant cannot be imported.

    **The published form of how a repo references this plugin.** The value
    itself is not new — ``migrate_plugin.INSTALL_REFERENCE`` has been the one
    statement of it all along, and ``init_product`` merges the same dict into a
    repo's ``.claude/settings.json``. What was missing was any way to *read* it
    without importing a private module: no export, no JSON, no subcommand. Two
    independent external consumers therefore arrived at AST-parsing the
    constant within a week of each other, one of them the tool that repaired 11
    repos after a hand-transcribed copy went stale. Both picked parsing over
    transcribing deliberately, because a copy drifts silently — so the fragile
    option was the *safer* of the two on offer, which is the tell that the
    surface was missing rather than that the consumers were careless.

    A subcommand rather than a committed JSON file or a documented import: the
    hook binary is already on PATH, so this is introspectable from a repo that
    has the plugin installed but not vendored, which is the normal case.

    This publishes the value; it does not re-decide it. The marketplace ``ref``
    and ``autoUpdate`` ship exactly as the constant holds them, and a consumer
    reading this gets whatever the installed plugin believes — which is the
    entire point, since a consumer that pinned its own copy is the failure
    being closed. Emitted with sorted keys and a trailing newline so a caller
    can diff two versions' output directly.
    """
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib.migrate_plugin import INSTALL_REFERENCE  # noqa: PLC0415 — lazy, like every other lib reader
    except ImportError as exc:
        print(f"error: could not read the install reference: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(INSTALL_REFERENCE, indent=2, sort_keys=True))
    return 0


def cmd_stamp_merged(project_dir: Path) -> int:
    """DEPRECATED and inert — prints a notice, writes nothing, exits 0.

    This stamped ``status=merged`` onto tagged change-log entries. It had already
    been removed from every flow before being emptied here: a statusless tagged
    entry IS the release-pending state, since the entry rides in the feature PR
    and its presence on the integration branch already proves the work merged.
    The post-merge stamp commit it fed forced consumers with protected
    integration branches into a second, bookkeeping-only PR.

    **Why the body went and not just the flow.** ``status=`` had exactly one
    reader — the derived-view regeneration — and that reader is retired. A
    command whose sole effect is writing a key nothing reads is not harmless
    bookkeeping; it is a channel produced and never consumed, and the next reader
    of a stamped entry would reasonably infer a consumer exists. Kept callable
    and signalled, per ``api-contract.md``'s deprecation norm, on the same
    reasoning as ``regen-views``: removal defers to a major.

    The branch guard went with the body. It existed because stamping asserted
    "this work is integrated", which is only true on the integration branch —
    an assertion nothing makes anymore. Exits 0 everywhere, so a checklist that
    still calls this does not break.
    """
    del project_dir  # kept so the dispatcher's call site is unchanged
    print(
        "WARNING: stamp-merged no longer does anything and will be removed in a "
        "future major version. A tagged change-log entry with no release marker "
        "is already the record that work is merged and not yet shipped, so there "
        "is nothing to stamp. If a checklist still calls this command, drop the "
        "call.",
        file=sys.stderr,
    )
    return 0


def cmd_build_index(project_dir: Path, argv: list[str] | None = None) -> int:
    """DEPRECATED and inert — writes nothing, prints nothing to stdout, exits 0.

    This warmed the work-model vocabulary index on SessionStart. The index and
    the undocumented-term tripwire it fed were deleted at v3.3.2; enforcement
    moved to the review-time ``scope-trace:`` question. There is nothing left to
    build.

    **Why it is still callable, when v3.3.2 deleted it outright.** Its caller is
    a pre-3.3.2 ``hooks.json``, and the harness pins a plugin version per project
    and updates those pins lazily — so a repo routinely runs an old registration
    against a new binary. The deprecation norm, its falsified warrant and the
    retention rule all live at ``.prawduct/artifacts/api-contract.md`` § Direction
    (additive-first evolution); this docstring cites it rather than restating it,
    because the last copy of that reasoning to live in a docstring is the one
    that went wrong.

    **Silent, unlike ``regen-views`` and ``stamp-merged``.** They warn because a
    human reads their output and can drop the call; nobody reads this one, so a
    notice has no audience. **Nothing may reach stdout** — a SessionStart hook's
    stdout is injected into the model's context.

    Exit 0 unconditionally, including for unknown flags. Membership in
    ``_EPHEMERAL_SAFE_COMMANDS`` is what makes that true inside a disposable
    worktree, where the fail-closed guard would otherwise refuse it.
    """
    del project_dir, argv  # kept so the dispatcher's call site is unchanged
    return 0


def cmd_user_prompt_submit(project_dir: Path, argv: list[str] | None = None) -> int:
    """DEPRECATED and inert — writes nothing, prints nothing to stdout, exits 0.

    This was the UserPromptSubmit tripwire that named salient terms in a prompt
    which no governing artifact covered. It was deleted at v3.3.2 for reporting
    contractions and mis-stemmed non-words as domain vocabulary; the owner's
    ruling (#257) was deletion, not another precision fix.

    Kept callable for the reason given in :func:`cmd_build_index`, which cites
    the governing norm. This one is the sharper case of the two: UserPromptSubmit
    fires on **every turn**, so the skew produced an error line per prompt rather
    than one per session.

    **Silence here is a correctness requirement, not courtesy.** A
    UserPromptSubmit hook that exits 0 has its stdout injected into the model's
    context ahead of the user's prompt, so anything printed there would be read
    as instruction on every single turn.

    Does not read stdin: the payload is the prompt itself and there is nothing to
    do with it. The harness tolerated an unread stdin here before this change too
    — the pre-fix usage branch also exited without reading — but if a report ever
    shows a writer-side EPIPE on a large prompt, one guarded ``sys.stdin.read()``
    is the fix and this sentence is where to revisit it. Exits 0 for any argv.
    """
    del project_dir, argv  # kept so the dispatcher's call site is unchanged
    return 0


def cmd_migrate_plugin(project_dir: Path, argv: list[str]) -> int:
    """Dispatch the file-sync → plugin cutover (``/prawduct:migrate``, Chunk 9).

    Thin wrapper around the plugin-native ``lib.migrate_plugin.run`` — the
    subcommand exists so the skill's ``allowed-tools`` can be scoped to
    ``Bash(prawduct-hook migrate-plugin*)`` instead of arbitrary code execution,
    mirroring the ``advisory``/``infer-critic-mode`` pattern. ``argv`` is
    ``sys.argv[2:]`` (``--apply`` / ``--json``); defaults to a safe dry run.

    Fail-safe: if the bundled lib/ cannot be imported (an incomplete plugin
    install), print a clear message and return 1 rather than crashing.
    """
    rejected = _reject_unknown_args("migrate-plugin", argv, {"--apply", "--json"})
    if rejected is not None:
        return rejected
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import migrate_plugin  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "migrate unavailable (could not import the plugin lib/ from "
            "${CLAUDE_PLUGIN_ROOT})",
            file=sys.stderr,
        )
        return 1
    return migrate_plugin.run(project_dir, argv)


def cmd_init_product(argv: list[str]) -> int:
    """Scaffold a new or existing plugin-governed product repo (``/prawduct:onboard``).

    Thin wrapper around the plugin-native ``lib.init_product.run``. Unlike the other
    subcommands it operates on a TARGET path passed in ``argv`` (the new repo),
    not the current project dir — onboarding creates a repo elsewhere. ``argv`` is
    ``sys.argv[2:]`` (``<target> --name "<name>" [--apply] [--json]``); defaults to
    a safe dry run. The scaffold creates only product-owned state + the install
    reference (design §3) — never any file-sync machinery.

    Fail-safe: if the bundled lib/ cannot be imported (an incomplete plugin
    install), print a clear message and return 1 rather than crashing.
    """
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import init_product  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "init-product unavailable (could not import the plugin lib/ from "
            "${CLAUDE_PLUGIN_ROOT})",
            file=sys.stderr,
        )
        return 1
    return init_product.run(argv)


def cmd_update_gitignore(project_dir: Path, argv: list[str]) -> int:
    """Reconcile ``.gitignore`` with the framework's session-file contract
    (``/prawduct:doctor`` repair step — gate-soundness ch.3).

    Adds missing session entries and strips lines that ignore managed files or
    RETIRED entries (the tracked-by-default build plan). ``init-product``
    early-exits on an already-scaffolded repo and the session hooks must never
    edit a tracked file (the no-noise guarantee), so this on-demand command is
    how an existing repo picks up gitignore-contract changes. Prints each
    unignored path so the caller can advise ``git add``.

    **Mutating by default, deliberately** — doctor calls it to REPAIR, so a
    preview-by-default would silently stop fixing the repos that need fixing.
    ``--dry-run`` is the opt-in preview: it reports the same three answers and
    leaves ``.gitignore`` byte-identical. Its siblings on the doctor flow
    (``coverage-scaffold``, ``lifecycle-repair``) are preview-by-default with
    ``--apply``, and the asymmetry is what made a caller expect a preview here
    and get a rewrite.

    Fail-safe: if the bundled lib/ cannot be imported (an incomplete plugin
    install), print a clear message and return 1 rather than crashing.
    """
    rejected = _reject_unknown_args("update-gitignore", argv, {"--dry-run"})
    if rejected is not None:
        return rejected
    dry_run = "--dry-run" in argv

    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import core as lib_core  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "update-gitignore unavailable (could not import the plugin lib/ "
            "from ${CLAUDE_PLUGIN_ROOT})",
            file=sys.stderr,
        )
        return 1
    result = lib_core.update_gitignore(project_dir, dry_run=dry_run)
    if dry_run:
        # Past tense would be a lie on this branch, and the caller is here
        # BECAUSE they wanted to know before anything moved.
        for path in result.get("unignored", []):
            print(f"would un-ignore: {path} — tracked-by-contract; `git add` it if present")
        for entry in result.get("missing", []):
            print(f"would ignore: {entry}")
        print(
            "would update .gitignore (re-run without --dry-run to apply)"
            if result.get("modified")
            else "no changes needed"
        )
        return 0
    if result.get("unignored"):
        for path in result["unignored"]:
            print(f"unignored: {path} — now tracked-by-contract; `git add` it if present")
    print("updated .gitignore" if result.get("modified") else "no changes needed")
    return 0


def cmd_learnings_obligation(project_dir: Path, argv: list[str]) -> int:
    """Check — and on ``--apply`` repair — the descent obligation in ``learnings.md``.

    ``/prawduct:learnings`` points every product's reader at the obligation marked
    ``prawduct:descent-obligation``; only ``init-product``'s starter corpus ever
    wrote that marker, and it writes it only when the file does not exist. So the
    entire already-onboarded fleet carries a pointer at nothing. This is the doctor
    health check that detects it (``/prawduct:doctor`` Health Check #13) and the
    repair that closes it.

    Exit codes follow ``artifacts/api-contract.md`` § Error Model. **Dry run is an
    advisory report:** 0 when it ran — a finding is not a failure — and 1 only when
    it could not run (lib not importable, file undecodable). **``--apply`` is a
    state-mutating writer:** 0 when it inserted or was an idempotent no-op, 1 when
    it refused (nothing written). Unknown flags are 2.
    """
    rejected = _reject_unknown_args("learnings-obligation", argv, {"--apply", "--json"})
    if rejected is not None:
        return rejected
    apply = "--apply" in argv
    as_json = "--json" in argv

    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import learnings_obligation  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError as exc:
        # Fail-closed for the writer, fail-open would be a false success; the dry
        # run cannot run either, so both directions are 1 here ("could not run").
        print(
            f"error: learnings-obligation could not import the plugin lib/ ({exc})",
            file=sys.stderr,
        )
        return 1

    result = learnings_obligation.repair(project_dir, apply=apply)
    status = result["status"]

    if as_json:
        print(json.dumps(result, indent=2))
    else:
        # Labelled from the MODE the operator asked for, not from whether a write
        # happened: `--apply` against a refused status (misplaced, absent,
        # unreadable) writes nothing, and calling that run "dry-run" invites the
        # reader to conclude they forgot the flag and re-run it. `status`/`detail`
        # say what actually happened.
        print(f"learnings-obligation ({'apply' if apply else 'dry-run'}): {status}")
        print(f"  {result['detail']}")
        if result["repairable"] and not result["applied"]:
            # The informed confirmation: name the file, the exact line, and the
            # exact text, so `--apply` is a yes to something the owner has read.
            print(
                f"  Would insert into {result['path']} above line "
                f"{result['insert_before_line']} (--apply to write it):"
            )
            for line in (result["insert_text"] or "").split("\n"):
                print(f"    | {line}")

    if apply:
        return 0 if result["applied"] or status == learnings_obligation.STATUS_OK else 1
    return 1 if status == learnings_obligation.STATUS_UNREADABLE else 0


def cmd_norm_index_scaffold(project_dir: Path, argv: list[str]) -> int:
    """Detect — and on ``--apply`` remove — leftover template scaffold rows (#570).

    `#567` stopped the norm-index table shipping illustrative rows, but
    `init_product`/`core.write_template` skip existing destinations, so the fix
    reaches new onboards only. Every already-onboarded repo keeps rows whose
    `Audit home`/`Why` cells are non-empty placeholders, reads as having a
    ratified registry, and gets nudged about a Norm Health sweep it owes nothing
    to. This is the doctor health check that detects it and the repair that
    closes it, on the Health-Check-#13 pattern.

    Exit codes follow ``artifacts/api-contract.md`` § Error Model. **Dry run is
    an advisory report:** 0 when it ran — a finding is not a failure — and 1 only
    when it could not run. **``--apply`` is a state-mutating writer:** 0 when it
    removed rows or was an idempotent no-op, 1 when it refused. Unknown flags 2.
    """
    rejected = _reject_unknown_args("norm-index-scaffold", argv, {"--apply", "--json"})
    if rejected is not None:
        return rejected
    apply = "--apply" in argv
    as_json = "--json" in argv

    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import norm_index_scaffold  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError as exc:
        print(
            f"error: norm-index-scaffold could not import the plugin lib/ ({exc})",
            file=sys.stderr,
        )
        return 1

    result = norm_index_scaffold.repair(project_dir, apply=apply)
    status = result["status"]

    if as_json:
        print(json.dumps(result, indent=2))
    else:
        # Labelled from the MODE asked for, not from whether a write happened —
        # `--apply` on an `ok` repo writes nothing, and calling that "dry-run"
        # invites the reader to conclude they forgot the flag.
        print(f"norm-index-scaffold ({'apply' if apply else 'dry-run'}): {status}")
        print(f"  {result['detail']}")
        if status == norm_index_scaffold.STATUS_LEFTOVER and not result["applied"]:
            # The informed confirmation: name the file and the exact rows, so
            # `--apply` is a yes to something the owner has actually read.
            print(f"  Would delete from {result['path']} (--apply to write):")
            for line_no in result["rows"]:
                print(f"    line {line_no}")

    if apply:
        return 0 if result["applied"] or status == norm_index_scaffold.STATUS_OK else 1
    # Dry run cannot produce UNWRITABLE — `repair(apply=False)` returns before
    # the write — so listing it here would be unreachable code implying a state
    # this path can reach.
    return 1 if status == norm_index_scaffold.STATUS_UNREADABLE else 0


def _plan_label(plan_path: Path, prawduct_dir: Path) -> str:
    """A plan named so the operator can tell it from its siblings.

    ``Path.name`` is ambiguous the moment a repo nests plans as
    ``plans/<id>/build-plan.md`` — a real consumer layout, where four plans share
    that one name. These lists are what a single operation-level approval is
    given for, and an approval over items the reader cannot tell apart is not
    informed. Degrades to the bare name if the plan somehow sits outside
    ``artifacts/``, which is the same fallback the shared helper uses.
    """
    try:
        from lib import plan_index  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        return plan_path.name
    return plan_index.display_path(plan_path, prawduct_dir / "artifacts")


def cmd_lifecycle_repair(project_dir: Path, argv: list[str]) -> int:
    """Converge a repo off the retired derived-view model (FL2, FL3, GD2).

    Removes the inert ``views_enabled`` key and ``scope_rollups`` block, labels
    ``release-notes.md`` as the history it is, and deletes the per-plan notes
    telling a reader that Status checkboxes are generated and must not be
    hand-edited — the one piece of residue that still changes behaviour.

    **Preview-by-default with ``--apply``**, because this walks the artifacts
    tree and decides for itself which files to touch, unlike ``archive-plan``,
    which writes on invocation because the operator named the file. The binding
    rule is ``security-model.md`` § Direction; that scope split is descriptive
    prose in ``api-contract.md`` § Operations.

    **One approval covers the whole act.** The preview names every file and
    every reason once; there is deliberately no per-file prompt, because
    ``security-model.md`` § Direction forbids one here in those terms —
    confirmation fatigue is itself a safety regression.

    Exit codes follow ``artifacts/api-contract.md`` § Error Model, matching every
    sibling repair. **Dry run is an advisory report:** 0 when it ran — a finding
    is not a failure — and 1 only when it could not run. **``--apply`` is a
    state-mutating writer:** 0 when it wrote or was an idempotent no-op, 1 when
    any edit failed. Unknown flags are 2.

    The GD2 guard (the retired flag reappearing, typically by someone copying an
    older state file) is reported here rather than given its own non-zero exit:
    doctor's health check grades it **degraded**, which is doctor's failure
    vocabulary, and an advisory that exited non-zero on a finding would break the
    convention every sibling check follows and make ``--apply``'s exit ambiguous.
    """
    rejected = _reject_unknown_args("lifecycle-repair", argv, {"--apply", "--json"})
    if rejected is not None:
        return rejected
    apply = "--apply" in argv
    as_json = "--json" in argv

    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import lifecycle_repair  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError as exc:
        print(
            f"error: lifecycle-repair could not import the plugin lib/ ({exc})",
            file=sys.stderr,
        )
        return 1

    plan = lifecycle_repair.plan_repair(project_dir)
    if plan["status"] != "ok":
        print(f"error: {plan['reason']}", file=sys.stderr)
        return 1

    guard = lifecycle_repair.views_flag_present(project_dir)
    stale = lifecycle_repair.stale_status_reports(
        Path(project_dir) / lifecycle_repair.ARTIFACTS_REL
    )
    outcome = lifecycle_repair.apply_repair(project_dir, plan) if apply else None

    if as_json:
        print(
            json.dumps(
                {
                    "applied": bool(apply),
                    "edits": [
                        {k: str(v) if k == "path" else v for k, v in edit.items()
                         if k in ("path", "kind", "reason", "detail")}
                        for edit in plan["edits"]
                    ],
                    "unreadable": plan["unreadable"],
                    "retired_flag": guard,
                    "plans_to_review": [
                        {"path": str(r["path"]), "chunks": r["chunks"]} for r in stale
                    ],
                    "outcome": outcome,
                },
                indent=2,
            )
        )
    else:
        # Labelled from the MODE asked for, not from whether a write happened —
        # `--apply` on a converged repo writes nothing, and calling that run
        # "dry-run" invites the reader to conclude they forgot the flag.
        print(f"lifecycle-repair ({'apply' if apply else 'dry-run'}):")
        if not plan["edits"] and not plan["unreadable"]:
            print("  nothing to change — this repo is already in the target state")
        elif not plan["edits"]:
            # Never "already in the target state" here: a file that could not be
            # read may hold the note that still changes behaviour, and reporting
            # it as converged is the one wrong answer available.
            print("  no changes could be worked out, because some files could "
                  "not be read — this repo has NOT been checked")
        # Grouped so the reason is stated ONCE per group rather than repeated
        # per file. On this repo the ungrouped form printed the same sentence
        # fourteen times, which is how a blast radius meant to be read becomes a
        # wall that is scrolled past — and the whole value of the preview is that
        # the operator actually reads it before the one approval.
        #
        # Grouped by REASON within a kind, not by kind alone. `state-key` covers
        # three retired keys with three different rationales, so keying on kind
        # printed one of them above all three and silently attributed the others
        # to a reason that is not theirs — worse than the repetition the grouping
        # exists to prevent, because the operator cannot tell it happened.
        verb = "changed" if apply else "would change"
        for kind in ("state-key", "freeze-notes", "plan-comment"):
            group = [edit for edit in plan["edits"] if edit["kind"] == kind]
            if not group:
                continue
            by_reason: dict = {}
            for edit in group:
                by_reason.setdefault(edit["reason"], []).append(edit)
            # Every emitted line carries the plain-language reason and names no
            # internal identifier — `observability-strategy.md` § Direction.
            for reason, edits in by_reason.items():
                print(f"  why: {reason}")
                for edit in edits:
                    print(f"    {verb} {edit['path']}: {edit['detail']}")
        if plan["edits"] and not apply:
            print("  Re-run with --apply to make these changes. One confirmation "
                  "covers all of them; they are ordinary file edits your version "
                  "control can undo.")
        if stale:
            print("  Read these once — their progress checkboxes were generated, so "
                  "an unfinished chunk may be marked wrongly. Nothing here is "
                  "changed for you: only someone who knows what actually shipped "
                  "can say.")
            for report in stale:
                print(f"    {_plan_label(report['path'], Path(project_dir) / '.prawduct')}")
                for chunk in report["chunks"]:
                    print(f"      - {chunk}")
        for item in plan["unreadable"]:
            print(f"  could not read {item['path']} ({item['reason']}) — it was "
                  f"left alone and not checked", file=sys.stderr)
        if outcome and outcome["failed"]:
            for failure in outcome["failed"]:
                print(f"  could not write {failure['path']}: {failure['reason']}",
                      file=sys.stderr)

    if apply:
        return 1 if (outcome and outcome["failed"]) or plan["unreadable"] else 0
    # "Could not run" is exit 1 for the same reason the sibling repairs use it:
    # a check that declined must never be indistinguishable from one that passed.
    return 1 if guard["status"] == "unreadable" or plan["unreadable"] else 0


def cmd_plan_backfill(project_dir: Path, argv: list[str]) -> int:
    """Archive every build plan the change log records as already shipped (FL6).

    The one-time sweep that gives accumulated plans the end of life
    ``archive-plan`` gives a single one. Shipped is decided mechanically — a
    plan whose ``scope=`` carries a ``release=`` tag — so no judgment enters,
    and checkbox state is never corrected on the way in.

    Since #634 that tag is **necessary but not sufficient**: it says the scope
    shipped, not that the plan finished, and a plan whose own ``## Status`` does
    not evidence completion is refused into ``blocked`` with the chunk named
    rather than proposed. Still no judgment — the predicate is a deterministic
    count, and the refusal hands the call to a human instead of taking it.
    ``archive-plan`` asks no completeness question, so it remains the route for a
    plan the operator has decided is done.

    A product with **no** release tags gets nothing moved: the set is proposed
    and the operator confirms. That is why an empty sweep on such a repo is
    reported as "nobody but you can decide", never as a clean result.

    Exit codes match the sibling repairs, with one asymmetry that is the point
    rather than an accident: a **dry run is 0 whenever it ran**, including when
    it lists plans it would refuse — it attempted nothing, so it skipped nothing,
    and a preview that exits 1 on every repo holding one already-archived
    namesake is noise a release checklist learns to ignore. An ``--apply`` is 0
    when it archived or had nothing to do, and **1 when any plan it should have
    moved did not move** — whether pre-filtered into ``blocked`` by the survey's
    refusal check or hit at write time as ``refused``. Those two were one code
    path before the preview consulted the refusal predicate, and reading only
    ``refused`` here is how the signal briefly went missing.
    """
    usage = "usage: prawduct-hook plan-backfill [--apply] [--json] [--date YYYY-MM-DD]"
    apply = False
    as_json = False
    date = None
    # Explicit scan rather than `_reject_unknown_args`, which is flag-only and
    # would reject `--date`'s value as an unknown positional. Unknown tokens are
    # still usage errors, never ignored: a swallowed token here would archive
    # under a date the operator did not give, and the date is the record.
    index = 0
    while index < len(argv):
        token = argv[index]
        if token == "--apply":
            apply, index = True, index + 1
        elif token == "--json":
            as_json, index = True, index + 1
        elif token == "--date":
            if index + 1 >= len(argv) or not argv[index + 1]:
                print(f"{usage}\n--date requires a YYYY-MM-DD argument", file=sys.stderr)
                return 2
            date, index = argv[index + 1], index + 2
        elif token.startswith("--date="):
            date = token.split("=", 1)[1]
            if not date:
                print(f"{usage}\n--date requires a YYYY-MM-DD argument", file=sys.stderr)
                return 2
            index += 1
        else:
            print(f"plan-backfill: unknown argument {token!r}\n{usage}", file=sys.stderr)
            return 2
    if date is None:
        date = datetime.now(timezone.utc).strftime("%Y-%m-%d")

    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import plan_backfill  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError as exc:
        print(f"error: plan-backfill could not import the plugin lib/ ({exc})",
              file=sys.stderr)
        return 1

    prawduct_dir = _gitstate().get_prawduct_dir(project_dir)
    result = plan_backfill.backfill(prawduct_dir, date=date, apply=apply)

    if as_json:
        print(json.dumps(
            {
                "applied": bool(apply),
                "has_release_tags": result["has_release_tags"],
                "shipped": [
                    {"path": str(i["path"]), "scope": i["scope"], "release": i["release"]}
                    for i in result["shipped"]
                ],
                "blocked": [
                    {
                        "path": str(i["path"]),
                        "scope": i["scope"],
                        "release": i["release"],
                        "reason": i["reason"],
                    }
                    for i in result["blocked"]
                ],
                "kept_live": [
                    {"path": str(i["path"]), "scope": i["scope"]} for i in result["unshipped"]
                ],
                "archived": result["archived"],
                "refused": result["refused"],
            },
            indent=2,
        ))
    else:
        print(f"plan-backfill ({'apply' if apply else 'dry-run'}):")
        if not result["has_release_tags"]:
            print("  This product's change log records no releases, so there is no "
                  "mechanical way to tell which plans are finished. Nothing was "
                  "moved. Decide which of these are done and file them one at a "
                  "time:")
            for item in result["unshipped"]:
                print(f"    {_plan_label(item['path'], prawduct_dir)}")
        else:
            verb = "archived" if apply else "would archive"
            print(f"  {verb} {len(result['shipped'])} finished plan(s) — each one "
                  "shipped in a released version, so it records what was built "
                  "rather than what is being built:")
            for item in result["shipped"]:
                label = _plan_label(item["path"], prawduct_dir)
                print(f"    {label}  (shipped in {item['release']})")
            print(f"  leaving {len(result['unshipped'])} plan(s) in place — either "
                  "no release records them yet, newer work on the same name is "
                  "still in flight, or it is the plan being built right now:")
            for item in result["unshipped"]:
                print(f"    {_plan_label(item['path'], prawduct_dir)}")
            # Named in the SAME breath as the count, not left to stderr: this
            # list is the difference between what the operator is approving and
            # what the change log says qualifies, and a preview that reports the
            # second as the first is the divergence this list exists to close.
            if result["blocked"]:
                print(f"  NOT moving {len(result['blocked'])} plan(s) the change "
                      "log records as shipped — each one qualifies, and each is "
                      "refused for a reason that needs a person:")
                for item in result["blocked"]:
                    label = _plan_label(item["path"], prawduct_dir)
                    print(f"    {label}  ({item['reason']})")
            if not apply and result["shipped"]:
                print("  Re-run with --apply to move them. One confirmation covers "
                      "all of them; each file is moved, not deleted, and keeps "
                      "everything it says.")
        for refusal in result["refused"]:
            print(f"  could not archive {refusal['scope']}: {refusal['reason']}",
                  file=sys.stderr)

    # A dangling `active_build_plan` is read by every gate as "no active build
    # plan" — they stop firing rather than fail, which is the failure class this
    # work treats as its worst. The sweep now REFUSES to archive the plan the
    # pointer names, so "this run archived it" is no longer reachable and a
    # notice for it would be a report nothing can trigger. What is still
    # reachable, and what actually hurts, is a pointer naming a plan that is not
    # there for any reason — archived by hand, moved, renamed, or lost to an
    # interrupted run. That is the condition reported.
    #
    # Reports, never writes: the pointer is state a session owns.
    pointer = _read_str_yaml_key(
        project_dir / ".prawduct" / "project-state.yaml", "active_build_plan"
    )
    pointed_at = _core().pointer_plan_path(project_dir / ".prawduct")
    if pointer and pointed_at is not None:
        if not pointed_at.is_file():
            print(
                f"NOTE: active_build_plan names {pointer}, which is not there. "
                "Every gate reads that as 'no active build plan' and goes quiet — "
                "clear it, or point it at the plan that is now live.",
                file=sys.stderr,
            )

    # An APPLY that could not move everything the change log says shipped exits
    # non-zero. `refused` alone used to carry that: before the preview consulted
    # the refusal predicate, a collision was attempted, failed, landed in
    # `refused`, and exited 1. Pre-filtering into `blocked` made that same repo
    # exit 0 — the signal was lost as a side effect of fixing the preview, which
    # is the shape this whole change exists to stop (a run that skipped work
    # reporting as one that had none). Restoring it here keeps the contract the
    # pre-filter was never meant to alter.
    #
    # A PREVIEW stays 0: nothing was skipped because nothing was attempted, and
    # a dry run that exits 1 on every repo holding one already-stamped plan is
    # noise the release checklist would learn to ignore.
    incomplete = result["refused"] or (apply and result["blocked"])
    return 1 if incomplete else 0


def cmd_check_learnings_pairing(project_dir: Path, argv: list[str]) -> int:
    """Grade `learnings.md` against `learnings-detail.md`. Read-only.

    Exit 0 when there is nothing to report, 1 on a duplicate heading, **3** when
    the pair could not be read — the standing third-outcome rule for a check
    whose subject is unreadable (api-contract § Error Model). Reporting a clean
    pair off a file that would not decode is the failure this whole scope is
    about.
    """
    rejected = _reject_unknown_args("check-learnings-pairing", argv, {"--json"})
    if rejected is not None:
        return rejected
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import audit_learnings_cmd  # noqa: PLC0415 — lazy import
    except ImportError:
        print(
            "NOTE: check-learnings-pairing could not import the plugin lib/; "
            "the learnings pair was NOT graded.",
            file=sys.stderr,
        )
        return 0

    result = audit_learnings_cmd.check_learnings_pairing(project_dir)
    if "--json" in argv:
        print(json.dumps(result, indent=2))
    elif result["status"] == "ok":
        print(f"ok: {result['reason']}")
    else:
        print(f"{result['status']}: {result['reason']}", file=sys.stderr)
        for finding in result["findings"]:
            print(f"  - {finding['detail']}", file=sys.stderr)
    if result["status"] == "findings":
        return 1
    if result["status"] == "unchecked":
        return 3
    return 0


def cmd_audit_learnings(project_dir: Path, argv: list[str]) -> int:
    """Audit the consumer's ``.prawduct/learnings.md`` lifecycle (F9).

    Plugin-native port of the legacy file-sync ``audit-learnings`` path (gone in
    a migrated consumer — there is no framework checkout). Walks the
    consumer's OWN ``learnings.md``, classifying entries as promotion /
    retirement / stale candidates, and with ``--apply`` moves sentinel-passing
    entries to ``learnings-detail.md``'s historical section. Invoked by
    ``/prawduct:doctor``'s Audit-Learnings flow (``--json``). ``argv`` is
    ``sys.argv[2:]`` (``--apply``, ``--json``); read-only by default.

    Fail-safe: if the bundled lib/ cannot be imported (an incomplete plugin
    install), print a clear message and return 1 rather than crashing.
    """
    rejected = _reject_unknown_args("audit-learnings", argv, {"--apply", "--json"})
    if rejected is not None:
        return rejected
    apply = "--apply" in argv
    as_json = "--json" in argv

    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import run_audit_learnings  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "error: audit-learnings could not import the plugin lib/ from "
            "${CLAUDE_PLUGIN_ROOT}.",
            file=sys.stderr,
        )
        return 1

    result = run_audit_learnings(str(project_dir), apply=apply)

    # The ungraded notice goes to STDERR, before either renderer, so it reaches
    # BOTH. On the `--json` path stdout is a machine payload, so a notice
    # printed there would either corrupt it or (as shipped) be omitted entirely
    # — leaving the sole `--json` consumer, the doctor skill, with no signal at
    # all where the pre-fix code at least printed something loud and wrong.
    ungraded = [
        r for r in result.get("retirements", []) if r.get("unevaluated_reason")
    ]
    if ungraded:
        print(
            f"notice: {len(ungraded)} sentinel(s) could not be graded and were "
            "left active — no rule is retired on a verdict nobody took. "
            f"First: {ungraded[0]['title']}: {ungraded[0]['unevaluated_reason']}",
            file=sys.stderr,
        )

    if as_json:
        print(json.dumps(result, indent=2))
        # A refusal lands in `errors`, not `error`, and `applied: false` after a
        # requested `--apply` means the writer refused and wrote nothing —
        # api-contract gives a refusing writer exit 1. Reporting 0 there tells
        # the caller the retirement happened.
        if "error" in result:
            return 1
        return 1 if (apply and result.get("applied") is False) else 0

    if "error" in result:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1

    promotions = result["promotions"]
    retirements = result["retirements"]
    stale = result["stale_flags"]
    errors = result["errors"]
    print(
        f"audit-learnings ({'applied' if result['applied'] else 'dry-run'}): "
        f"{len(promotions)} promotion candidate(s), {len(retirements)} retirement "
        f"candidate(s), {len(stale)} stale flag(s), {len(errors)} error(s)."
    )
    for p in promotions:
        print(f"  promote: {p['title']} (confirmations={p['confirmations']})")
    for r in retirements:
        # Two retirement routes, and the readiness question differs per route:
        # a sentinel candidate is ready when its test passes, a supersession
        # when its pointer resolved. Reading `passed` for both would report
        # every resolvable supersession as "blocked" (its `passed` is None by
        # construction) — a clean candidate rendered as a problem.
        ungraded = False
        if r.get("reason") == "superseded-by":
            ready = r.get("resolved_to") is not None
            why = f"superseded-by={r.get('resolved_to') or r.get('superseded_by')}"
        else:
            # Three-valued, and `bool()` would flatten it: an UNGRADED sentinel
            # (`passed is None`) is not a blocked one. Rendering it "blocked"
            # tells the operator a test is failing when prawduct never ran one,
            # which is the same false accusation in the report that the runner
            # stopped making.
            ready = r.get("passed") is True
            ungraded = r.get("passed") is None
            why = f"sentinel={r['sentinel']}"
        if r.get("applied"):
            state = "retired"
        elif ungraded:
            state = "ungraded"
        elif ready:
            state = "ready"
        else:
            state = "blocked"
        print(f"  retire[{state}]: {r['title']} ({why})")
        if r.get("unevaluated_reason"):
            print(f"    not graded: {r['unevaluated_reason']}")
    for s in stale:
        print(f"  stale: {s['title']} ({s['age_days']}d, confirmations={s['confirmations']})")
    for e in errors:
        print(f"  error: {e['title']}: {e['error']}")
    # Same rule as the `--json` path above: a requested `--apply` that came back
    # `applied: false` refused and wrote nothing, and a writer that refused
    # exits 1.
    if apply and result.get("applied") is False:
        return 1
    return 0


def cmd_repo_disable(project_dir: Path, argv: list[str]) -> int:
    """Disable the Prawduct plugin for the current repo (``/prawduct:repo-disable``).

    Writes ``"enabledPlugins": {"prawduct@prawduct": false}`` into
    ``.claude/settings.json`` (committed; default) or ``.claude/settings.local.json``
    (``--local``; auto-gitignored), preserving every other setting. Dry-run by
    default; ``--apply`` writes; ``--json`` emits the structured plan/result.

    There is no enable counterpart: a disabled plugin's own skills do not load, so
    re-enabling is a documented manual edit (set the value to ``true`` or delete the
    key). Fail-safe: if the bundled lib/ cannot be imported, print a clear message
    and return 1 rather than crashing.
    """
    rejected = _reject_unknown_args(
        "repo-disable", argv, {"--local", "--apply", "--json"}
    )
    if rejected is not None:
        return rejected
    local = "--local" in argv
    apply = "--apply" in argv
    as_json = "--json" in argv

    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib.repo_toggle import set_repo_disabled  # noqa: PLC0415 — lazy keeps top-level cheap
    except ImportError:
        print(
            "error: repo-disable could not import the plugin lib/ from "
            "${CLAUDE_PLUGIN_ROOT}.",
            file=sys.stderr,
        )
        return 1

    result = set_repo_disabled(project_dir, local=local, apply=apply)

    if as_json:
        print(json.dumps(result, indent=2))
        return 1 if "error" in result else 0

    if "error" in result:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1

    target = result["target"]
    if result["already_disabled"]:
        print(f"Prawduct is already disabled for this repo in {target} — nothing to do.")
        return 0

    if not apply:
        print(
            f'DRY RUN: would set "enabledPlugins": {{"prawduct@prawduct": false}} in '
            f"{target} (all other settings preserved). Re-run with --apply to write it."
        )
        return 0

    print(
        f'Disabled Prawduct for this repo: wrote "prawduct@prawduct": false to {target}.\n'
        "  • Takes effect after you run /reload-plugins (this session) or restart Claude Code\n"
        "    — until then Prawduct stays active.\n"
        "  • Once disabled, the /prawduct:* commands won't load here. To RE-ENABLE later, edit\n"
        f'    {target}: set "prawduct@prawduct": true (or remove the line), then /reload-plugins.'
    )
    return 0


# Two constraints, both learned by breaking a test. They have DIFFERENT scopes,
# and getting that backwards is why this note was wrong on its first attempt:
# 1. Scope: the block below only. No close-paren character anywhere inside it —
#    not in the strings, not in a comment. Several tests read the block by
#    splitting the source on the first one, so any occurrence silently truncates
#    the text they check. Use brackets. A paren up here is harmless, because the
#    truncation starts after the assignment.
# 2. Scope: this note TOO. Nothing here or below may write the constant's name,
#    because the tests slice between its FIRST and SECOND occurrence in the whole
#    file — so naming it in this comment would make the window be this comment.
#    That is the only reason the sentences above talk around it.
_USAGE = (
