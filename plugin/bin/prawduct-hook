# --- Work model: jurisdiction matching --------------------------------------
# Which governing artifacts already cover a plan's vocabulary — the input that
# seeds a plan's ``governed_by:`` field. The matching logic is the pure
# lib/work_model_index.py; this is the thin runtime wrapper that assembles the
# corpus (artifacts, CLAUDE.md, docs/, methodology/).
#
# The pre-turn orphan-term tripwire that these wrappers were originally built
# for was DELETED 2026-08-11 (owner ruling 2026-07-12, #257: its resolution was
# deletion, not a further precision fix; requirements-precede-code enforcement
# moved to the review-time ``scope-trace:`` check, CRT-5M9J). Its derived index
# cache went with it — ``jurisdiction`` reads the corpus directly and never used
# the cache, which is what made the deletion separable.
#
# ``jurisdiction`` is on-demand and NEVER a gate, so every path returns 0.



def _work_model_load_lib():
    """Import the jurisdiction-matching logic, seeding sys.path like the other
    lib readers. (It was the tripwire's catch logic until v3.3.2 removed that;
    `jurisdiction_candidates` is what the module is for now.)"""
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    from lib import work_model_index  # noqa: PLC0415 — lazy import keeps top-level cheap

    return work_model_index


def _work_model_corpus_paths(project_dir: Path, prawduct_dir: Path) -> list[Path]:
    """The governing corpus ``jurisdiction`` matches against: every markdown
    artifact under ``.prawduct/artifacts/``, plus the repo's CLAUDE.md and all
    ``docs/`` / ``methodology/`` markdown, recursively (gate-noise: product
    repos keep governing vocabulary in doc subdirectories, and the earlier
    top-level-only globs missed it). Missing directories simply contribute
    nothing — product repos rarely have all of them.

    Widening this set is safe in one direction only, though the direction
    changed with the caller. For the deleted tripwire, extra vocabulary could
    only *suppress* a nudge. For ``jurisdiction`` it can only *add* candidates,
    never remove one — so the failure mode of over-widening is a longer
    ``governed_by:`` seed list for the author to prune, not a missing artifact.
    Narrowing is the direction that loses answers silently, which is what
    ``test_jurisdiction_corpus_covers_claude_md_docs_subdirs_and_methodology``
    exists to catch."""
    paths = sorted((prawduct_dir / "artifacts").glob("*.md"))
    claude_md = project_dir / "CLAUDE.md"
    if claude_md.is_file():
        paths.append(claude_md)
    for sub in ("docs", "methodology"):
        paths.extend(sorted((project_dir / sub).rglob("*.md")))
    return paths


def cmd_jurisdiction(project_dir: Path, argv: list[str]) -> int:
    """On-demand authoring aid: given plan/prompt text, list the governing
    artifacts whose vocabulary the text's salient terms fall under. It seeds a
    plan's ``governed_by:`` field with mechanical candidates for the planner's
    judgment; it is NEVER a gate, so every path returns 0.

    Input, first match wins: ``--file <path>`` reads the text from a file;
    otherwise the positional args are joined as the text; otherwise stdin.
    ``--artifacts-only`` restricts the corpus to ``.prawduct/artifacts/``
    (the rest of the corpus — CLAUDE.md, docs/, methodology/ — is dropped).

    Output: one line per candidate, ranked (count desc, path asc):
    ``<path relative to project dir>  (<count>: term1, term2, ...)``. No
    matches prints nothing. Fail-open — a bad ``--file`` path or any other
    error prints a NOTE to stderr and still exits 0.
    """
    prawduct_dir = get_prawduct_dir(project_dir)
    if not prawduct_dir.is_dir():
        return 0  # not a Prawduct-governed repo — stay silent

    # Manual argv parse (no argparse — matches the other subcommands' style).
    artifacts_only = False
    file_arg: str | None = None
    positional: list[str] = []
    i = 0
    while i < len(argv):
        token = argv[i]
        if token == "--artifacts-only":
            artifacts_only = True
        elif token == "--file":
            i += 1
            if i < len(argv):
                file_arg = argv[i]
        elif token.startswith("--file="):
            file_arg = token[len("--file=") :]
        else:
            positional.append(token)
        i += 1

    try:
        wmi = _work_model_load_lib()

        # Resolve the text to place (first match wins): file, then positional,
        # then stdin. A missing --file raises FileNotFoundError -> NOTE below.
        if file_arg is not None:
            text = Path(file_arg).read_text(encoding="utf-8", errors="replace")
        elif positional:
            text = " ".join(positional)
        else:
            text = sys.stdin.read()
        if not text.strip():
            return 0  # nothing to place -> nothing to print

        paths = _work_model_corpus_paths(project_dir, prawduct_dir)
        if artifacts_only:
            artifacts_root = prawduct_dir / "artifacts"
            paths = [p for p in paths if artifacts_root in p.parents]

        # Build (relpath, content) pairs; the pure function ranks and caps.
        files: list[tuple[str, str]] = []
        for p in paths:
            try:
                content = p.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue  # unreadable corpus file contributes nothing
            try:
                rel = str(p.relative_to(project_dir))
            except ValueError:
                rel = str(p)  # outside the project dir (unexpected) -> absolute
            files.append((rel, content))

        for cand in wmi.jurisdiction_candidates(text, files):
            print(f"{cand['path']}  ({cand['count']}: {', '.join(cand['matched'])})")
    except (OSError, ValueError) as exc:
        # Missing/unreadable --file, decode issues, etc. This is an authoring
        # aid, never a gate — surface the reason, but exit 0.
        print(f"NOTE: prawduct-hook jurisdiction could not run: {exc}", file=sys.stderr)
        return 0
    except Exception as exc:  # prawduct:allow prawduct/broad-except -- authoring aid must never error out; always exit 0
        print(f"NOTE: prawduct-hook jurisdiction skipped (error): {exc}", file=sys.stderr)
        return 0
    return 0


# --- Framework-checkout binary skew (#227) --------------------------------
# Inside a framework checkout, a bare `prawduct-hook` on $PATH resolves to
# whatever plugin the environment installed — the plugin cache, or a sibling
# worktree's checkout. The observed failure is the worst one available here:
# `critic-begin` ran the foreign binary and wrote NO kernel-v3 manifest, with
# no error, and the SubagentStop `critic-consolidate` no-opped the same way,
# leaving reviews unpersisted.
#
# The discriminator is binary IDENTITY, not version equality. Comparing
# self-reported versions is blind in the common case, because a checkout is
# routinely ahead of its own manifest between releases — the skew that
# prompted this had the installed plugin and the checkout both reporting
# 3.2.3 while lib/ had diverged. "Am I the binary this repo carries" is exact
# and needs no lineage bookkeeping.
#
# Posture follows what the command produces (architecture.md § Direction):
# a governance WRITE fails closed, everything else degrades to a loud note.
# Neither is silent, which is the entire point.

SKEW_MARKER = "plugin-binary-skew"

# Entry points the HARNESS invokes, from `hooks/hooks.json`. These always run
# `${CLAUDE_PLUGIN_ROOT}/bin/prawduct-hook` — the install cache — so inside any
# framework checkout they are foreign BY DESIGN; that is the governance model,
# not a mistake. A refusal here is also unactionable: a hook cannot be told to
# invoke a repo-local binary. Refusing would return 1 from every SessionStart in
# every framework checkout — no briefing, no session reset, no marker sweep —
# so these get the loud note and nothing else. `stop` and `subagent-stop` are
# here even though `stop`'s abandoned-review self-heal DOES write a fact: who
# invokes it decides whether refusing is even possible, and only then does what
# it writes decide the severity of saying so.
_HARNESS_INVOKED_COMMANDS = frozenset({
    "clear",
    "subagent-stop",
    "stop",
})

# Agent-invoked, state-mutating governance writes. A wrong-version write here
# does not merely misreport — it corrupts or silently omits a persisted fact
# that later gates compose over, and the caller CAN re-invoke the right binary,
# which is what makes refusing actionable.
#
# DECIDED: this is an ALLOWLIST, so an unlisted command defaults to advisory —
# the permissive side. The fail-closed alternative (refuse everything not known
# read-only) was rejected because the read-only set is the larger, faster-moving
# one: every new report, probe and query would silently start refusing inside
# every framework checkout until someone remembered to exempt it, and that
# failure is invisible until a session breaks. Getting the permissive default
# wrong costs one command's worth of silence, which the loud NOTE still covers;
# getting the restrictive default wrong costs the whole tool. Reviewed as a
# staleness risk (no mechanical pin exists — the set is semantic, not derivable
# from a file the way `_HARNESS_INVOKED_COMMANDS` is from `hooks.json`), and
# accepted on that asymmetry rather than by omission.
_DATA_PLANE_COMMANDS = frozenset({
    "critic-begin",
    "critic-consolidate",
    "critic-discard",
    "critic-end",
    "critic-restore",
    "disposition",
    "ledger-append",
})


def _repo_plugin_dir(project_dir: Path) -> "Path | None":
    """The plugin directory THIS repo carries, or None if it carries none.

    A repo is a framework checkout iff it holds `plugin/.claude-plugin/plugin.json`.
    Product repos hold none and are therefore untouched by the guard — they
    legitimately run the installed binary, and firing there would break every
    governed repo in the fleet.
    """
    try:
        candidate = Path(project_dir) / "plugin"
        if (candidate / ".claude-plugin" / "plugin.json").is_file():
            return candidate.resolve()
    except OSError:
        return None
    return None


def _lib_skew(project_dir: Path) -> "tuple[Path, Path] | None":
    """``(repo's plugin dir, lib root)`` when the LIB comes from elsewhere.

    Identity has two halves and fixing only one leaves the defect standing.
    :func:`_binary_skew` answers "which script is executing"; this answers
    "whose ``lib/`` will it import", because :func:`_plugin_root` — which seeds
    ``sys.path`` for every lazy lib accessor, including the ones `critic-begin`
    and `critic-consolidate` run through — prefers ``$CLAUDE_PLUGIN_ROOT` over
    the script's own location. Where the two diverge, the repo-local binary
    executes another plugin's governance code: #227's consequence surviving on
    the exact command the skew refusal tells you to run.
    """
    repo_plugin = _repo_plugin_dir(project_dir)
    if repo_plugin is None:
        return None
    try:
        lib_root = Path(_plugin_root()).resolve()
    except OSError:
        return None
    if lib_root == repo_plugin:
        return None
    return repo_plugin, lib_root


def _binary_skew(project_dir: Path) -> "tuple[Path, Path] | None":
    """``(repo's plugin dir, running plugin dir)`` when they differ, else None."""
    repo_plugin = _repo_plugin_dir(project_dir)
    if repo_plugin is None:
        return None
    try:
        # The RUNNING SCRIPT's own root — deliberately NOT `_plugin_root()`,
        # which prefers $CLAUDE_PLUGIN_ROOT. That var is set in the *hook*
        # process; whether it reaches an agent's Bash env varies, and it was
        # MEASURED unset in the framework session that built this guard — so
        # treat "it is always exported" as false rather than load-bearing.
        # Keying on it fails in both directions when it IS set: the correct
        # repo-local invocation would refuse
        # (with advice to run what you just ran), and a genuinely foreign
        # binary invoked with the var pointed at this repo would compare equal
        # and pass — which is #227 itself, wearing the guard as a disguise.
        running = Path(__file__).resolve().parent.parent
    except OSError:
        return None
    if running == repo_plugin:
        return None
    return repo_plugin, running


# =============================================================================
# Ephemeral-worktree guard
# =============================================================================
# A subagent dispatched with `isolation: "worktree"` gets a disposable worktree
# forked from HEAD, of which only the code commit is merged back. Everything it
# writes under `.prawduct/` dies at that merge with no trace, so an agent
# correctly following prawduct's own rules ("file it via /prawduct:backlog")
# produces a stranded write and is told it succeeded.
#
# That reasoning is about the SEPARATION of the code commit from the state
# write, which is a property of the harness's scratch branch — not of the
# directory the tree happens to sit in. An agent worktree holding a real named
# branch has no such separation: the branch carries the whole tree, `.prawduct/`
# included. Refusing there produced a message whose stated reason was false and
# a Critic gate no route could satisfy (#648); `gitstate.is_ephemeral_worktree`
# owns that distinction, so everything below reads as written once it answers.
#
# The inseparability is ASSUMED, not measured — see that function's docstring
# for the falsifier. If the harness ever merges a code commit off a named
# branch while discarding the branch, this guard stops covering that case and
# #594's silent strand returns for it.
#
# DECIDED: this classification is an allowlist of READS — an unlisted command
# defaults to refused-inside-an-ephemeral-worktree, the restrictive side. That
# deliberately inverts `_DATA_PLANE_COMMANDS` (below), whose own DECIDED note
# chose the permissive default because the read set is "the larger,
# faster-moving one" and a restrictive default would break new commands "inside
# every framework checkout". That reasoning is right there and does not carry:
# the skew guard fires in every framework checkout, while this one fires only
# inside `.claude/worktrees/agent-*`. Getting the restrictive default wrong
# costs one loud, overridable refusal inside a tree that is about to be deleted;
# getting the permissive default wrong costs a silently stranded governance
# write, which is the defect under repair. The asymmetry is reversed, so the
# default is too — considered against the precedent, not in ignorance of it.
_EPHEMERAL_OVERRIDE_ENV = "PRAWDUCT_ALLOW_EPHEMERAL_WRITES"

# Verified command by command by READING each implementation for a write path,
# never inferred from the name — the names mislead in both directions here.
# `handoff` and `render-dispositions` read as writers and are explicitly
# read-only; `verify-operator-verification` reads as a check and mutates the
# verification queue.
_EPHEMERAL_SAFE_COMMANDS = frozenset({
    # The deprecated-and-inert tier. Provably read-only — every one of these
    # bodies is a print-and-return-0 or a bare return 0 — and membership here is
    # what makes their docstrings' "exits 0 everywhere" true. Without it the
    # fail-closed guard above treats an unlisted command as a write and refuses
    # with exit 1 inside a disposable worktree, which for the two hook-invoked
    # members is the very session-start hook error they were restored to remove
    # (v3.3.3). `regen-views` and `stamp-merged` carried the same gap and the
    # same false claim since they were emptied; this is one classification, not
    # four decisions. Pinned in tests/test_retired_hook_subcommands.py.
    "build-index",
    "user-prompt-submit",
    "regen-views",
    "stamp-merged",
    "bug-inbox",
    "check-change-log-entry",
    "check-cumulative-critic",
    "check-operator-verification",
    "check-learnings-pairing",
    "check-plugin-active",
    "check-pr-doc-only",
    "check-releasability",
    "check-released",
    "classify-diff-risk",
    "cost-of-commit",
    "coverage-status",
    "evidence",
    "handoff",
    "infer-critic-mode",
    "jurisdiction",
    "print-install-reference",
    "render-dispositions",
    "resolve-base",
    "review-stats",
    "test-status",
    "validate-evidence",
    "verify-chunk-refs",
    "verify-coverage",
    "verify-records",
    "version",
})

# Read-only reports that mutate only under `--apply` — a third shape, neither
# whole-command nor per-op.
_EPHEMERAL_APPLY_GATED_COMMANDS = frozenset({
    "audit-learnings",
    "coverage-scaffold",
    "learnings-obligation",
    "lifecycle-repair",
    "norm-index-scaffold",
    "plan-backfill",
})

# Commands whose first positional argument selects a read or a write.
_EPHEMERAL_READ_ONLY_OPS = {
    "advisory": frozenset({"list", "show"}),
    # `show` is `get`'s alias — `lib/backlog/cli.py` dispatches `op in ("get",
    # "show")` to one handler — and omitting it refused a pure read with a
    # message asserting a discarded write, which is the false refusal this
    # guard must never produce. `verify-migration` is read-only because
    # `migrate.verify_migration` contains no write, which is the only test that
    # settles it. Note what is NOT the test: taking a `project_dir` is not
    # necessary for a local write — `export` and `restructure-preview` take
    # none and write to caller-supplied `--to`/`--out` paths, which is why they
    # sit in `_BACKLOG_LOCAL_WRITE_OPS` below alongside the two that do.
    # `pick` stays read-only although it revalidates the backlog cache on its way
    # in. The cache lives under `--git-common-dir`, which every worktree of a
    # clone shares by construction, so that write lands in the clone and not in
    # this tree — it cannot strand, which is the only question this guard asks.
    # `cache-query` is the strongest read in this set: it opens the store without
    # creating it and issues SELECTs, so unlike `pick` it does not even revalidate.
    # `sync` is here for the SAME reason as `pick`, and the two must move
    # together: `pick` reaches `sync.incremental_sync` on every invocation
    # (`query.py`), which is byte-identical to what `sync` runs (`cli.py`), to the
    # same `cache_path` under `--git-common-dir`. Classifying one read-only and
    # the other a write made the guard contradict itself one hunk apart, and it
    # had a live consequence: `briefing._spawn_cache_warm` fires `backlog sync`
    # detached with stderr on DEVNULL, so the refusal was silent and the cache
    # simply never warmed in an agent worktree — while every `unavailable`
    # message names `sync` as the repair, in the one tree where a dispatched
    # reviewer meets it.
    #   NOT fixed here, and deliberately: `refresh-counts` writes
    # `snapshot.snapshot_path`, which also keys off `--git-common-dir` and
    # therefore also cannot strand — so it is misclassified by this same test.
    # It stays a write because a shipped test pins it that way on a stated
    # rationale ("a read + a local snapshot write"), and rewriting a test to
    # match new reasoning is a decision to take deliberately, not a side effect
    # of fixing `sync`. Revisit both together.
    "backlog": frozenset(
        {
            "get",
            "show",
            "list",
            "counts",
            "pick",
            "sync",
            "verify-migration",
            "cache-query",
        }
    ),
}

# Backlog ops that write into THIS tree even when the backlog itself lives on a
# service, so the service-backed allowance below must never cover them. The
# tempting shorthand — "Issues backend ⇒ every backlog op is a network call" —
# is false: `lib/backlog/cli.py` documents `refresh-counts` in as many words as
# "a read + a local snapshot write".
_BACKLOG_LOCAL_WRITE_OPS = frozenset({
    "refresh-counts",       # derives from the service, persists the briefing snapshot locally
    "export",               # writes its `--to` directory
    "restructure-preview",  # writes its `--out` artifact
    "import",               # migration; stamps local backlog-format state
})


def _first_positional(argv: list[str]) -> str | None:
    """The op selector — the first non-flag argument, or ``None``."""
    return next((a for a in argv if not a.startswith("-")), None)


def _ephemeral_command_writes(command: str, argv: list[str], project_dir: Path) -> bool:
    """Whether ``command`` would mutate state that dies with this worktree.

    Fail-closed: anything not positively known to be read-only is a write.
    """
    if command in _EPHEMERAL_SAFE_COMMANDS:
        return False
    if command in _EPHEMERAL_APPLY_GATED_COMMANDS:
        return "--apply" in argv

    if command == "backlog":
        # Printing usage is not writing, so a help request is never refused here —
        # and classifying by the first positional would refuse `backlog import
        # --help` on every backend and `backlog file --help` on a markdown one.
        # That matters more than its narrowness suggests: the adapter's instruction
        # surface bounds a model to "the ops in the usage table `backlog --help`
        # prints", so a refusal puts the referent out of reach for exactly the
        # agent most likely to need it — one running in a worktree it did not
        # create.
        #
        # ASK the adapter, through the one predicate it publishes for the purpose.
        # Whether a token is a help request depends on whether it sits in a value
        # slot, and only the adapter knows which flags take values — so a rule
        # re-spelled here can disagree with the runner about what the call IS, and
        # the disagreement resolves the unsafe way: a write classified as a read and
        # waved through in a tree that discards it.
        lib_root = _plugin_root()
        if lib_root not in sys.path:
            sys.path.insert(0, lib_root)
        try:
            from lib.backlog import cli as _backlog_cli  # noqa: PLC0415 — lazy keeps top-level cheap
        except ImportError as exc:
            # Falling through to the positional rule is the fail-closed direction, so
            # nothing unsafe happens — but it restores a false refusal of `backlog
            # <op> --help`, which is a read. Say so rather than reverting in silence.
            print(
                f"NOTE: classifying `backlog` by op name only — the adapter is "
                f"unreachable ({exc}); a `--help` on a write op may be refused here.",
                file=sys.stderr,
            )
        else:
            if _backlog_cli.is_help_request(argv):
                return False
        op = _first_positional(argv)
        if op in _BACKLOG_LOCAL_WRITE_OPS:
            return True
        if _backlog_is_service_backed(project_dir):
            # On the Issues backend a live-backlog op is a network write against
            # `--repo owner/repo`. It lands on the server and outlives the
            # worktree, so it cannot strand, and refusing it would be exactly
            # the false refusal this guard must avoid.
            #
            # What the FALL-THROUGH does is narrower than it looks, and an
            # earlier comment here claimed otherwise: `cmd_backlog` is always the
            # gh adapter, with no markdown path at all. So on a markdown-backend
            # repo the fall-through refuses adapter ops that would have been
            # network calls — harmless fail-closed — and never intercepts a
            # `.prawduct/backlog.md` write, because no `prawduct-hook` command
            # makes one. The markdown backend's real filing path is the backlog
            # SKILL's own read-modify-write on that file via Read/Write, which
            # invokes no command and is therefore invisible to any command
            # guard. That residual strand is recorded in the build plan's
            # Scope-out rather than papered over here.
            return False

    read_only_ops = _EPHEMERAL_READ_ONLY_OPS.get(command)
    if read_only_ops is not None:
        op = _first_positional(argv)
        if op in read_only_ops:
            return False
        return True
    return True


def _backlog_is_service_backed(project_dir: Path) -> bool:
    """True when the repo routes its backlog to a service (`backlog_service_repo`).

    Reached only from inside an ephemeral worktree, so this file read is off the
    hook's hot path. Fails closed to ``False`` (treat as the local markdown
    backend, which is the refusing branch) on any read problem.
    """
    try:
        state = get_prawduct_dir(project_dir) / "project-state.yaml"
        return _core().read_str_yaml_key(state, "backlog_service_repo") is not None
    except Exception:  # prawduct:allow prawduct/broad-except -- a probe failure must fail closed, not crash
        return False


def _print_ephemeral_notice(kind: str | None, project_dir: Path) -> None:
    """The HEAD-snapshot notice, on every path that proceeds.

    One function because four callers emit it for four different reasons
    (read-only command, dispatcher override, harness-invoked carve-out, and a
    DURABLE harness worktree) and the text is the same answer to the same
    question each time — a second copy is how one of them ends up saying
    something the others do not.

    ``kind`` is ``None`` for the durable case (#648): an `agent-` worktree on a
    real named branch is a peer checkout, so the refusal does not apply and the
    word "ephemeral" would be false — but the READING half is unchanged, which
    is the whole reason the notice is separate from the refusal. Only the first
    clause varies; the fork-point warning is identical, because it is identical.
    """
    what = (
        f"an ephemeral {kind} worktree"
        if kind is not None
        else "a linked agent worktree"
    )
    print(
        f"NOTE: this is {what} ({project_dir}). Every "
        "tracked file here — build plans, artifacts, learnings — is a "
        "snapshot of the commit it was forked from, so uncommitted changes "
        "in the dispatching session are NOT visible. Where a file and your "
        "prompt disagree, your prompt is newer.",
        file=sys.stderr,
    )


def _check_ephemeral_worktree(command: str, argv: list[str], project_dir: Path) -> int:
    """0 to proceed; 1 when a state write from a disposable worktree must refuse.

    Also emits the HEAD-snapshot notice for EVERY command that proceeds,
    harness-invoked ones included: a
    worktree-isolated agent reads every tracked file as a snapshot of the fork
    point, so a dispatcher's uncommitted governing artifacts are invisible to it.
    That silence is what made the source report's agent hold a build plan
    contradicting its own prompt, and this is the only channel that reaches such
    an agent without its cooperation — the briefing file the delegation
    instruction names does not exist in an isolated worktree (it is gitignored,
    so `git worktree add` never materializes it).
    """
    override = bool(os.environ.get(_EPHEMERAL_OVERRIDE_ENV))
    try:
        kind = _gitstate().is_ephemeral_worktree(project_dir)
    except ImportError:
        # Same bootstrap-resilience contract `get_project_dir` documents: this
        # runs before command dispatch, so a broken or absent plugin `lib/` must
        # not crash here. Fail OPEN — an install too broken to import cannot be
        # detected as ephemeral either, and `_check_binary_skew` above already
        # owns the broken-install case. (Regression caught by the full suite:
        # an unguarded call took down `test_views`'s import-error path and five
        # binary-skew tests, all of which run the hook with no importable lib/.)
        return 0
    if kind is None:
        # DURABLE — but the snapshot question is not the write question (#648).
        # An `agent-` worktree on a real named branch is a peer checkout, so
        # nothing here strands and no refusal applies; it is still a tree the
        # harness forked from a commit, so the dispatching session's uncommitted
        # artifacts are just as invisible in it. Returning here would have
        # removed the notice for exactly the population the branch conjunct
        # creates. Classified by PATH, deliberately: the question is "did the
        # harness fork this tree", which the branch cannot answer.
        if _gitstate().ephemeral_worktree_kind_of_path(project_dir) is not None:
            _print_ephemeral_notice(None, project_dir)
        return 0

    if command in _HARNESS_INVOKED_COMMANDS:
        # A DELIBERATE HOLE in the REFUSAL, stated rather than left to be
        # discovered: `clear` and `stop` are among the largest `.prawduct/`
        # writers, and their writes DO strand in a disposable worktree. They are
        # exempt anyway because they are the harness's calls, not the agent's —
        # refusing one breaks the session outright instead of protecting it. The
        # exposure is bounded by the guard upstream: `critic-begin` is refused,
        # so no review can be active for a `subagent-stop` to consolidate. So the
        # chunk's contract is "every AGENT-invoked `.prawduct/`-mutating
        # command", not literally every one.
        #
        # The NOTICE still fires, and the detection above now runs before this
        # branch so it can. An earlier form returned here first and justified the
        # hole partly by "a human driving it who can see the banner" — nothing in
        # the SessionStart banner or the session digest mentions ephemerality, so
        # that path emitted no signal at all on the one path where a human could
        # act. A justification naming a channel that carries nothing is worse
        # than an unjustified hole: it reads as coverage.
        _print_ephemeral_notice(kind, project_dir)
        return 0

    if override or not _ephemeral_command_writes(command, argv, project_dir):
        # The override waives the REFUSAL, not the notice. They answer different
        # questions — "may I write here" versus "how old is what I am reading" —
        # and a dispatcher who opted into writing has not thereby learned that
        # its artifacts are a fork-point snapshot.
        _print_ephemeral_notice(kind, project_dir)
        return 0

    print(
        f"BLOCKED: refusing `{command}` — this is an ephemeral {kind} worktree "
        f"({project_dir}). Only your code commit is merged back, so a write to "
        ".prawduct/ here is discarded when it merges and you would be told it "
        "succeeded. (A review or disposition would instead persist to the "
        "clone-shared evidence store against a tree no branch carries — kept, "
        "but covering nothing.) Report this in your final message and let the "
        "dispatching session record it; Critic reviews and test-evidence stay "
        f"with the dispatcher. Override for one invocation: {_EPHEMERAL_OVERRIDE_ENV}=1",
        file=sys.stderr,
    )
    return 1


def _check_binary_skew(command: str, project_dir: Path) -> int:
    """0 to proceed; 1 when a data-plane write must refuse.

    Emits on stderr either way — the failure this closes was defined by its
    silence, so a quiet pass would reproduce it one severity down.
    """
    skew = _binary_skew(project_dir)
    kind = "binary"
    if skew is None:
        # The script can be the right one while its `lib/` is not.
        skew = _lib_skew(project_dir)
        kind = "lib"
    if skew is None:
        return 0
    repo_plugin, running = skew
    local = repo_plugin / "bin" / "prawduct-hook"
    what = (
        f"running {running}" if kind == "binary"
        else f"running this repo's script but importing lib/ from {running} "
             "($CLAUDE_PLUGIN_ROOT)"
    )
    detail = (
        f"{SKEW_MARKER}: {what}, but this repo carries {repo_plugin}. "
        f"Run `python3 {local}` with $CLAUDE_PLUGIN_ROOT unset or pointed here. "
        "(Versions are NOT the test — a checkout is routinely ahead of its own "
        "manifest, so identical versions prove nothing about the code.)"
    )
    if command in _DATA_PLANE_COMMANDS and command not in _HARNESS_INVOKED_COMMANDS:
        print(
            f"BLOCKED: refusing `{command}` — {detail} A governance write on a "
            "foreign binary is how a review silently persists nothing.",
            file=sys.stderr,
        )
        return 1
    print(f"NOTE: {detail}", file=sys.stderr)
    return 0


def main() -> int:
    """Dispatch. ``_dispatch`` is where the command table lives.

    Plain, and worth a line on why: this wrapper used to classify a fail-closed
    plan-resolution refusal (two live plans declaring one ``branch:``) into a
    clean exit. Nothing raises that any more — several plans on one branch is an
    ordinary arrangement that ``core.resolve_branch_claim`` resolves and
    attributes — so the classifier, and the ``cmd_stop`` probe that converted it
    into the harness block code, went with it rather than staying as handling
    for a condition no code can produce.
    """
    return _dispatch()


# --- Pre-dispatch argument shape --------------------------------------------
# What each subcommand can actually SEE. A command whose dispatch branch passes
# no `argv` has nowhere to put an argument check — the token is dropped by the
# dispatcher, so only the dispatcher can refuse it. That is not a hypothetical:
# `update-gitignore` took no `argv` parameter, so `--dry-run` reached no parser
# to be rejected by and the reconcile ran, rewriting a live `.gitignore` for a
# caller who believed they had asked for a preview. Placed pre-dispatch for the
# same reason `_check_binary_skew` and `_check_ephemeral_worktree` are: a
# per-command fix misses whichever command nobody thought of.
#
# `tests/test_hook_argument_shape.py` derives these collections from the
# `_dispatch` chain itself, so a new subcommand cannot quietly rejoin the hole.

# Refuse: an argument here was silently discarded, and the caller believed it
# did something.
_NO_ARGUMENT_COMMANDS = frozenset({
    "bug-inbox",
    "check-change-log-entry",
    "check-cumulative-critic",
    "check-operator-verification",
    "check-pr-doc-only",
    "critic-consolidate",
    "critic-discard",
    "critic-end",
    "print-install-reference",
    "resolve-base",
    "test-status",
    "validate-evidence",
    "verify-coverage",
    "version",
})

# Say so, then proceed. These are the harness's own calls, never typed: every
# `hooks.json` prawduct has ever shipped invokes them as a bare literal. A usage
# error on a Stop hook does not protect a caller — it blocks the session and
# feeds the refusal back as a turn, which is a worse failure than the silence it
# would be closing. So the argument is named on stderr and the gate still runs.
_NO_ARGUMENT_NOTE_ONLY_COMMANDS = frozenset({
    "stop",
    "subagent-stop",
})

# Say nothing. `stamp-merged` is retired-but-callable, and its deprecation
# contract is exit 0 for ANY input so that a copied release script keeps
# working. An inert command cannot act on an argument it ignored, so there is no
# surprise to prevent — the harm this guard exists for is a command that DID
# something other than what was asked.
_NO_ARGUMENT_UNCHECKED_COMMANDS = frozenset({
    "stamp-merged",
})

# One positional, read as `sys.argv[2]`, and everything after it dropped on the
# floor. Both halves of that are reportable: an unquoted multi-word value is
# silently truncated to its first word, and a flag-shaped token is recorded as
# if it were the id or rationale the command wanted. No documented invocation
# passes a value starting with a dash.
_SINGLE_POSITIONAL_COMMANDS = frozenset({
    "accept-operator-verification",
    "verify-chunk-refs",
    "verify-operator-verification",
})


def _check_argument_shape(command: str, argv: list[str]) -> int:
    """0 to proceed; 2 when the invocation passed something the command cannot
    read. 2 is the hook's usage-error convention (see `_reject_unknown_args`).

    Runs before anything else in `_dispatch`, including project-dir resolution:
    a malformed invocation should do nothing at all, and "nothing ran" is the
    sentence the caller most needs to be able to trust.
    """
    if not argv:
        return 0

    if command in _NO_ARGUMENT_NOTE_ONLY_COMMANDS:
        print(
            f"NOTE: {command} takes no arguments; ignoring {argv[0]!r}.",
            file=sys.stderr,
        )
        return 0

    if command in _NO_ARGUMENT_COMMANDS:
        print(
            f"{command}: unknown argument {argv[0]!r} — this subcommand takes no "
            f"arguments, so nothing ran. Re-invoke it as `prawduct-hook {command}`.",
            file=sys.stderr,
        )
        return 2

    if command in _SINGLE_POSITIONAL_COMMANDS:
        if argv[0].startswith("-"):
            print(
                f"{command}: {argv[0]!r} looks like a flag, but this subcommand "
                "expects a positional value here and would have recorded the flag "
                "as that value. Nothing ran. See `prawduct-hook` usage for what "
                f"{command} accepts.",
                file=sys.stderr,
            )
            return 2
        if len(argv) > 1:
            print(
                f"{command}: unexpected extra argument {argv[1]!r} — this "
                "subcommand reads one value and would have dropped the rest "
                "silently. Nothing ran. Quote it if it is one value containing "
                "spaces.",
                file=sys.stderr,
            )
            return 2

    return 0


def _dispatch() -> int:
    if len(sys.argv) < 2:
        print(_USAGE, file=sys.stderr)
        return 1

    command = sys.argv[1]

    # Before dispatch, and before anything else: a command that never receives
    # `argv` cannot refuse an argument, so the dispatcher refuses on its behalf.
    shape = _check_argument_shape(command, sys.argv[2:])
    if shape != 0:
        return shape

    project_dir = get_project_dir()

    # Before dispatch, so it covers every command — including `subagent-stop`,
    # the path a fix touching only `critic-begin` would miss (#227).
    if _check_binary_skew(command, project_dir) != 0:
        return 1

    # Same reason, same site: a per-command fix would miss whichever write
    # nobody thought of, which is precisely how a disposable worktree strands
    # governance state today (#594).
    if _check_ephemeral_worktree(command, sys.argv[2:], project_dir) != 0:
        return 1

    if command == "clear":
        return cmd_clear(project_dir, sys.argv[2:])
    elif command == "critic-begin":
        return cmd_critic_begin(project_dir, sys.argv[2:])
    elif command == "critic-end":
        return cmd_critic_end(project_dir)
    elif command == "critic-discard":
        return cmd_critic_discard(project_dir)
    elif command == "critic-restore":
        return cmd_critic_restore(project_dir, sys.argv[2:])
    elif command == "critic-consolidate":
        return cmd_critic_consolidate(project_dir)
    elif command == "subagent-stop":
        return cmd_subagent_stop(project_dir, _read_stop_stdin())
    elif command == "jurisdiction":
        return cmd_jurisdiction(project_dir, sys.argv[2:])
    elif command == "stop":
        return cmd_stop(project_dir, _read_stop_stdin())
    elif command == "test-status":
        return cmd_test_status(project_dir)
    elif command == "validate-evidence":
        return cmd_validate_evidence(project_dir)
    elif command == "test-evidence":
        return cmd_test_evidence(project_dir, sys.argv[2:])
    elif command == "check-cumulative-critic":
        return cmd_check_cumulative_critic(project_dir)
    elif command == "verify-chunk-refs":
        chunk_id = sys.argv[2] if len(sys.argv) > 2 else None
        return cmd_verify_chunk_refs(project_dir, chunk_id)
    elif command == "verify-records":
        return cmd_verify_records(project_dir, sys.argv[2:])
    elif command == "verify-coverage":
        return cmd_verify_coverage(project_dir)
    elif command == "ledger-append":
        return cmd_ledger_append(project_dir, sys.argv[2:])
    elif command == "handoff":
        return cmd_handoff(project_dir, sys.argv[2:])
    elif command == "review-stats":
        return cmd_review_stats(project_dir, sys.argv[2:])
    elif command == "classify-diff-risk":
        return cmd_classify_diff_risk(project_dir, sys.argv[2:])
    elif command == "cost-of-commit":
        return cmd_cost_of_commit(project_dir, sys.argv[2:])
    elif command == "check-plugin-active":
        return cmd_check_plugin_active(project_dir, sys.argv[2:])
    elif command == "check-learnings-pairing":
        return cmd_check_learnings_pairing(project_dir, sys.argv[2:])
    elif command == "check-operator-verification":
        return cmd_check_operator_verification(project_dir)
    elif command == "accept-operator-verification":
        rationale = sys.argv[2] if len(sys.argv) > 2 else None
        return cmd_accept_operator_verification(project_dir, rationale)
    elif command == "verify-operator-verification":
        vrf_id = sys.argv[2] if len(sys.argv) > 2 else None
        return cmd_verify_operator_verification(project_dir, vrf_id)
    elif command == "check-change-log-entry":
        return cmd_check_change_log_entry(project_dir)
    elif command == "check-releasability":
        return cmd_check_releasability(project_dir, sys.argv[2:])
    elif command == "archive-plan":
        return cmd_archive_plan(project_dir, sys.argv[2:])
    elif command == "check-released":
        return cmd_check_released(project_dir, sys.argv[2:])
    elif command == "check-pr-doc-only":
        return cmd_check_pr_doc_only(project_dir)
    elif command == "stamp-merged":
        return cmd_stamp_merged(project_dir)
    # Retired at v3.3.2, kept dispatchable: a pre-3.3.2 hooks.json still
    # registers both, and plugin version pins update per project rather than
    # all at once.
    elif command == "build-index":
        return cmd_build_index(project_dir, sys.argv[2:])
    elif command == "user-prompt-submit":
        return cmd_user_prompt_submit(project_dir, sys.argv[2:])
    elif command == "regen-views":
        return cmd_regen_views(project_dir, sys.argv[2:])
    elif command == "infer-critic-mode":
        args = " ".join(sys.argv[2:]) if len(sys.argv) > 2 else None
        return cmd_infer_critic_mode(project_dir, args)
    elif command == "resolve-base":
        return cmd_resolve_base(project_dir)
    elif command == "disposition":
        return cmd_disposition(project_dir, sys.argv[2:])
    elif command == "render-dispositions":
        return cmd_render_dispositions(project_dir, sys.argv[2:])
    elif command == "evidence":
        return cmd_evidence(project_dir, sys.argv[2:])
    elif command == "bug-inbox":
        return cmd_bug_inbox(project_dir)
    elif command == "version":
        return cmd_version()
    elif command == "print-install-reference":
        return cmd_print_install_reference()
    elif command == "advisory":
        return cmd_advisory(project_dir, sys.argv[2:])
    elif command == "backlog":
        return cmd_backlog(project_dir, sys.argv[2:])
    elif command == "coverage-status":
        return cmd_coverage_status(project_dir, sys.argv[2:])
    elif command == "coverage-scaffold":
        return cmd_coverage_scaffold(project_dir, sys.argv[2:])
    elif command == "migrate-plugin":
        return cmd_migrate_plugin(project_dir, sys.argv[2:])
    elif command == "init-product":
        return cmd_init_product(sys.argv[2:])
    elif command == "update-gitignore":
        return cmd_update_gitignore(project_dir, sys.argv[2:])
    elif command == "audit-learnings":
        return cmd_audit_learnings(project_dir, sys.argv[2:])
    elif command == "norm-index-scaffold":
        return cmd_norm_index_scaffold(project_dir, sys.argv[2:])
    elif command == "learnings-obligation":
        return cmd_learnings_obligation(project_dir, sys.argv[2:])
    elif command == "lifecycle-repair":
        return cmd_lifecycle_repair(project_dir, sys.argv[2:])
    elif command == "plan-backfill":
        return cmd_plan_backfill(project_dir, sys.argv[2:])
    elif command == "repo-disable":
        return cmd_repo_disable(project_dir, sys.argv[2:])
    else:
        print(_USAGE, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
