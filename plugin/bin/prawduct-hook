# main
# =============================================================================


def cmd_regen_views(project_dir: Path, args: list[str] | None = None) -> int:
    """DEPRECATED and inert — derived views are retired. Prints a notice, writes
    nothing, exits 0.

    This once regenerated three views from change-log tags: a build plan's
    ``## Status`` checkboxes, a release-notes file, and a scope-rollup block in
    ``project-state.yaml``. All three are gone. A build plan's checkboxes are now
    the plan's own content, ticked by hand when a chunk finishes, so there is
    nothing to regenerate them FROM and nothing that would be more authoritative
    if there were.

    **Why it is still callable.** ``api-contract.md``'s deprecation norm requires
    a retired subcommand to be signalled rather than removed: kept working,
    announced on stderr, removal deferred to a major. The caller this protects is
    a hand-written operator script or a copied runbook — prawduct's own release
    runbook called this command — which gets a notice telling it what to do
    instead, not a non-zero exit that breaks a pipeline mid-release.

    **One category of caller this docstring used to rule out, wrongly.** It said
    the skew "cannot arise between a prawduct skill and this CLI — they ship from
    one version-keyed cache." True of a skill; **false of a hook registration**,
    which is also shipped-in-cache but is invoked by the *harness*, and the
    harness pins a plugin version per project and updates those pins lazily. So
    an old ``hooks.json`` routinely calls a new binary. v3.3.2 read that sentence
    as covering hooks too and deleted ``build-index`` and ``user-prompt-submit``
    outright; every product repo mid-update then hit usage text and exit 1 on
    session start and on every prompt. Both are inert commands again below — the
    norm applies to anything a shipped artifact can invoke, hooks included.

    Exit 0 unconditionally, including for unknown flags: a command that does
    nothing cannot be misused, and a usage error here would be the pipeline break
    the deprecation exists to avoid. ``--check`` was already deprecated and is
    accepted silently for the same reason.
    """
    # Both parameters are kept so the dispatcher's call site is unchanged — a
    # deprecated command that still accepts its old invocation is the point.
    del project_dir, args
    print(
        "WARNING: regen-views no longer does anything and will be removed in a "
        "future major version. A build plan's Status checkboxes are now written "
        "by hand — tick a box when its chunk is finished, and nothing will "
        "overwrite it. Release notes are kept in the change log itself. If a "
        "script or checklist still calls this command, drop the call.",
        file=sys.stderr,
    )
    return 0


def cmd_check_operator_verification(project_dir: Path) -> int:
    """Structural gate for `/prawduct:pr create`: refuse open when queue has pending entries.

    Mirrors :func:`cmd_check_cumulative_critic` semantics — exit 0 only
    when the gate is satisfied, exit 1 with stderr describing the
    blocker. The gate is only active when ``operator_verification_required:
    true`` is set in ``project-state.yaml``; otherwise the command is a
    no-op exit 0.
    """
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import operator_verification as ov  # noqa: PLC0415 — lazy import
    except ImportError:
        # Fail OPEN: this gate cannot evaluate a queue it can't load. If the
        # bundled lib/ failed to import (an incomplete plugin install),
        # blocking /prawduct:pr here would be a false positive. Surface a note, allow.
        print(
            "NOTE: check-operator-verification could not import the plugin lib/ "
            "from ${CLAUDE_PLUGIN_ROOT}; gate skipped.",
            file=sys.stderr,
        )
        return 0

    result = ov.run_check_operator_verification(project_dir)
    if not result["required"]:
        return 0
    # Order matters: an unreadable queue reports `pending: 0` because nothing
    # was parsed, so testing pending first would let the exact failure this
    # branch exists for fall through as a pass.
    #
    # Exit **3**, not 1. Both block — 3 is non-zero, so `/prawduct:pr` Step 2b stops
    # either way and the gate still fails closed. What 3 buys is that the
    # blocking REASON is readable from the code: 1 has always meant "there are
    # pending entries, here is the first ID, drain or override it", and both of
    # those remedies are inapplicable to a queue nobody could parse. Reusing 1
    # would be a new meaning wearing an old number, and it would send an agent
    # to the two remedies that cannot work — ending at the queue file, which is
    # the one move this refusal exists to prevent.
    if result.get("queue_status") == ov.QUEUE_UNREADABLE:
        print(result["message"], file=sys.stderr)
        return 3
    if result["pending"] == 0:
        print(result["message"])
        return 0
    print(result["message"], file=sys.stderr)
    return 1


def cmd_accept_operator_verification(
    project_dir: Path, rationale: str | None
) -> int:
    """Flip all pending entries to ``accepted`` with the supplied rationale.

    Invoked by ``/prawduct:pr create --accept-pending-verification "rationale"``.
    Refuses an empty or missing rationale — the work-log capture is the
    whole point of the override.
    """
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import operator_verification as ov  # noqa: PLC0415 — lazy import
    except ImportError:
        # Honest failure: this command mutates the queue, so it must not claim
        # success when its machinery is absent (an incomplete plugin install).
        print(
            "error: accept-operator-verification could not import the plugin "
            "lib/ from ${CLAUDE_PLUGIN_ROOT}.",
            file=sys.stderr,
        )
        return 1

    if rationale is None or not rationale.strip():
        print(
            "error: accept-operator-verification requires a non-empty "
            "rationale argument — `/prawduct:pr create --accept-pending-verification "
            '"rationale"`. The override is recorded in operator-verification.md '
            "as the work-log entry.",
            file=sys.stderr,
        )
        return 1

    result = ov.run_accept_pending(project_dir, rationale)
    if "error" in result:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1

    for action in result["actions"]:
        print(action)
    for note in result["notes"]:
        print(f"  * {note}")
    return 0


def cmd_verify_operator_verification(
    project_dir: Path, vrf_id: str | None
) -> int:
    """Drain a single pending operator-verification entry to ``verified``.

    The plugin-native replacement for the legacy file-sync ``verify`` path,
    invoked by ``/prawduct:pr`` (Step 2b) and ``/prawduct:doctor`` (Verify
    Flow) after the human-verification step is genuinely complete. A migrated
    consumer has no framework checkout, so the old ``tools/`` setup script is
    gone — this subcommand operates only on the consumer's own
    ``.prawduct/operator-verification.md`` via the bundled lib. Like its
    ``accept`` sibling it mutates the queue, so it fails honestly (exit 1)
    rather than claiming success when its machinery is absent.
    """
    lib_root = _plugin_root()
    if lib_root not in sys.path:
        sys.path.insert(0, lib_root)
    try:
        from lib import operator_verification as ov  # noqa: PLC0415 — lazy import
    except ImportError:
        print(
            "error: verify-operator-verification could not import the plugin "
            "lib/ from ${CLAUDE_PLUGIN_ROOT}.",
            file=sys.stderr,
        )
        return 1

    if vrf_id is None or not vrf_id.strip():
        print(
            "error: verify-operator-verification requires a VRF id argument — "
            "`prawduct-hook verify-operator-verification <VRF-NNN>`. Complete "
            "the entry's human-verification step first; this flips its status "
            "to verified in operator-verification.md.",
            file=sys.stderr,
        )
        return 1

    # A flag reaching a positional slot is data by accident. Left alone it is
    # looked up as a VRF id, and the failure that follows names a missing entry
    # rather than the mistyped flag that caused it. The dispatcher refuses this
    # too; the check is repeated here because the function is callable on its
    # own and the argument it validates is its own.
    if vrf_id.strip().startswith("-"):
        print(
            f"error: verify-operator-verification got {vrf_id.strip()!r}, which "
            "looks like a flag — this argument is a VRF id "
            "(`prawduct-hook verify-operator-verification <VRF-NNN>`). Nothing "
            "was changed.",
            file=sys.stderr,
        )
        return 1

    result = ov.run_verify_entry(project_dir, vrf_id.strip())
    if "error" in result:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1

    print(f"{result['vrf_id']}: {result['previous_status']} → {result['status']}")
    for action in result["actions"]:
        print(action)
    for note in result["notes"]:
        print(f"  * {note}")
    return 0


